# 本地缓存与工具生成物
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.codex-worktree/

# 本地凭证与私有配置
.env
.env.*
!.env.example
*api-key*
*credentials*

# 下载依赖、游戏备份和运行日志
downloads/
runtime/downloads/
runtime/vendor/
runtime/build/
runtime/backups/
runtime/logs/
runtime/evidence/*.html
runtime/evidence/XUnity-README.md
runtime/evidence/MoeFont-README.md
runtime/evidence/probe-process-id.txt
runtime/evidence/archive/
*.log

# 试译保留原始请求账本和最终结果，上游增量缓存只留本机
translation/trial-*/outputs/*/*/cache/

# 完整补丁包和重复后台运行证据保留本机，源码与核验摘要纳入Git
runtime/package/
runtime/game-test/
runtime/evidence/headless/*/
# 完整UI审计保留去重来源和结论；重复的原始引用/人工检索中间件不入库。
analysis/ui-audit/assembly-raw-occurrences.json
analysis/ui-audit/assembly-missing-inspect.json
analysis/ui-audit/assembly-language-inspect.txt
analysis/ui-audit/resource-descriptions-zh.txt
# 全对白日志的重复单句/相邻/场景压力夹具由已提交生成器复现，保留本机核验。
translation/supplemental/dialogue-log-followup-tests.json
translation/supplemental/dialogue-log-depth-tests.json
analysis/ui-audit/dialogue-log-source-audit.json
# 混合日志全量交叉组合由生成器复现，Git保留代表性回归及结果哈希。
translation/supplemental/mixed-log-tests.json
translation/supplemental/mixed-log-pair-tests.json
# 厨娘全量逐句/组合用例由审计脚本复现，本机保留结果及来源摘要。
translation/supplemental/irma-review-tests.json
