{
  "translations": [
    {
      "id": "p14355-2e9c55578233",
      "target": "不管他声称自己有什么意图，我知道福丁布拉斯打算洗劫城堡，自立为王。"
    },
    {
      "id": "p14356-8c21a4b40087",
      "target": "福丁布拉斯将入侵"
    },
    {
      "id": "p14357-8250b2fda2b8",
      "target": "据哈姆雷特国王的幽灵所说，父亲手里有国王生前最后一段日子的记录。"
    },
    {
      "id": "p14358-6a1dc1fced1e",
      "target": "国王的笔记"
    },
    {
      "id": "p14359-3cc0d45a51ec",
      "target": "哈姆雷特国王和我一样，曾被困在时间循环里。他寻找过一本神秘的书，认为它与这一切有关。"
    },
    {
      "id": "p14360-626809c3c1dd",
      "target": "国王的诅咒之书"
    },
    {
      "id": "p14361-8986880d7a6d",
      "target": "亚历山大国王的配偶西蒙娜并没有死，而是逃离了城堡。她会在哪里？"
    },
    {
      "id": "p14362-a0268417f0c5",
      "target": "西蒙娜还活着"
    },
    {
      "id": "p14363-6ec7342eb8e2",
      "target": "乔特鲁德的姐妹，奥地利的玛格丽特，已经去世了。"
    },
    {
      "id": "p14364-925b9d43601b",
      "target": "乔特鲁德的姐妹已死"
    },
    {
      "id": "p14365-06cac1915861",
      "target": "伊尔玛认为哈姆雷特不守规矩，需要管教。她建议乔特鲁德王后对他严厉些。"
    },
    {
      "id": "p14366-499479c5790e",
      "target": "必须管教哈姆雷特"
    },
    {
      "id": "p14367-ec147224eb00",
      "target": "她是谁？为什么没人提起她？"
    },
    {
      "id": "p14368-4aabeb26acdb",
      "target": "神秘的阿斯特丽德王后"
    },
    {
      "id": "p14369-d65fdb89a860",
      "target": "奎因斯有些古怪。他似乎知道一些他不该知道的事。"
    },
    {
      "id": "p14370-92ad98cb38dc",
      "target": "神秘的剧团团长"
    },
    {
      "id": "p14371-e966dd334d0c",
      "target": "哥哥认为哈姆雷特偷了他的鲁特琴。"
    },
    {
      "id": "p14372-92a0b84cdd65",
      "target": "母亲因瘟疫孤独地死去。她的遗物还在码头屋里。"
    },
    {
      "id": "p14373-3329692d22d6",
      "target": "母亲之死"
    },
    {
      "id": "p14374-1b8d0af76857",
      "target": "克劳狄斯打算在哈姆雷特启航前往英格兰时，交给罗森克兰兹和吉尔登斯吞一封要求处死哈姆雷特的信。"
    },
    {
      "id": "p14375-fce907adfec0",
      "target": "船上阴谋失败"
    },
    {
      "id": "p14376-f85ba5193249",
      "target": "奎因斯意图伤害我们所有人，让我们陷入混乱。他不可信。"
    },
    {
      "id": "p14377-a874e24ce741",
      "target": "驱逐剧团团长"
    },
    {
      "id": "p14378-0243998f7b3d",
      "target": "我看见王后在翻查国王的私人物品。"
    },
    {
      "id": "p14379-86088884c6aa",
      "target": "乔特鲁德在找什么"
    },
    {
      "id": "p14380-ffecc2784eda",
      "target": "父亲偷偷摸摸地烧掉了一些笔记。他可能在隐瞒什么。"
    },
    {
      "id": "p14381-ccc900ed5252",
      "target": "父亲烧掉的东西"
    },
    {
      "id": "p14382-791422acb2ea",
      "target": "我看见罗森克兰兹女士和吉尔登斯吞女士举止古怪，觉得她们可能没安好心。"
    },
    {
      "id": "p14383-4f29087257bd",
      "target": "古怪的二人组"
    },
    {
      "id": "p14384-0e2a68658e4f",
      "target": "贝尔纳多请你与他私下商谈。你应该尽快去见他。"
    },
    {
      "id": "p14385-73432dbe4754",
      "target": "贝尔纳多召你见面"
    },
    {
      "id": "p14386-3981b0d4c48c",
      "target": "贝尔纳多请你与他私下见面。"
    },
    {
      "id": "p14387-070763d2825b",
      "target": "夜里，贝尔纳多在城堡镇的舞台上扮演一名女性——凯瑟琳。"
    },
    {
      "id": "p14388-71b83ac969d3",
      "target": "贝尔纳多与凯瑟琳"
    },
    {
      "id": "p14389-b8c619f2a8dd",
      "target": "哈姆雷特计划从海盗女王手里夺取这艘船的控制权，但萝茜和吉尔达会丧命。"
    },
    {
      "id": "p14390-99edf93986bd",
      "target": "哗变"
    },
    {
      "id": "p14391-20c4799efc6a",
      "target": "镇上的酒馆老板奥赛罗正遭到恶徒勒索。"
    },
    {
      "id": "p14392-1744a79c7852",
      "target": "酒馆老板的麻烦"
    },
    {
      "id": "p14393-1ba32acbfc2e",
      "target": "奥赛罗有过一些不可思议的冒险经历。不知道别人对他了解多少？"
    },
    {
      "id": "p14394-9c75d5ee373f",
      "target": "尘封的冒险往事"
    },
    {
      "id": "p14395-bd42b6528a78",
      "target": "我曾和哈姆雷特交往过，但最后闹得很不愉快。如果我愿意，也可以让我们旧情复燃"
    },
    {
      "id": "p14396-53eabd4c3a99",
      "target": "王子与我"
    },
    {
      "id": "p14397-3aa648820390",
      "target": "我曾和哈姆雷特交往过，但最后闹得很不愉快。如果我愿意，也可以让我们旧情复燃。"
    },
    {
      "id": "p14398-7e688e7a9d3b",
      "target": "怎样才能成为一位伟大的国王？城堡里一些值得信赖的人或许知道。"
    },
    {
      "id": "p14399-5ca7aa805760",
      "target": "成就一位国王"
    },
    {
      "id": "p14400-264e6b02e533",
      "target": "自从认识布莉特以来，她似乎一直郁郁寡欢。别人对她了解多少？"
    },
    {
      "id": "p14401-7127052a15bb",
      "target": "布罗肯胡斯女士"
    },
    {
      "id": "p14402-2b4ac8b737c2",
      "target": "福丁布拉斯王子和他的顾问们藏在镇上。他正在那里策划入侵。"
    },
    {
      "id": "p14403-ff008033094f",
      "target": "福丁布拉斯的藏身处"
    },
    {
      "id": "p14404-e2b1f16dc3d9",
      "target": "请立刻离开舞台。"
    },
    {
      "id": "p14405-16321b2b4cbc",
      "target": "全体退场"
    },
    {
      "id": "p14406-cff9c19f9b57",
      "target": "没错。我就是凶手。我只要一句话就能杀了你。而且我不会犹豫。"
    },
    {
      "id": "p14407-f4d9e3886848",
      "target": "你该怕我"
    },
    {
      "id": "p14408-883ec18bd243",
      "target": "吉尔登斯吞女士希望我通知你，她已经死了。"
    },
    {
      "id": "p14409-36073972c709",
      "target": "吉尔登斯吞之死"
    },
    {
      "id": "p14410-d2faefd4a9d1",
      "target": "卫兵西格纳斯提到自己“处境危险”。这是怎么回事？"
    },
    {
      "id": "p14411-0353fc5a2ed6",
      "target": "卫兵举止古怪"
    },
    {
      "id": "p14412-36610349dac9",
      "target": "通往镇上的大门处，那名卫兵似乎心事重重。可能出了什么事？"
    },
    {
      "id": "p14413-6d962cfaaae7",
      "target": "关于霍拉旭和哈姆雷特多年的友谊，大家能告诉我些什么？"
    },
    {
      "id": "p14414-f277f546fe17",
      "target": "哈姆雷特的朋友霍拉旭"
    },
    {
      "id": "p14415-fdd4d35b40a3",
      "target": "主啊，求你怜悯。主啊，求你怜悯。"
    },
    {
      "id": "p14416-7813644b1b45",
      "target": "求求你，上帝，求求你，上帝，求求你。"
    },
    {
      "id": "p14417-55479156013f",
      "target": "主啊，求你怜悯，上帝，求求你，发发慈悲。"
    },
    {
      "id": "p14418-2a68002a201c",
      "target": "别让她杀了我。求求你。保佑我们。"
    },
    {
      "id": "p14419-8c55cd1308f1",
      "target": "乔特鲁德王后"
    },
    {
      "id": "p14420-a01e7de8b6ca",
      "target": "克劳狄斯国王"
    },
    {
      "id": "p14421-9c264bc04944",
      "target": "布莉特女士"
    },
    {
      "id": "p14422-4a1239e4137e",
      "target": "奎因斯"
    },
    {
      "id": "p14423-a4c2b6c0ed91",
      "target": "罗森克兰兹女士"
    },
    {
      "id": "p14424-dd107eab2abb",
      "target": "吉尔登斯吞女士"
    },
    {
      "id": "p14425-290753284f57",
      "target": "戴兜帽的人"
    },
    {
      "id": "p14426-0fb5373afcfe",
      "target": "仆人"
    },
    {
      "id": "p14427-b3984df21669",
      "target": "贡扎古"
    },
    {
      "id": "p14428-974d11c3cd08",
      "target": "卢西安纳斯"
    },
    {
      "id": "p14429-1ff3db23075f",
      "target": "巴普蒂斯塔"
    },
    {
      "id": "p14430-538d73eedc06",
      "target": "外国士兵"
    },
    {
      "id": "p14431-f43b39ea311b",
      "target": "西格纳斯"
    },
    {
      "id": "p14432-6b1861e757f5",
      "target": "镇民"
    },
    {
      "id": "p14433-a8d6f7185918",
      "target": "老妇人"
    },
    {
      "id": "p14434-ba9b353684f9",
      "target": "伊莉丝"
    },
    {
      "id": "p14435-4ae0c1ad8582",
      "target": "格蕾丝船长"
    },
    {
      "id": "p14436-2e786c488b83",
      "target": "船长"
    },
    {
      "id": "p14437-06d09f7680f8",
      "target": "强盗"
    },
    {
      "id": "p14438-c0d39454a425",
      "target": "村民"
    },
    {
      "id": "p14439-fb99f31dcb11",
      "target": "水手"
    },
    {
      "id": "p14440-1deb0a3b8675",
      "target": "理查德"
    },
    {
      "id": "p14441-d7f2688a9862",
      "target": "奥尔德斯"
    },
    {
      "id": "p14442-f826baa05bef",
      "target": "士兵"
    },
    {
      "id": "p14443-3e912d9fef7e",
      "target": "芬尼根"
    },
    {
      "id": "p14444-48eb287d8c3f",
      "target": "库比利乌斯"
    },
    {
      "id": "p14445-4aaa816fc533",
      "target": "基斯特勒"
    },
    {
      "id": "p14446-7eda99495667",
      "target": "墨菲"
    },
    {
      "id": "p14447-5632e195ae87",
      "target": "凯瑟琳"
    },
    {
      "id": "p14448-aafd8090c534",
      "target": "彼特鲁乔"
    },
    {
      "id": "p14449-52bc246ac7a1",
      "target": "科兰比斯"
    },
    {
      "id": "p14450-ff8b9f18808c",
      "target": "雷纳尔多"
    },
    {
      "id": "p14451-597d0dd6aa15",
      "target": "麦克唐纳"
    },
    {
      "id": "p14452-62ce3f10c8cb",
      "target": "伏尔提曼德"
    },
    {
      "id": "p14453-e74179eee100",
      "target": "父亲大概已经上床睡觉了。"
    },
    {
      "id": "p14454-fb31808a1fe9",
      "target": "我想，父亲从前总以学者自居。他的言谈举止确实也像个学者。"
    },
    {
      "id": "p14455-eab046a7f6ee",
      "target": "我想，父亲以学者自居。他的言谈举止确实也像个学者。"
    },
    {
      "id": "p14456-a2677b9e205f",
      "target": "这些一定是贝尔纳多的东西。那把匕首原本是他父亲的。他父亲在两年前的夏天去世了。"
    },
    {
      "id": "p14457-1246628a412e",
      "target": "这是……我母亲的坟墓。伊莉丝。"
    },
    {
      "id": "p14458-d76da4b0eb3c",
      "target": "我还没记事，她就去世了。我知道父亲很爱她。"
    },
    {
      "id": "p14459-8cf3ae0f5ca5",
      "target": "仆人们让这座巨大的壁炉日夜燃烧。我想，它才是城堡真正的炉火中心。"
    },
    {
      "id": "p14460-3bc5064a67f3",
      "target": "牢门现在锁着。"
    },
    {
      "id": "p14461-d3430668a4f3",
      "target": "难道我真的已经挣脱了？"
    },
    {
      "id": "p14462-a0819fbeb8c4",
      "target": "上帝啊，求你让这一切是真的。"
    },
    {
      "id": "p14463-3269991b0ae4",
      "target": "这些植物都是伊尔玛亲自照料的。我猜这是她的爱好。"
    },
    {
      "id": "p14464-8d632a441887",
      "target": "待完成：这是个令人着迷却又难以描述的东西"
    },
    {
      "id": "p14465-7a5d718882ad",
      "target": "父亲的壁炉。看起来很暖和。"
    },
    {
      "id": "p14466-73361994500e",
      "target": "这里只有书。"
    },
    {
      "id": "p14467-721d4169ae79",
      "target": "仆人们从这口井里打水，清洗我们的物品。"
    },
    {
      "id": "p14468-f34b0d313b05",
      "target": "这个季节，屋里这么热实在让人不舒服。不过我想哈姆雷特就喜欢这样。"
    },
    {
      "id": "p14469-dbe7bb4f8b06",
      "target": "各种香草、食材和腌肉。都是伊尔玛做饭用的原料。"
    },
    {
      "id": "p14470-426d76d6fa03",
      "target": "伊尔玛的炉灶，每顿饭都在这里烹煮烘烤。"
    },
    {
      "id": "p14471-f44bba56f2ec",
      "target": "炉火似乎很少彻底熄灭——伊尔玛总在忙。"
    },
    {
      "id": "p14472-3072901941bd",
      "target": "我的衣柜，里面放着一些比较朴素的衣服。"
    },
    {
      "id": "p14473-51d3d86e908a",
      "target": "不过，我还是偏爱这条裙子。"
    },
    {
      "id": "p14474-0e10ce52d5ea",
      "target": "外面有武装卫兵。我想，要是我试着离开，他们不会高兴的。"
    },
    {
      "id": "p14475-a30f3c0977bc",
      "target": "现在没必要一路走下去到那儿。"
    },
    {
      "id": "p14476-a4360279d384",
      "target": "城堡的军械库储备充足。"
    },
    {
      "id": "p14477-731724132a8c",
      "target": "我现在不能睡。"
    },
    {
      "id": "p14478-481633a7d14f",
      "target": "父亲的书桌，还是一如既往地乱。"
    },
    {
      "id": "p14479-965834fef66b",
      "target": "大门锁着。"
    },
    {
      "id": "p14480-3e2bfbad7352",
      "target": "没锁。"
    },
    {
      "id": "p14481-fc3410139380",
      "target": "而且……是空的。"
    },
    {
      "id": "p14482-32aa744a5101",
      "target": "这里没藏什么东西。"
    },
    {
      "id": "p14483-153e04e08b81",
      "target": "通往镇上的大门锁着。"
    },
    {
      "id": "p14484-3b609e2f11dc",
      "target": "我还是不愿碰那个桶。"
    },
    {
      "id": "p14485-94ffd9b0e6bf",
      "target": "这间酒馆的壁炉让人觉得很舒服。"
    },
    {
      "id": "p14486-d8d637c6d7f2",
      "target": "他难得这么心烦。我想，现在我说什么他都听不进去。"
    },
    {
      "id": "p14487-47a497716193",
      "target": "她难得这么心烦。我想，现在我说什么她都听不进去。"
    },
    {
      "id": "p14488-0174255c407b",
      "target": "他看起来……悲痛欲绝。我想，眼下我也说不了什么。"
    },
    {
      "id": "p14489-db98d84e291c",
      "target": "她看起来……悲痛欲绝。我想，眼下我也说不了什么。"
    },
    {
      "id": "p14490-70158093f91f",
      "target": "镇上有那么多人，我既不认识，也从没见过……"
    },
    {
      "id": "p14491-d62a10fc9c18",
      "target": "这艘船的船长。我没听清他的名字。以前也没见过他。"
    },
    {
      "id": "p14492-f7e7a4b37b98",
      "target": "看起来是个不好惹、不修边幅的人。我最好别插手。"
    },
    {
      "id": "p14493-f4409e37519e",
      "target": "丹麦皇家舰队的一名水手。城堡里有几十名这样的水手。"
    },
    {
      "id": "p14494-606bd47163df",
      "target": "看起来是个不好惹、不修边幅的人。我想，大海这位女主人可不好伺候……"
    },
    {
      "id": "p14495-3873c3008061",
      "target": "在城堡巡逻的众多卫兵之一。面甲放下来时，很难分清谁是谁。"
    },
    {
      "id": "p14496-352096430d89",
      "target": "守卫城墙的卫兵之一。我和他实在不熟，不过有时能听见他的鼾声穿过卧室地板传上来……"
    },
    {
      "id": "p14497-c6877aa853da",
      "target": "啊，西格纳斯。这周你被派来守外门？"
    },
    {
      "id": "p14498-7a1c05f39c83",
      "target": "是、是的，小姐。"
    },
    {
      "id": "p14499-6d2fab5be3f8",
      "target": "小姐，如果您要去镇上，<i>求您</i>小心些……不然我就要掉脑袋了！"
    },
    {
      "id": "p14500-32a638a6c9fe",
      "target": "王室园丁。我想，要让这些花一直生机勃勃，得忙上一整天。"
    },
    {
      "id": "p14501-9ae2956f7000",
      "target": "她是仆人里比较友善的一位。我不常和她说话，但她看起来是个和善的人。"
    },
    {
      "id": "p14502-c37c21c9ea3c",
      "target": "父亲的侍从，替他打理财务。顺带一提，打理得很差。"
    },
    {
      "id": "p14503-2be0301dcf44",
      "target": "看来，他还在镇上兼职当演员。我想，他有另一面也没什么好惊讶的。"
    },
    {
      "id": "p14504-4ed296987623",
      "target": "王室信使。最近战事一触即发，他大多数时候都不在城堡里。"
    },
    {
      "id": "p14505-797023ca1b0a",
      "target": "格蕾丝的一名副手。我想，他一定忠心耿耿。想说服他改变什么，恐怕没用。"
    },
    {
      "id": "p14506-3bf7e11752b1",
      "target": "我知道，已经有一阵子了。"
    },
    {
      "id": "p14507-7d7488590ce8",
      "target": "嗯。准确地说，距我们上次交谈，已经过了三千九百八十二天。"
    },
    {
      "id": "p14508-d5fb902bbb5c",
      "target": "如果把恶狠狠的瞪视也算作一种说话方式，那就短一些。"
    },
    {
      "id": "p14509-58e63e69825c",
      "target": "我不这么算。不过很高兴你还在数。"
    },
    {
      "id": "p14510-65ca2e69a9ed",
      "target": "你还……你是不是……"
    },
    {
      "id": "p14511-e18e51b2b998",
      "target": "我是不是还恨你？"
    },
    {
      "id": "p14512-d341108a8c7c",
      "target": "是的，我有一千种理由恨你。但每一种都比不上这一点："
    },
    {
      "id": "p14513-4b70945a1d71",
      "target": "我很无聊。"
    },
    {
      "id": "p14514-4b957c199f39",
      "target": "我用无数种可怕的方式杀死你，已经尽兴了。恐吓你。让你崩溃……"
    },
    {
      "id": "p14515-53aeac878c96",
      "target": "接下来，我猜你又要来一段独白了……"
    },
    {
      "id": "p14516-99d241093a14",
      "target": "你说对了。因为直到这一切的最后，最奇怪的事才发生。你<i>确实</i>放弃了。你输掉了这场较量。"
    },
    {
      "id": "p14517-a7ea8d6dbe7c",
      "target": "这些年来，你彻底退缩，不再参与这场游戏。我发现，整个埃尔西诺已经融成了没有形状的一团。无聊磨平了所有棱角。"
    },
    {
      "id": "p14518-baf96c0c05d9",
      "target": "这里的每个人都同时活着又死去，欢喜又悲伤，聪明又残忍。因为我已经再也记不清什么是真的了。"
    },
    {
      "id": "p14519-d9af3c9f4394",
      "target": "而我——"
    },
    {
      "id": "p14520-9647719e7481",
      "target": "奥菲莉娅，我恐怕已经彻底疯了。"
    },
    {
      "id": "p14521-e5e7492c3022",
      "target": "也许我从一开始就没清醒过。也许一直都是这样。又或者，这永远都会是你我共有的妄想。"
    },
    {
      "id": "p14522-eac6709ca9aa",
      "target": "人们说爱情就是这样。一种共同的妄想。我不知道。我从没爱过谁。"
    },
    {
      "id": "p14523-ca0658ab95db",
      "target": "这感觉更像一场无尽的噩梦，你我永远都无法醒来。"
    },
    {
      "id": "p14524-0718e37c38f3",
      "target": "而且我必须承认，无论是哪个神把我放在这里，我都觉得有必要与他抗争。"
    },
    {
      "id": "p14525-4c241b1e97c4",
      "target": "那本书来到我手里，是有原因的。它选择了我。或者，是谁把它赐给了我。为什么？"
    },
    {
      "id": "p14526-74fcc302a8b2",
      "target": "如果我的命运只是像个傻瓜一样，被困在自己创造的东西里，那究竟是为什么？"
    },
    {
      "id": "p14527-671c22cf25c7",
      "target": "……不过，不。"
    },
    {
      "id": "p14528-71a17a92760f",
      "target": "这些念头已经像海浪一样，冲击了我一万次。如今它们又退去了，再次流回大海。"
    },
    {
      "id": "p14529-fbcc2b50dc24",
      "target": "我不知道为什么要对你说这些。"
    },
    {
      "id": "p14530-a4beddc6193b",
      "target": "那就让我们继续沉默吧。"
    },
    {
      "id": "p14531-abccc0e084ac",
      "target": "我不想永远和你作对。"
    },
    {
      "id": "p14532-e5bc2e980dd4",
      "target": "亲爱的，可惜的是，<i>我</i>想。"
    },
    {
      "id": "p14533-44fa9d513253",
      "target": "我们能谈谈吗？"
    },
    {
      "id": "p14534-79b68e515cf7",
      "target": "我想，我们如今已经没什么话可对彼此说了。"
    },
    {
      "id": "p14535-29601661a1e8",
      "target": "啊，西格纳斯。你被派来守外门？"
    },
    {
      "id": "p14536-ab649e5a1e0f",
      "target": "父亲的侍从，替他打理财务。我不和他说话——他以前对我相当不友善，也很冷淡。他只忠于父亲的家产。"
    },
    {
      "id": "p14537-e4c3f9fab620",
      "target": "格蕾丝的一名副手。我想，他一定忠心耿耿——想说服他改变什么，恐怕没用。"
    },
    {
      "id": "p14538-5cb0b4266058",
      "target": "杂项"
    },
    {
      "id": "p14539-8a6564070aab",
      "target": "接下来会怎样？我会怎样——大家会怎样？"
    },
    {
      "id": "p14540-b7312802d826",
      "target": "将有何梦"
    },
    {
      "id": "p14541-d5d51eb36419",
      "target": "看来埃尔西诺一切顺利，我们往后还有漫长的人生。你有什么打算？"
    },
    {
      "id": "p14542-600c5810e5fa",
      "target": "有些事情变了，但我不明白为什么。"
    },
    {
      "id": "p14543-3e06192ad860",
      "target": "怎么回事？"
    },
    {
      "id": "p14544-e3cec5621f95",
      "target": "最好躺下休息一会儿。"
    },
    {
      "id": "p14545-59aa0c236a12",
      "target": "我现在不累。"
    },
    {
      "id": "p14546-3fe77f09c20d",
      "target": "什……现在几点了？"
    },
    {
      "id": "p14547-333f596d4e28",
      "target": "看来昨晚让我比想象中还要疲惫……"
    },
    {
      "id": "p14548-c1b13ad2b608",
      "target": "我竟然睡到现在，实在<i>太</i>晚了。"
    },
    {
      "id": "p14549-e0d4e79595b5",
      "target": "没必要。我知道下面有什么。"
    },
    {
      "id": "p14550-cb73ff83b60b",
      "target": "可等福丁布拉斯来了，这些也帮不了我们。"
    },
    {
      "id": "p14551-b15655997133",
      "target": "如果他不在这里，就没必要再翻他的东西了。"
    },
    {
      "id": "p14552-92db1447e560",
      "target": "你在<i>我的</i>私人物品里翻什么？"
    },
    {
      "id": "p14553-99f08e944d1f",
      "target": "别烦我，也别碰我的东西。"
    },
    {
      "id": "p14554-3d19dbe68743",
      "target": "（看来我该等他走了再翻找……）"
    },
    {
      "id": "p14555-4a8b4534f4c2",
      "target": "箱子里有一些笔记。"
    },
    {
      "id": "p14556-2530ae9c7571",
      "target": "很不对劲。他写得这么隐晦……到底是什么意思？他看到了什么？"
    },
    {
      "id": "p14557-f5f59c023d97",
      "target": "我不相信哈姆雷特变成这样，仅仅是因为我。"
    }
  ]
}
