{
  "translations": [
    {
      "id": "p05439-1bdb59897502",
      "target": "好吧。还挺有一手，是吧？"
    },
    {
      "id": "p05440-5d60845a6f70",
      "target": "平时我就让这儿的老芬尼根把你往肩上一扛，直接带走了，不过……"
    },
    {
      "id": "p05441-6889e3eb71db",
      "target": "这样吧。你不肯上奥马利的船，那我们就把<i>你们</i>这条破旧的船占为己有。"
    },
    {
      "id": "p05442-3584ad5a33af",
      "target": "我们绝不会向什么海盗女王宣誓效忠，也不会听你差遣。"
    },
    {
      "id": "p05443-3447808f6a92",
      "target": "没错！我不喜欢向任何东西效忠！海盗也一样！"
    },
    {
      "id": "p05444-dda942517f53",
      "target": "娇滴滴的女士们，这事可由不得你们。从今天起，<i>我</i>就是你们的船长。"
    },
    {
      "id": "p05445-f8fdc8f5d77d",
      "target": "我叫格蕾丝·奥马利，不过要是能让你们心里舒服些，叫我“海上恶婆娘”也行。"
    },
    {
      "id": "p05446-6feead625335",
      "target": "我和我的手下要占用船长的铺位，立刻生效。"
    },
    {
      "id": "p05447-d10c5bd128cb",
      "target": "那<i>我们</i>到底该怎么办？我们原本是要去英格兰的——"
    },
    {
      "id": "p05448-5c4e2c54c792",
      "target": "你们要干什么，原本要去哪儿，老娘才懒得管。你们爱怎么理解就怎么理解。"
    },
    {
      "id": "p05449-d7865cc88c78",
      "target": "……好了，失陪，我得去规划新航线了。"
    },
    {
      "id": "p05450-5924b29c620b",
      "target": "……你不该那么做的，哈姆雷特。"
    },
    {
      "id": "p05451-17f71d5f7918",
      "target": "我也不该杀了你父亲。可做都做了。"
    },
    {
      "id": "p05452-172e9f0aaaad",
      "target": "现在太迟了。做都做了。"
    },
    {
      "id": "p05453-ece998791eb5",
      "target": "奥菲莉娅。我能和你单独谈谈吗？"
    },
    {
      "id": "p05454-f1c89798d66d",
      "target": "船上这么挤，想单独谈可不容易。"
    },
    {
      "id": "p05455-a5126ee010a1",
      "target": "……要不去艏楼甲板？"
    },
    {
      "id": "p05456-a67fd36fe1eb",
      "target": "什么甲板？"
    },
    {
      "id": "p05457-c67809ca4953",
      "target": "艏楼甲板。就是靠近船头的那块。"
    },
    {
      "id": "p05458-b4366ffe5f54",
      "target": "你就算坐过帆船，也没坐过几次。你怎么会知道<i>这个</i>？"
    },
    {
      "id": "p05459-75005df19f63",
      "target": "嗯，至少我会看书啊。"
    },
    {
      "id": "p05460-0e45295280be",
      "target": "该商量一下怎么脱身回岸上了。"
    },
    {
      "id": "p05461-8d2bea394ade",
      "target": "你是说，发动叛乱。"
    },
    {
      "id": "p05462-ea340ae2e110",
      "target": "对。你……这……你能接受吗？"
    },
    {
      "id": "p05463-c51f752853ee",
      "target": "反正这事总会发生。我会做好准备。"
    },
    {
      "id": "p05464-e986ed090335",
      "target": "（她这是怎么了？）"
    },
    {
      "id": "p05465-7b3a2c2ff6f9",
      "target": "我们必须起来反抗船长，打她个措手不及。"
    },
    {
      "id": "p05466-33d36675bce5",
      "target": "然后到底要<i>做什么</i>？"
    },
    {
      "id": "p05467-2f0d4b2c85f1",
      "target": "我们被团团包围，人数也比不过他们。我们什么武器都没有。我不会使剑。萝茜和吉尔达会不会，我也不清楚。"
    },
    {
      "id": "p05468-96e1e640a063",
      "target": "船上还有忠于我们的人。再说，我有个计划。"
    },
    {
      "id": "p05469-008369b85a5f",
      "target": "很快，那位好船长就得睡觉了——到时候，她身上不会带武器。"
    },
    {
      "id": "p05470-7a89e0d4c4e9",
      "target": "那时，她的副手负责守夜。只要能让他失去行动能力，让她收不到警报……"
    },
    {
      "id": "p05471-007d07aaa36b",
      "target": "……然后我们就冲上去拿下她？"
    },
    {
      "id": "p05472-e2a4ccf0e102",
      "target": "……可是……那个女人不是一个人来的。她原来的船上人手齐全，就航行在我们前面。就算夺下了这条船，我们又怎么回丹麦？"
    },
    {
      "id": "p05473-ee944d1eb5df",
      "target": "关键就在这里。我们<i>不必</i>回到丹麦。只要驶到离丹麦海岸足够近的地方，让格蕾丝的手下不敢再追就行。"
    },
    {
      "id": "p05474-279cb9f61883",
      "target": "没有首领的信号，他们可能会反应迟缓。我不想承认，可要是风向有利，我们也许真能有那么一线机会。"
    },
    {
      "id": "p05475-40ac2564bef8",
      "target": "很高兴你信任我。"
    },
    {
      "id": "p05476-b2b8902b8257",
      "target": "我的这个计划……还留了一手，以防万一。"
    },
    {
      "id": "p05477-3914d180bff0",
      "target": "我是不是该害怕了？"
    },
    {
      "id": "p05478-a6df312c7204",
      "target": "奥菲莉娅——要是事情落到最坏的地步，萝茜和吉尔达被抓住了……"
    },
    {
      "id": "p05479-7728686a6966",
      "target": "……我打定主意，要把她们留给格蕾丝的剑。"
    },
    {
      "id": "p05480-bb71c7cd2701",
      "target": "你会……任由她们<i>死掉</i>？"
    },
    {
      "id": "p05481-a517b0fa7fad",
      "target": "……发生了一些事。我不想谈。至少现在不想。"
    },
    {
      "id": "p05482-a1316dcbe5df",
      "target": "她们效忠的是我叔叔。他把她们的口袋塞满金币，她们就替他监视我。"
    },
    {
      "id": "p05483-736e319a9580",
      "target": "从某种意义上说，我只是她们的收入来源。不管我们曾经有过什么交情……都……变了。"
    },
    {
      "id": "p05484-7f27d7b1aea1",
      "target": "我早该看出来，她们只会顾自己，还有彼此。说到底，一直都是这样。"
    },
    {
      "id": "p05485-4b7cbd0893bc",
      "target": "在这个可怕又丑陋的世界里，只有你我值得在乎。而我宁愿活下来的是你，不是我。"
    },
    {
      "id": "p05486-ae0b9bb1e4cf",
      "target": "……哈姆雷特，如果你的目标是让我活着，我觉得你可能弄错了轻重。"
    },
    {
      "id": "p05487-7de955f0d5d9",
      "target": "什么？这怎么会<i>不是</i>我的目标？"
    },
    {
      "id": "p05488-fdac3f5a1ec6",
      "target": "算了。我们照计划行动，看看会怎么样吧。"
    },
    {
      "id": "p05489-ed255323e0ab",
      "target": "她们骗了我，差点要了我的<i>命</i>……"
    },
    {
      "id": "p05490-fca4e935ab4f",
      "target": "你当我是傻子？"
    },
    {
      "id": "p05491-5a63ee231b7d",
      "target": "不完全是。你看，想要哈姆雷特死的<i>另有其人</i>。"
    },
    {
      "id": "p05492-7687cb0568b1",
      "target": "是国王！"
    },
    {
      "id": "p05493-0f983113edca",
      "target": "哦，亲爱的，这事我<i>全都</i>知道。"
    },
    {
      "id": "p05494-3eb7824338b2",
      "target": "我没多少操守，但我<i>确实</i>有自己的规矩。"
    },
    {
      "id": "p05495-016c51c81f9f",
      "target": "其中一条就是，朋友不能背叛朋友。"
    },
    {
      "id": "p05496-1703de444b7a",
      "target": "你们带来的那封信……我不能再让你们去祸害任何一片海岸。"
    },
    {
      "id": "p05497-9c0bf16fc56a",
      "target": "……我早该知道会走到这一步。"
    },
    {
      "id": "p05498-7d33465e7ea2",
      "target": "亏我还以为这次可能会好一点。"
    },
    {
      "id": "p05499-770d7374705a",
      "target": "现在。轮到你。"
    },
    {
      "id": "p05500-4d69624e27f6",
      "target": "我是不是还得担心<i>你</i>也来推翻我？"
    },
    {
      "id": "p05501-bf07e7d65496",
      "target": "就算我想，我也没那个本事。"
    },
    {
      "id": "p05502-149b45d78c22",
      "target": "反正我很快就会被送回过去。这样的命运对我没多大意义。"
    },
    {
      "id": "p05503-a0ccce1b8998",
      "target": "哼。听起来就是一堆好听的空话。"
    },
    {
      "id": "p05504-94565421f548",
      "target": "你们所有人都骗了我，差点要了我的<i>命</i>……"
    },
    {
      "id": "p05505-0915984a86d9",
      "target": "……对那种要把同伴扔进深海的狗东西，我有特别的惩罚。"
    },
    {
      "id": "p05506-331f49f617e3",
      "target": "你、你是说——哈姆雷特——打算让我们被杀？"
    },
    {
      "id": "p05507-3a33cdebd76b",
      "target": "他为什么要<i>这么做</i>？我们做了什么对不起他的事？"
    },
    {
      "id": "p05508-18ac18156ac7",
      "target": "他发现了你们俩带来的那封国王的信的真相。"
    },
    {
      "id": "p05509-0acc9ef19e30",
      "target": "信里要求处死他。"
    },
    {
      "id": "p05510-df7dcdac4d06",
      "target": "<i>什么？</i>真的？"
    },
    {
      "id": "p05511-f7c9dfe3cfe9",
      "target": "可我不知道啊！那封信毕竟是封着的……"
    },
    {
      "id": "p05512-605d27e9b78a",
      "target": "哈姆雷特。放了他。"
    },
    {
      "id": "p05513-bf11adfec9fa",
      "target": "呵呵呵。你们一定当我是傻子。你们会上岸逃跑，一直跑到甩掉我为止！"
    },
    {
      "id": "p05514-ac3674ca974d",
      "target": "……不完全是。无论过程多么意外，哈姆雷特的叔叔都会很高兴他死了。"
    },
    {
      "id": "p05515-873facf7ed69",
      "target": "他、他都准备杀了<i>我们</i>了。他已经彻底疯了。"
    },
    {
      "id": "p05516-41c99fb5a8dc",
      "target": "所以赏金不是由我们来付，而是由克劳狄斯国王来付。"
    },
    {
      "id": "p05517-695e087d1d18",
      "target": "在我听来，这买卖可不公平。"
    },
    {
      "id": "p05518-120eb0907d7c",
      "target": "哈姆雷特。收手吧。<i>求你了。</i>"
    },
    {
      "id": "p05519-f2a4d57b147a",
      "target": "……抱歉，奥菲莉娅。"
    },
    {
      "id": "p05520-938e205185fe",
      "target": "我连<i>你</i>也会杀。而且很乐意。"
    },
    {
      "id": "p05521-06c06dca605d",
      "target": "小子，我一只手就能打赢你。"
    },
    {
      "id": "p05522-961772515459",
      "target": "你愿意赌一把吗？"
    },
    {
      "id": "p05523-39796ff6a9f0",
      "target": "……你比看上去厉害。"
    },
    {
      "id": "p05524-bbc8b28b339b",
      "target": "可还没我厉害。"
    },
    {
      "id": "p05525-af89a47dd4ed",
      "target": "（该死……）"
    },
    {
      "id": "p05526-8f089ae63be5",
      "target": "看来我们双方手里都有做交易的筹码，哈姆雷特王子。"
    },
    {
      "id": "p05527-66a09c711834",
      "target": "放了我的副手，我就不杀你的朋友。也不杀你。"
    },
    {
      "id": "p05528-766f3d3a8db4",
      "target": "然后我们就能<i>太太平平</i>地继续驶向爱尔兰，你就待在底舱里。"
    },
    {
      "id": "p05529-074aec12302b",
      "target": "……现在就是机会，格蕾丝女士。"
    },
    {
      "id": "p05530-95795d0d3f99",
      "target": "他不会乖乖就范的。"
    },
    {
      "id": "p05531-a991a6457553",
      "target": "什……什么？怎么回事？"
    },
    {
      "id": "p05532-0533df6feeff",
      "target": "有人告诉了我们你的计划，哈姆雷特。你这个粗鲁、贪得无厌、连朋友都没有的蠢货。"
    },
    {
      "id": "p05533-0d4c03a62dd8",
      "target": "你身边这两位女士已经跟我谈妥了。她们出金币，要买你的人头。"
    },
    {
      "id": "p05534-eb43c8072368",
      "target": "啊、啊……不……"
    },
    {
      "id": "p05535-63f8b943febb",
      "target": "好了，女士们。来谈谈你们该付的钱。"
    },
    {
      "id": "p05536-2539a24c09cb",
      "target": "到……到了丹麦，就会安排的。"
    },
    {
      "id": "p05537-f44d252dd279",
      "target": "……哎呀呀。该摘下面具了。"
    },
    {
      "id": "p05538-863d676684df",
      "target": "各位，演得不错。"
    },
    {
      "id": "p05539-5e98a7a70b77",
      "target": "奥菲莉娅把你的计划告诉了我们所有人。"
    },
    {
      "id": "p05540-1184e92e3b83",
      "target": "女人之间也会聊天的，你知道吧！"
    },
    {
      "id": "p05541-d65e948ec276",
      "target": "为什么？你为什么要告诉她们？"
    },
    {
      "id": "p05542-8c387a67debe",
      "target": "是啊，这到底是怎么回事？"
    },
    {
      "id": "p05543-497ba4783354",
      "target": "听说你打算推翻我啊，小王子。"
    },
    {
      "id": "p05544-217a5a6229dc",
      "target": "幸好，你的奥菲莉娅姑娘提前给我报了信。"
    },
    {
      "id": "p05545-8058adb753d0",
      "target": "叛乱？"
    },
    {
      "id": "p05546-8211444b3e28",
      "target": "呃。你为什么要辜负我的信任，奥菲莉娅？"
    },
    {
      "id": "p05547-17f04219f885",
      "target": "你这满肚子算计的婊子。真不敢相信我竟然上了当。"
    },
    {
      "id": "p05548-2b11d231bbd3",
      "target": "我得先保住朋友们的命。"
    },
    {
      "id": "p05549-d82b872b7103",
      "target": "要是我不肯屈服呢？"
    },
    {
      "id": "p05550-d88b3cb25c53",
      "target": "……奥菲莉娅。他一直都这样吗？"
    },
    {
      "id": "p05551-6ab9e87c5776",
      "target": "在靠近丹麦海岸的地方，让我和奥菲莉娅女士乘长艇离开。这条船和船上的一切都归你。"
    },
    {
      "id": "p05552-146f7e93a4a7",
      "target": "不用再花任何代价，你就能多得一条船。你是个精明的女人。你看得出这笔交易的价值，不是吗？"
    },
    {
      "id": "p05553-36745c0b480f",
      "target": "留着我们换赎金，对你没什么用。一个等着被宰的疯王子——谁会花钱赎我？"
    },
    {
      "id": "p05554-1358125c40d3",
      "target": "这下咱们算是说到一块儿了。"
    },
    {
      "id": "p05555-f277bdb14557",
      "target": "好吧，哈姆雷特王子。你已经证明了自己的胆识。"
    },
    {
      "id": "p05556-2b49298e4a34",
      "target": "我会送你和你的心上人回丹麦。"
    },
    {
      "id": "p05557-6e8f2aa75403",
      "target": "仁慈这份礼物，我可不常给。"
    },
    {
      "id": "p05558-d97d1856b0fc",
      "target": "你真是彻头彻尾地疯了。"
    },
    {
      "id": "p05559-719c534a88de",
      "target": "他们都这么说。"
    },
    {
      "id": "p05560-a938a4873b22",
      "target": "这就是我讨厌你们这些宫廷贵族、戴王冠的家伙的原因。你们只会互相残杀。"
    },
    {
      "id": "p05561-163fcdded4df",
      "target": "你们话说得那么好听。到头来却全是空话。"
    },
    {
      "id": "p05562-a4c4a7fd5356",
      "target": "今天还是一家人，明天就要互相掐死。在这片海上，我信我的船员，胜过信你们中的任何一个。"
    },
    {
      "id": "p05563-660596b17eab",
      "target": "我本想直接把你们全杀了，不过看在奥菲莉娅肯提前提醒我的份上……"
    },
    {
      "id": "p05564-0a3d2fa39629",
      "target": "这条船就当我的战利品了，我会把你们留在丹麦岸上。"
    },
    {
      "id": "p05565-062ebe2d3a84",
      "target": "这期间也把血擦干净。会在木头上留下污渍。"
    },
    {
      "id": "p05566-19bf24a324ec",
      "target": "……那封信。我叔叔交给你们的那封。"
    },
    {
      "id": "p05567-15419793e575",
      "target": "我在里面发现了要我命的处决令——命令我一到英格兰就被处死。"
    },
    {
      "id": "p05568-0106e263e5fd",
      "target": "我曾经<i>信任</i>你们两个。"
    },
    {
      "id": "p05569-28809bb0c743",
      "target": "我们不知道信里写了什么。我向你发誓，哈姆雷特。"
    },
    {
      "id": "p05570-cb2360f629cd",
      "target": "如果我们知道自己送的是那种东西……"
    },
    {
      "id": "p05571-117966a51eea",
      "target": "当然，要杀一个人，有的是<i>远比这</i>简单的办法。"
    },
    {
      "id": "p05572-319878bd6cb1",
      "target": "我也是这么想的！比如把哈姆雷特推下船，伪装成意外！"
    },
    {
      "id": "p05573-1089b9b87c40",
      "target": "或者安排一场对这条船的袭击！"
    },
    {
      "id": "p05574-a9ddcb54a239",
      "target": "或者在他的晚餐里下毒……"
    },
    {
      "id": "p05575-f3cfd143463c",
      "target": "趁他睡觉时掐死他怎么样？"
    },
    {
      "id": "p05576-4e976a2d7e6d",
      "target": "你们这两个蠢货说完了没有？"
    },
    {
      "id": "p05577-68b1c8922ff5",
      "target": "哦，应该说完了。刚才只是有点想入神了。我们说到哪儿了？"
    },
    {
      "id": "p05578-4bae2b5348a2",
      "target": "虽然我答应过奥菲莉娅不伤害你们，可现在我想改主意了。"
    },
    {
      "id": "p05579-208f8791245f",
      "target": "也许我就砍掉两只手吧。"
    },
    {
      "id": "p05580-e91c9640339e",
      "target": "格蕾丝。请别这样。"
    },
    {
      "id": "p05581-5b54a8d5939b",
      "target": "怎么？还馋着他那把剑？"
    },
    {
      "id": "p05582-41052ec71360",
      "target": "你不能伤害他。他对我很重要，对他的国家也是。"
    },
    {
      "id": "p05583-e12b76cd222a",
      "target": "连切一小块都不行？一根拇指怎么样？往屁股里塞拇指，<i>一根</i>肯定也够他用了吧。"
    },
    {
      "id": "p05584-2ba9e775cdae",
      "target": "一根拇指也不行。"
    },
    {
      "id": "p05585-8f3c7475abc3",
      "target": "你这话让我很不快。"
    },
    {
      "id": "p05586-ef4cb9c216d0",
      "target": "我没问你，王室小麻烦。"
    },
    {
      "id": "p05587-fc0780ee884a",
      "target": "看来我的三位同伴各自都有理由指责对方。"
    },
    {
      "id": "p05588-3c282d021bc2",
      "target": "呃，没错！她说得对！"
    },
    {
      "id": "p05589-ad0cc3c69715",
      "target": "尊贵的海盗女士，这场骚乱给您添了麻烦，我们<i>万分</i>谦卑地向您道歉。"
    },
    {
      "id": "p05590-34f009ecbc2b",
      "target": "另外，<i>求您</i>别杀我们。"
    },
    {
      "id": "p05591-5a6f8afc9c53",
      "target": "王子，你能靠这位姑娘保住命，真是走运。"
    },
    {
      "id": "p05592-e86aa03f533b",
      "target": "她至少还有那么一点操守。你们其余几个，可就没多少了。"
    },
    {
      "id": "p05593-16f3997ce028",
      "target": "我会送你们所有人回丹麦。"
    },
    {
      "id": "p05594-30db9790b763",
      "target": "仁慈这份礼物，我可不常给。你们今天都很走运。"
    },
    {
      "id": "p05595-591c7580fc2d",
      "target": "仁慈就是送我们回埃尔西诺？可我一点也<i>感觉</i>不到。"
    },
    {
      "id": "p05596-6e80e903cc14",
      "target": "那我们就回去吧。"
    },
    {
      "id": "p05597-1aaee1931b4d",
      "target": "到了。这条船和船上所有货物现在都归我了。赶紧走吧！"
    },
    {
      "id": "p05598-50a72aaa507d",
      "target": "原来是真的。我听说你回来了。"
    },
    {
      "id": "p05599-dd88adf39297",
      "target": "哈姆雷特也回来了，看着还十分健康。"
    },
    {
      "id": "p05600-a0a86fba8155",
      "target": "我曾信任你。我不会再犯这样的错了。"
    },
    {
      "id": "p05601-2e9541f52694",
      "target": "我那个蠢侄子终于被“处理”了。真让我刮目相看，你把我需要你做的事办得分毫不差。"
    },
    {
      "id": "p05602-cadcc595c1cd",
      "target": "看来你比表面上狡黠得多。"
    },
    {
      "id": "p05603-67e8ce5fad2a",
      "target": "我要向你道谢，也向你表达我的感激。"
    },
    {
      "id": "p05604-97fbf5d8f46f",
      "target": "你的聪慧与你的美貌不相上下。"
    },
    {
      "id": "p05605-ce0359e512e9",
      "target": "我就是想让您满意。"
    },
    {
      "id": "p05606-035491e37250",
      "target": "亲爱的。时候到了。你准备好宣布我们的消息了吗？"
    },
    {
      "id": "p05607-5900651264fd",
      "target": "这一切来得太快了。"
    },
    {
      "id": "p05608-3eec56e0ebf3",
      "target": "这种事往往如此。"
    },
    {
      "id": "p05609-2ec4b22df137",
      "target": "我就不多作耽搁了，要宣布一个消息。"
    },
    {
      "id": "p05610-ee2d5506c2dd",
      "target": "我将与奥菲莉娅女士订婚。就在今天。"
    },
    {
      "id": "p05611-cf58359a8330",
      "target": "啊、啊……我怎么没听说这件事？"
    },
    {
      "id": "p05612-4befa6224241",
      "target": "算了……是啊，算了。"
    },
    {
      "id": "p05613-344b48c7dbba",
      "target": "陛下，您确定不等城堡牧师从乡间巡访回来吗？"
    },
    {
      "id": "p05614-81a19227950b",
      "target": "十分确定，贝尔纳多。我们一分钟也不再等了。"
    },
    {
      "id": "p05615-4cf0a2ad7a12",
      "target": "还、还有——奥菲莉娅女士——这也是您的心愿吗？这桩婚事？"
    },
    {
      "id": "p05616-45d326af6bcd",
      "target": "考虑到眼下的情况，这实在，呃，有些令人意外。"
    },
    {
      "id": "p05617-610e74a3e3a4",
      "target": "我知道这很突然，贝尔纳多。但这是我想要的。真的。"
    },
    {
      "id": "p05618-bc837ec5d0bd",
      "target": "让我们一同见证丹麦国王克劳狄斯陛下与波洛涅斯公爵之女奥菲莉娅女士的订婚。"
    },
    {
      "id": "p05619-4c1a50dd7f21",
      "target": "贝尔纳多不在这里，我想请在场的伏尔提曼德来主持仪式。"
    }
  ]
}
