{
  "translations": [
    {
      "id": "s00200-16c12f23786c",
      "target": "奥赛罗！"
    },
    {
      "id": "s00201-411a317bd705",
      "target": "什么——！"
    },
    {
      "id": "s00202-bfeb0cda1454",
      "target": "啊——啊——是的！"
    },
    {
      "id": "s00203-5a98220434db",
      "target": "哼！"
    },
    {
      "id": "s00204-01e2accb4791",
      "target": "克、克劳狄斯！"
    },
    {
      "id": "s00205-0992274decf4",
      "target": "唔……"
    },
    {
      "id": "s00206-b1a636abd588",
      "target": "你！"
    },
    {
      "id": "s00207-fd5a4de56a44",
      "target": "哦、哦。"
    },
    {
      "id": "s00208-b9b7e41c1358",
      "target": "我——明白了。"
    },
    {
      "id": "s00209-52ea67359dfa",
      "target": "再见。"
    },
    {
      "id": "s00210-fb556d76bb67",
      "target": "……是的。"
    },
    {
      "id": "s00211-f3c093c166d4",
      "target": "确实。"
    },
    {
      "id": "s00212-d07a178bc193",
      "target": "阿门。"
    },
    {
      "id": "s00213-a59ac9277916",
      "target": "啊、啊……"
    },
    {
      "id": "s00214-d2eeddd69b40",
      "target": "奥菲莉娅——"
    },
    {
      "id": "s00215-dd0c07a64a80",
      "target": "唔……"
    },
    {
      "id": "s00216-6766f09fdc5e",
      "target": "求你了。"
    },
    {
      "id": "s00217-3ae926405671",
      "target": "啊……"
    },
    {
      "id": "s00218-67fd7e7b013a",
      "target": "……哈姆雷特。"
    },
    {
      "id": "s00219-6c3d2451723f",
      "target": "呃……"
    },
    {
      "id": "s00220-e8ba09e68142",
      "target": "然后呢？"
    },
    {
      "id": "s00221-6e68bfcbbdd9",
      "target": "嗯——"
    },
    {
      "id": "s00222-2c33dcef91e0",
      "target": "好。"
    },
    {
      "id": "s00223-3087d29b383d",
      "target": "父亲……"
    },
    {
      "id": "s00224-7f73656d06a0",
      "target": "……雷欧提斯。"
    },
    {
      "id": "s00225-d251f2549d80",
      "target": "……啊。"
    },
    {
      "id": "s00226-4db23d9c17dd",
      "target": "（真有意思。）"
    },
    {
      "id": "s00227-1c6575c6420f",
      "target": "……呵。"
    },
    {
      "id": "s00228-7db539e6d78c",
      "target": "……啊……"
    },
    {
      "id": "s00229-e3d7c58e8bf8",
      "target": "吉、吉、吉尔达？！"
    },
    {
      "id": "s00230-6eb97861f767",
      "target": "……唉——。"
    },
    {
      "id": "s00231-d6801dd247af",
      "target": "波希米亚？"
    },
    {
      "id": "s00232-cda18bd5898f",
      "target": "奥……奥菲莉娅！"
    },
    {
      "id": "s00233-df30783f4971",
      "target": "自由了？"
    },
    {
      "id": "s00234-47431c39399b",
      "target": "（天哪。）"
    },
    {
      "id": "s00235-b3507287c403",
      "target": "……好了。"
    },
    {
      "id": "s00236-a37d60a214d3",
      "target": "可是——克劳狄斯——"
    },
    {
      "id": "s00237-ad34642f53ec",
      "target": "（嗯……）"
    },
    {
      "id": "s00238-e0e83e539f13",
      "target": "乔塔……"
    },
    {
      "id": "s00239-4dbb501a545b",
      "target": "布莉特……"
    },
    {
      "id": "s00240-977d8495cc67",
      "target": "……空了。"
    },
    {
      "id": "s00241-a38c4a2d7548",
      "target": "啊哈。"
    },
    {
      "id": "s00242-b8552821953a",
      "target": "……该死。"
    },
    {
      "id": "s00243-708454aa097a",
      "target": "呵。"
    },
    {
      "id": "s00244-9612eef80e0a",
      "target": "（父亲——）"
    },
    {
      "id": "s00245-a1f978cdf63c",
      "target": "（什么？）"
    },
    {
      "id": "s00246-6aee86e19437",
      "target": "这个。"
    },
    {
      "id": "s00247-5dfc86f75125",
      "target": "嗯——？"
    },
    {
      "id": "s00248-f8de5235a137",
      "target": "嗯。"
    },
    {
      "id": "s00249-633961a882ed",
      "target": "嗯、嗯……"
    },
    {
      "id": "s00250-7374bba56ef3",
      "target": "因为——"
    },
    {
      "id": "s00251-ed1eee94bb7c",
      "target": "……嗯？"
    },
    {
      "id": "s00252-92f317287228",
      "target": "它……"
    },
    {
      "id": "s00253-01d304d082fc",
      "target": "（雷欧提斯……）"
    },
    {
      "id": "s00254-212586f34642",
      "target": "也许……"
    },
    {
      "id": "s00255-ce984d040f59",
      "target": "……嗯。"
    },
    {
      "id": "s00256-4bb2d00872d3",
      "target": "……重复？"
    },
    {
      "id": "s00257-96730ffc8816",
      "target": "嗯。"
    },
    {
      "id": "s00258-12f4a5a06eb8",
      "target": "怎么——那是——你、你——"
    },
    {
      "id": "s00259-1d17b9ac4ee4",
      "target": "什么……？"
    },
    {
      "id": "s00260-b4073d09df11",
      "target": "……什么？"
    },
    {
      "id": "s00261-881b8be7212b",
      "target": "唉。"
    },
    {
      "id": "s00262-abed42131b85",
      "target": "幽灵？"
    },
    {
      "id": "s00263-cf6751754117",
      "target": "（嗯。）"
    },
    {
      "id": "s00264-3c9f6c51d368",
      "target": "啊、啊。"
    },
    {
      "id": "s00265-b06662f4fccb",
      "target": "注意到了？"
    },
    {
      "id": "s00266-5af35db6f8fe",
      "target": "嗯……"
    },
    {
      "id": "s00267-25e4a60f7335",
      "target": "啊——"
    },
    {
      "id": "s00268-b9863fb64b85",
      "target": "祖母？"
    },
    {
      "id": "s00269-293a14be4635",
      "target": "西——<i>西蒙娜？</i>"
    },
    {
      "id": "s00270-525333d3332d",
      "target": "这是——哦——"
    },
    {
      "id": "s00271-8b271aeb94dc",
      "target": "……啊。"
    },
    {
      "id": "s00272-cef3928f3542",
      "target": "……哦。"
    },
    {
      "id": "s00273-2d83ba4a98fd",
      "target": "瘟疫。"
    },
    {
      "id": "s00274-eb3b9b2d6c7f",
      "target": "我会……"
    },
    {
      "id": "s00275-1ba3ef51dc98",
      "target": "啊……"
    },
    {
      "id": "s00276-0e596a0aed58",
      "target": "无聊。"
    },
    {
      "id": "s00277-87584f81fc72",
      "target": "呃！"
    },
    {
      "id": "s00278-9c817f72bfd7",
      "target": "……真有意思。"
    },
    {
      "id": "s00279-a627919d78ec",
      "target": "也许吧。"
    },
    {
      "id": "s00280-8a6489705284",
      "target": "<i>死了？</i>"
    },
    {
      "id": "s00281-429cffb10c29",
      "target": "奥、奥菲莉娅？"
    },
    {
      "id": "s00282-2b2f71bff405",
      "target": "为什么——"
    },
    {
      "id": "s00283-6d408394f289",
      "target": "吉尔达……"
    },
    {
      "id": "s00284-8bc4e368e492",
      "target": "毒、毒药？"
    },
    {
      "id": "s00285-a3e5d628e8fe",
      "target": "呃——"
    },
    {
      "id": "s00286-9f1720b3af82",
      "target": "玛格丽特？"
    },
    {
      "id": "s00287-95a796e19d58",
      "target": "当然！"
    },
    {
      "id": "s00288-48a44d121bf1",
      "target": "看到了吧？"
    },
    {
      "id": "s00289-57d828482c51",
      "target": "才不是。"
    },
    {
      "id": "s00290-4d96c68c25e2",
      "target": "父亲。"
    },
    {
      "id": "s00291-a3c7ce2c996f",
      "target": "呃——"
    },
    {
      "id": "s00292-2c66bded19d5",
      "target": "呃——"
    },
    {
      "id": "s00293-eba2c0d06ccd",
      "target": "雷欧提斯？"
    },
    {
      "id": "s00294-49721faa8421",
      "target": "同意。"
    },
    {
      "id": "s00295-9d5101569b5e",
      "target": "晚安！"
    },
    {
      "id": "s00296-030e28614851",
      "target": "不——"
    },
    {
      "id": "s00297-cc66b9eb5f1e",
      "target": "是的……"
    },
    {
      "id": "s00298-126a472b79ef",
      "target": "啊——父亲。"
    },
    {
      "id": "s00299-94d0e648e600",
      "target": "……哦。"
    },
    {
      "id": "s00300-cabe38ca7c02",
      "target": "姐妹。"
    },
    {
      "id": "s00301-af717c087cb1",
      "target": "很奇怪？"
    },
    {
      "id": "s00302-7a6a2f4dc050",
      "target": "（奇怪……）"
    },
    {
      "id": "s00303-9fef880e04c1",
      "target": "哦啊——啊！"
    },
    {
      "id": "s00304-5dde40f869f4",
      "target": "……怎么？"
    },
    {
      "id": "s00305-8cdeb04ddb42",
      "target": "阿斯特丽德……"
    }
  ]
}
