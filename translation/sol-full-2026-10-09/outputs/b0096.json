{
  "translations": [
    {
      "id": "p13900-e313a5803d82",
      "target": "她最近去世了。其实，就是刚刚的事。"
    },
    {
      "id": "p13901-e0b7090eb047",
      "target": "你说真的？她在我赌桌上输的钱，还欠着我一大笔呢！"
    },
    {
      "id": "p13902-ddbdeebbf9a3",
      "target": "这下我还怎么讨得回来？这些四处游荡、没用的贵族女人……"
    },
    {
      "id": "p13903-193b5b0b58b2",
      "target": "天哪。可话说回来，我确实挺喜欢她的。"
    },
    {
      "id": "p13904-317eb30de9b5",
      "target": "我都有点觉得，这种事不过又是她搞的蠢恶作剧。"
    },
    {
      "id": "p13905-b4898fe51db6",
      "target": "哦。呃。"
    },
    {
      "id": "p13906-c09ddf5c3d1d",
      "target": "哈姆雷特，关于吉尔登斯吞女士，我有件事想和你谈谈。"
    },
    {
      "id": "p13907-3cdc2aad92bd",
      "target": "她突然去世了。很抱歉，得由我来告诉你这个消息。"
    },
    {
      "id": "p13908-810530fa0da2",
      "target": "她是怎么去世的？什么时候的事？"
    },
    {
      "id": "p13909-b2aebb00060e",
      "target": "她，呃……她……是……她……淹死了。对。淹死了。"
    },
    {
      "id": "p13910-be4708c376d7",
      "target": "很遗憾，就在码头边的水里。"
    },
    {
      "id": "p13911-50134a3bfa88",
      "target": "太可怕了。"
    },
    {
      "id": "p13912-81f30614529c",
      "target": "是谁让这种事发生的？守卫在哪儿？为什么没人看着？"
    },
    {
      "id": "p13913-9cd1024976cf",
      "target": "罗茜知道吗？要是不知道，就该告诉她。"
    },
    {
      "id": "p13914-b82defca133a",
      "target": "还有——我要<i>立刻</i>调查这件事。我要知道到底发生了什么。"
    },
    {
      "id": "p13915-e01c6d686844",
      "target": "我得先弄清楚发生了什么。其他的事之后再说。"
    },
    {
      "id": "p13916-1f055b1f3257",
      "target": "（骗他让我很难受，可吉尔达让我这么做……）"
    },
    {
      "id": "p13917-d206f7e5e182",
      "target": "有……有件事我得和你谈谈。"
    },
    {
      "id": "p13918-7630737c4163",
      "target": "很抱歉，得由我来告诉你这件事，可是……吉尔登斯吞去世了。"
    },
    {
      "id": "p13919-47cd37b6abaf",
      "target": "她，呃，淹死了。就在码头边。"
    },
    {
      "id": "p13920-562847c6e8ec",
      "target": "我也没想到会这样。"
    },
    {
      "id": "p13921-619a78673335",
      "target": "这又是她搞的蠢恶作剧，对不对？"
    },
    {
      "id": "p13922-f83ee4db7975",
      "target": "不。不……如果是你来告诉我……那一定是真的。"
    },
    {
      "id": "p13923-8b1e20af4910",
      "target": "她以前搞恶作剧，从来没找过别人帮忙。"
    },
    {
      "id": "p13924-ef1113c25abf",
      "target": "那就是真的了。"
    },
    {
      "id": "p13925-60a02bd0cd61",
      "target": "吉尔达……我……"
    },
    {
      "id": "p13926-f990315b4a18",
      "target": "（这太残忍了。）"
    },
    {
      "id": "p13927-b26bd7403bd1",
      "target": "她去码头边干什么？她不会游泳。我们<i>两个</i>都知道。"
    },
    {
      "id": "p13928-909660d761b8",
      "target": "奥菲莉娅，真奇怪。我知道你说的是真的，可就是觉得不真实。"
    },
    {
      "id": "p13929-c83c224b66c2",
      "target": "你知道吗，我父亲去世时，我也是这种感觉。我以为自己会悲伤。可是——什么感觉都没有。什么都没有。"
    },
    {
      "id": "p13930-f7d3a2a63152",
      "target": "只觉得整个世界突然失去了支撑。"
    },
    {
      "id": "p13931-b89084dd9014",
      "target": "我……我<i>必须</i>安排后事。不会有别人来做了。"
    },
    {
      "id": "p13932-ef2f882928f1",
      "target": "请容我失陪。"
    },
    {
      "id": "p13933-929e26d3d63b",
      "target": "（骗她让我很难受，可吉尔达让我这么做。）"
    },
    {
      "id": "p13934-ddcb15f0d333",
      "target": "她最近去世了，不知道你有没有听说。"
    },
    {
      "id": "p13935-5472f5b3ef6b",
      "target": "哦。嗯？吉尔登斯吞？啊，对，戴帽子的那位。我想起来了。"
    },
    {
      "id": "p13936-a8e1b577bb5c",
      "target": "是位不错的女士。这么年轻就去世了，真可惜。"
    },
    {
      "id": "p13937-ed0de59d7a61",
      "target": "（他似乎并不怎么在意……）"
    },
    {
      "id": "p13938-d89f38550c80",
      "target": "嗯，是啊，这种事时不时就会发生！真不幸，真让人难过！"
    },
    {
      "id": "p13939-5329f427f73a",
      "target": "哦。那位吉尔登斯吞女士？和哈姆雷特同一所学校的那位？"
    },
    {
      "id": "p13940-8b250dc252ce",
      "target": "他一定伤心极了。听到这个消息，我很难过，奥菲莉娅。"
    },
    {
      "id": "p13941-e672f7cee623",
      "target": "我带来了关于吉尔登斯吞女士的坏消息……"
    },
    {
      "id": "p13942-ed1835bc17d0",
      "target": "吉尔登斯吞是哪位来着？"
    },
    {
      "id": "p13943-3991607db6da",
      "target": "啊，算了。我正要去找点东西吃。这事我们晚点再谈。"
    },
    {
      "id": "p13944-5f613f886ac7",
      "target": "啊。失去她，我很难过，奥菲莉娅。她是哈姆雷特的好朋友。"
    },
    {
      "id": "p13945-5aba02f94a5c",
      "target": "我想，这种事总是会发生的。"
    },
    {
      "id": "p13946-ea4980b343be",
      "target": "（她似乎并不怎么在意……）"
    },
    {
      "id": "p13947-26ddae562920",
      "target": "她死了？"
    },
    {
      "id": "p13948-692296ad1d7c",
      "target": "唉。那我得想个——什么办法——来——纪念她。"
    },
    {
      "id": "p13949-9218a016abb6",
      "target": "（还得想个办法盯着哈姆雷特……）"
    },
    {
      "id": "p13950-fb78a492659b",
      "target": "我想是得如此。"
    },
    {
      "id": "p13951-14c90c5a7d6f",
      "target": "啊。听到这消息，我很难过。她看起来是位和善、讨人喜欢、有教养的女士。"
    },
    {
      "id": "p13952-64328255e154",
      "target": "我带来了关于吉尔登斯吞女士的坏消息。"
    },
    {
      "id": "p13953-8283715207dd",
      "target": "哦，真的？怎么死的？"
    },
    {
      "id": "p13954-440fc03d8740",
      "target": "她，呃，淹死了。"
    },
    {
      "id": "p13955-94954b176785",
      "target": "你真不会撒谎，菲莉。你那双绿色的大眼睛一下就把你出卖了。"
    },
    {
      "id": "p13956-f2936a7d4950",
      "target": "这、这么容易看出来吗？"
    },
    {
      "id": "p13957-931523486883",
      "target": "我只说一句：你永远别想靠打牌谋生。永远。"
    },
    {
      "id": "p13958-6f19ab95a085",
      "target": "换成别人，我或许会信你，可吉尔登斯吞这辈子就没做过一件真事。说起来，就连死也不例外。"
    },
    {
      "id": "p13959-93752f08e149",
      "target": "所以她跑去装死了，是吧？我都等不及看<i>这件事</i>最后怎么绕回她头上了。"
    },
    {
      "id": "p13960-b7130181e89f",
      "target": "那么，装死这件事。真的<i>绝不</i>会出岔子吗？"
    },
    {
      "id": "p13961-21bc123144db",
      "target": "绝对不会！不可能。我的所有计划都天衣无缝。"
    },
    {
      "id": "p13962-5bfec4a1ddd2",
      "target": "就算<i>不是</i>，嗯……"
    },
    {
      "id": "p13963-d1af8fd0212f",
      "target": "你知道，我跑得可快了。他们绝对抓不到我。"
    },
    {
      "id": "p13964-aa5749dcea23",
      "target": "王后，您和布莉特很亲近。您知道她为什么这么消沉吗？"
    },
    {
      "id": "p13965-3e03c1ea5861",
      "target": "哦，布莉特……最近我真是快受够她了。"
    },
    {
      "id": "p13966-9cf62379515f",
      "target": "她对我<i>动不动</i>就发脾气——就因为她来了这里之后，一直没收到母亲的消息。"
    },
    {
      "id": "p13967-710c1b6a8864",
      "target": "她母亲没给她写信？可她母亲就住在不远的地方啊。"
    },
    {
      "id": "p13968-2fb138648430",
      "target": "哦，天哪，她当然给布莉特写了信！那个讨厌的女人给布莉特写信就没<i>停过</i>。几乎每天都有一封新信送进城门。"
    },
    {
      "id": "p13969-9239fc8da61b",
      "target": "不过，我当然把信全藏起来了。"
    },
    {
      "id": "p13970-f3791ddf7819",
      "target": "把……信藏起来了？"
    },
    {
      "id": "p13971-9247123f4d82",
      "target": "是的。这是我的职责，奥菲莉娅。布莉特的父亲送她来这里，是要她成为一位宫廷贵女，抛开那些幼稚的事。"
    },
    {
      "id": "p13972-37867e4155ed",
      "target": "他提醒过我，布莉特会找尽各种借口再跑回家去。但他绝不允许。她要成为布罗肯胡斯女士。"
    },
    {
      "id": "p13973-ad53aae4198c",
      "target": "我能想到的办法，就只有把布莉特母亲的信藏起来。要是她读了那些信，只会更想家，到时候怎么办？"
    },
    {
      "id": "p13974-b7e058ce49b4",
      "target": "再说，那些信实在太<i>让人消沉</i>了。“亲爱的，真希望你能回家。”“真希望你从没离开过。”所以，我把那些傻乎乎的信都放到了无人倾听的愿望该去的地方。"
    },
    {
      "id": "p13975-d9bfd06819ae",
      "target": "“无人倾听的愿望该去的地方”？"
    },
    {
      "id": "p13976-5c796e28097c",
      "target": "哦。没什么。忘了我说的话吧！"
    },
    {
      "id": "p13977-fdf0b7a86cad",
      "target": "你和布莉特白天都常待在画廊。你和她深入聊过吗？"
    },
    {
      "id": "p13978-2426b88e0ce1",
      "target": "那当然。"
    },
    {
      "id": "p13979-f81b043c7200",
      "target": "你知道她在为什么苦恼吗？"
    },
    {
      "id": "p13980-4690f43cfa36",
      "target": "那是心灵的病痛。你知道，在这方面，布莉特女士和我是同道中人。"
    },
    {
      "id": "p13981-c34dc6f6f6fc",
      "target": "你知道她是个画家吗？而且画得相当好。可她被禁止画画了。"
    },
    {
      "id": "p13982-c92af58524d4",
      "target": "不创作的艺术家，会把所有时间都浪费在恶毒地嫉妒那些正在创作的人上。"
    },
    {
      "id": "p13983-b3ab0dd0703f",
      "target": "她那些油彩真是可惜了。不知道她还能不能拿回来。"
    },
    {
      "id": "p13984-9ac2dd29089a",
      "target": "油彩？你是说油……画颜料？"
    },
    {
      "id": "p13985-521127350777",
      "target": "是的。据我所知，她来这里时，父亲把那些颜料全没收了。不准她在埃尔西诺使用。"
    },
    {
      "id": "p13986-8f0cab94929a",
      "target": "我完全不知道。她不能再做一些吗？"
    },
    {
      "id": "p13987-53f4c92f38bb",
      "target": "当然能。做些新画具并不难，可布莉特不是会开口求助的人。如果你想帮帮这位画家女士，我可以出力。"
    },
    {
      "id": "p13988-e34b601a9199",
      "target": "我有调色用的色粉，不过还需要调制油彩的基料、一些做画布的材料，还有木炭。好在这些都很容易弄到！"
    },
    {
      "id": "p13989-de9f2c077b09",
      "target": "我需要一些鸡蛋、画素描用的木炭，还有做画布用的亚麻布。"
    },
    {
      "id": "p13990-739afb235d96",
      "target": "亚麻布……我有好几件贴身衣服就是用它做的……嗯。"
    },
    {
      "id": "p13991-0fb5a624643e",
      "target": "等你把东西找齐了，就告诉我，我来帮忙处理那些精细的活儿。"
    },
    {
      "id": "p13992-c3080ed280a2",
      "target": "你比大多数人都了解布莉特女士。你知道她的心情为什么这么反常吗？"
    },
    {
      "id": "p13993-0e3cdaf52e7f",
      "target": "说起布莉特女士最近的事，我真不知道该说什么。"
    },
    {
      "id": "p13994-60882fc4ebed",
      "target": "我只知道，听了你之前告诉我的那些事，我必须立刻和她谈谈。"
    },
    {
      "id": "p13995-79785444b49b",
      "target": "这样我就有机会和她把话说开了。我相信一定能。"
    },
    {
      "id": "p13996-55c91cb822c0",
      "target": "现在我知道了，她本来打算背叛我们的国家，让我们全都被杀，那些又有什么要紧？"
    },
    {
      "id": "p13997-3a6798e10610",
      "target": "她<i>骗了</i>我们，奥菲莉娅。尤其是，她骗了<i>我</i>。我爱她，她却看着我的眼睛，对我说谎。"
    },
    {
      "id": "p13998-4487f81b4e43",
      "target": "什么样的扭曲之人才做得出这种事？我想我已经不愿再了解她了。我宁愿抛开她，假装她从未存在过。"
    },
    {
      "id": "p13999-6390f3bf6e8b",
      "target": "我只希望能有片刻安宁，和她待在一起。"
    },
    {
      "id": "p14000-c13b6152a4fd",
      "target": "可眼下，事情一路发展到现在——我不知道什么时候才能再有那样安宁的片刻。"
    },
    {
      "id": "p14001-67976f1ae3f5",
      "target": "（看来，我找他找得太晚了。）"
    },
    {
      "id": "p14002-8189f203a7ff",
      "target": "布莉特怎么了？"
    },
    {
      "id": "p14003-2e8427bd6d73",
      "target": "她对你说了什么吗？"
    },
    {
      "id": "p14004-8e0a4e3af3b4",
      "target": "也不算——但有些不对劲。我看得出来。"
    },
    {
      "id": "p14005-0d4eb890ef3e",
      "target": "前几天晚上我才和她见过面。她……有很多心事。"
    },
    {
      "id": "p14006-2deae482207d",
      "target": "我觉得该让她自己待一会儿，奥菲莉娅。让她理清这些事。"
    },
    {
      "id": "p14007-e6384cf1017e",
      "target": "（也许，如果我在他们见面之前就找他，他会替我和她谈谈。）"
    },
    {
      "id": "p14008-aab2c420f11c",
      "target": "你不坐船去巴黎了？"
    },
    {
      "id": "p14009-4ba98608f589",
      "target": "本来要去的。不过，晚一周巴黎也不会跑掉。"
    },
    {
      "id": "p14010-447332daaf9a",
      "target": "谢谢你，妹妹，这件事你说得正是时候。"
    },
    {
      "id": "p14011-7f4fd213c736",
      "target": "你要是再晚一点找到我，我就把她独自留下了。"
    },
    {
      "id": "p14012-268ec05fb975",
      "target": "布莉特女士为什么会那样待人？"
    },
    {
      "id": "p14013-6a27f3d7f4d0",
      "target": "你是说，她这样不会免受惩罚？"
    },
    {
      "id": "p14014-877504caa2f4",
      "target": "她刚踏进这座城堡，母亲就想让我们成为好友。我拒绝了。"
    },
    {
      "id": "p14015-0e59670cb9b9",
      "target": "从某种意义上说，在她眼里，我永远都只会是个工具。"
    },
    {
      "id": "p14016-9100ad59c1f3",
      "target": "你比大多数人都了解布莉特女士。你知道她为什么脾气这么坏吗？"
    },
    {
      "id": "p14017-84d908bfe9d3",
      "target": "知道。她不是自愿来这里的。"
    },
    {
      "id": "p14018-3348c34a7b48",
      "target": "她被送来这里，打的是维系丹麦王室与贵族之间友好关系的名义。"
    },
    {
      "id": "p14019-05a1c0664fc8",
      "target": "她的家族比任何其他家族都更源远流长。祖上有很久以前的国王、王后之类的人物。"
    },
    {
      "id": "p14020-2ce8415473fe",
      "target": "可尽管她的身份给了她那么多权力，她也不过是被这身份囚禁的人。"
    },
    {
      "id": "p14021-9db71af4402b",
      "target": "在所有女人里，你最该明白这一点。"
    },
    {
      "id": "p14022-fae48eb36625",
      "target": "镇门口的西格纳斯举止很奇怪。说什么“处境危险”，还有“赢的钱”。你知道是为什么吗？"
    },
    {
      "id": "p14023-2eaea8334406",
      "target": "啊……啊……我不知道！"
    },
    {
      "id": "p14024-f60f519e5c0b",
      "target": "别瞪着那双大眼睛，气冲冲地看我！谁来问我都不会说！"
    },
    {
      "id": "p14025-0d48a3d7c607",
      "target": "（好吧，显然他<i>知道</i>，只是不肯告诉我。）"
    },
    {
      "id": "p14026-7bfc4b1d8b65",
      "target": "（那该问谁呢？）"
    },
    {
      "id": "p14027-53f31cdcf584",
      "target": "伊尔玛，镇门口的守卫说了些奇怪的话。好像和“把输的钱赢回来”有关。你知道是怎么回事吗？"
    },
    {
      "id": "p14028-2f3857019dc6",
      "target": "有些蠢货就是管不住自己的嘴。"
    },
    {
      "id": "p14029-dd403f8cfd18",
      "target": "<i>我</i>这个老太婆可知道该怎么做。"
    },
    {
      "id": "p14030-f0948471c714",
      "target": "（好吧，显然她<i>知道</i>，只是不肯告诉我。）"
    },
    {
      "id": "p14031-095c21340e16",
      "target": "贝尔纳多，你手下的人最近都在干些什么？"
    },
    {
      "id": "p14032-c8e72e7fffa5",
      "target": "最近？什么也没干。当然……"
    },
    {
      "id": "p14033-b143651fa432",
      "target": "几个星期前，赌博闹出过一些事。我知道他们会赌，但我已经禁止他们在城堡里赌博了。"
    },
    {
      "id": "p14034-56aa52110a86",
      "target": "这是罪恶的行为，会败坏纪律。我绝不容许守卫宿舍里发生这种事。"
    },
    {
      "id": "p14035-67a4fbd5a12e",
      "target": "你确定他们已经不赌了？西格纳斯提到过，说他们“晚上”玩。"
    },
    {
      "id": "p14036-cd398e332b7b",
      "target": "你确定他们已经不赌了？我见过伊尔玛往守卫宿舍里去。"
    },
    {
      "id": "p14037-f236f0a72ecb",
      "target": "……那群蠢货。"
    },
    {
      "id": "p14038-38e07f4bf0ef",
      "target": "我会留意的。以后要是让我发现什么……"
    },
    {
      "id": "p14039-573b2ec8896d",
      "target": "我会立刻严惩，绝不留情。"
    },
    {
      "id": "p14040-169316ac0c49",
      "target": "这件事我会立刻严惩，绝不留情。"
    },
    {
      "id": "p14041-1981ba13509d",
      "target": "布莉特，你知道守卫为什么觉得自己在贝尔纳多那里“处境危险”吗？"
    },
    {
      "id": "p14042-ee956b1100da",
      "target": "我敢肯定，是因为他们偷偷摸摸地玩骰子赌博。马塞勒斯和伊尔玛是带头的。"
    },
    {
      "id": "p14043-cf9077913719",
      "target": "贝尔纳多不准他们赌，但显然没能拦住他们，因为他们不怎么聪明，所以才靠挥拳头打东西谋生。"
    },
    {
      "id": "p14044-db38d6ead0c4",
      "target": "我想，他们是晚上在守卫室里玩。"
    },
    {
      "id": "p14045-fbe1465fa622",
      "target": "<i>你</i>怎么对这事知道得这么清楚？"
    },
    {
      "id": "p14046-74b5b22f261e",
      "target": "挖出别人最不堪的一面，是我的独门本领。"
    },
    {
      "id": "p14047-2cf2b5c21dd3",
      "target": "霍拉旭，你知道守卫为什么觉得自己在贝尔纳多那里“处境危险”吗？"
    },
    {
      "id": "p14048-f0ea50e3befa",
      "target": "什么，<i>又来了？</i>"
    },
    {
      "id": "p14049-d19034f80198",
      "target": "伊尔玛又把他们那个小赌局张罗起来了。当然，是违背贝尔纳多意愿的。"
    },
    {
      "id": "p14050-c80d9d84cbc1",
      "target": "他们赌博的那些晚上，在守卫室里<i>根本没法</i>睡觉。我不得不蜷在马厩里睡，次数多得我都不愿承认。"
    },
    {
      "id": "p14051-d48fd1a56744",
      "target": "按理说，他们总该学会稍微收敛一点……可是……遗憾的是，他们不擅长这个。"
    }
  ]
}
