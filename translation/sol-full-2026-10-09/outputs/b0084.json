{
  "translations": [
    {
      "id": "p12168-6dae15b37276",
      "target": "陛下，请相信我。那绝不只是一个梦。感觉<i>太</i>真实了。我看见您浑身是血，心口有一道伤。"
    },
    {
      "id": "p12169-622c65a17ae1",
      "target": "杀死您的人是哈姆雷特。"
    },
    {
      "id": "p12170-84452bedc2e2",
      "target": "真要有人杀我，肯定就是他。"
    },
    {
      "id": "p12171-9886b15d1cfe",
      "target": "看来，就连家族以外的人，也注意到了我和年轻侄子之间的紧张关系。"
    },
    {
      "id": "p12172-85822b5b5ee8",
      "target": "撇开这些无足轻重的梦不谈，也许我该找他谈谈……"
    },
    {
      "id": "p12173-da26da804c1f",
      "target": "早就该谈了。"
    },
    {
      "id": "p12174-eac5443fb43b",
      "target": "那好。这就让我们<i>确定</i>，那只是个梦。"
    },
    {
      "id": "p12175-07cf76932e7f",
      "target": "哈姆雷特再也威胁不了任何人了。"
    },
    {
      "id": "p12176-827a50420302",
      "target": "噩……噩……噩梦？"
    },
    {
      "id": "p12177-cacd864241d2",
      "target": "被杀了……怎么被杀的？"
    },
    {
      "id": "p12178-fdfc2b4bcafa",
      "target": "我记不太清了。我看见……你的父亲，不知怎么的——已经去世的国王，却不知怎么还活着——然后大家就开始一个接一个地死去。"
    },
    {
      "id": "p12179-187a2fd58327",
      "target": "你、你看见了我父亲？"
    },
    {
      "id": "p12180-6261c1eb7161",
      "target": "没、没事了。不重要。你走吧。我需要……一个人待着。"
    },
    {
      "id": "p12181-830b8865d69e",
      "target": "所以，我们全都死了，是吗？"
    },
    {
      "id": "p12182-7dc429382647",
      "target": "也许那样对我们所有人都最好。"
    },
    {
      "id": "p12183-2d79aabbc760",
      "target": "就这样被抹去，仿佛我们从来没有存在过。"
    },
    {
      "id": "p12184-eb6486334e40",
      "target": "你和我都化为虚无，连尘埃都没留下，就这么消失了。"
    },
    {
      "id": "p12185-0c84f48cc9a7",
      "target": "我倒挺喜欢活着的。"
    },
    {
      "id": "p12186-e2f928cd7fec",
      "target": "好吧，那我们俩只有你这么想。"
    },
    {
      "id": "p12187-1ad32ffd596d",
      "target": "做噩梦了？听着真难受。亲爱的，真替你难过。"
    },
    {
      "id": "p12188-d90eb1d91918",
      "target": "幸好那只是个梦。"
    },
    {
      "id": "p12189-07bb1cc2e932",
      "target": "我……担心梦里有些事是真的，比我愿意相信的还多。感觉太真实了……"
    },
    {
      "id": "p12190-f7936ad728d7",
      "target": "噩梦往往都是这样，不是吗？"
    },
    {
      "id": "p12191-a2b7332dea31",
      "target": "你知道吗，我也一直在做……一些奇怪的梦。"
    },
    {
      "id": "p12192-0d5f8037d7d5",
      "target": "是什么样的梦，王后？"
    },
    {
      "id": "p12193-60564005437e",
      "target": "我……恐怕不方便说出来。我……只是……"
    },
    {
      "id": "p12194-eee674c6aaa3",
      "target": "我已经太常给可怜的伊尔玛添麻烦了。这些天晚上我都待在厨房里，仿佛又变回了小姑娘……"
    },
    {
      "id": "p12195-26128b7b58fa",
      "target": "恕、恕我先告辞了，奥菲莉娅……"
    },
    {
      "id": "p12196-5ce414121dc4",
      "target": "我做了个奇怪的噩梦，看见宫廷里的人都被杀了。可那感觉……像是真的。"
    },
    {
      "id": "p12197-944144238319",
      "target": "亲爱的，你做了噩梦，我也替你难过，可梦终究不会造成什么后果。"
    },
    {
      "id": "p12198-a3bfd43fec06",
      "target": "那……感觉像是我以前经历过这一切。我看见哈姆雷特用剑刺穿了您的身体！"
    },
    {
      "id": "p12199-137262b18aa7",
      "target": "您因为他的举止去暗中监视他，然后——然后——"
    },
    {
      "id": "p12200-6da82e449c6e",
      "target": "哦，不！绝不可能，绝不可能。他再怎么疯，哈姆雷特王子也绝不会伤害我。"
    },
    {
      "id": "p12201-403af7b0780a",
      "target": "就在今天早些时候，我还在画廊里跟他单独谈过话。如果他心怀恶意，难道不会当时就动手吗？"
    },
    {
      "id": "p12202-8ecf81725dd2",
      "target": "不过……我得承认，他的举止实在古怪。看起来毫无规律，可是……"
    },
    {
      "id": "p12203-e630bbd4bd11",
      "target": "其实，我正打算确保哈姆雷特不会伤害任何人。"
    },
    {
      "id": "p12204-6748730c9952",
      "target": "我打算一有空就去找他。这些天，他似乎总去那几个古怪的地方。"
    },
    {
      "id": "p12205-066ddb073439",
      "target": "亲爱的。哈姆雷特已经不在了。"
    },
    {
      "id": "p12206-2724a2e5a841",
      "target": "不管你梦见他做了什么，如今都不太重要了。"
    },
    {
      "id": "p12207-fb2682c0fa43",
      "target": "如今，他只能活在记忆里了。"
    },
    {
      "id": "p12208-481f9af6a821",
      "target": "怎么，你和我现在开始交流各自的梦了？"
    },
    {
      "id": "p12209-7d780cc087a2",
      "target": "只是那感觉太<i>真实了。</i>就像一段记忆。"
    },
    {
      "id": "p12210-fe98fd08a3b7",
      "target": "是那种你能控制梦中事情的梦吗？"
    },
    {
      "id": "p12211-fbf11d5c6435",
      "target": "我最近越来越常做这种梦了。有位学者曾教过我一些这方面的窍门。"
    },
    {
      "id": "p12212-0d371fa0635b",
      "target": "他说，如果每次穿鞋时都在心里想：‘我现在正在穿鞋。’那么久而久之，就能控制自己的梦。"
    },
    {
      "id": "p12213-e8134824c92b",
      "target": "这跟我们的记忆运作方式有关。"
    },
    {
      "id": "p12214-2283b233ce08",
      "target": "真有意思。不过，我想说的不太是这个。"
    },
    {
      "id": "p12215-de21c8ed2055",
      "target": "嗯。也许王后能体谅你，听你倾诉。陛下最近也一直受噩梦困扰。"
    },
    {
      "id": "p12216-02de1b952361",
      "target": "你也做噩梦啊？"
    },
    {
      "id": "p12217-f9421da34b5b",
      "target": "我梦见一只巨大的食人羊，它要杀了我。"
    },
    {
      "id": "p12218-70cdcfaaccdf",
      "target": "每天晚上，它都越逼越近……"
    },
    {
      "id": "p12219-370e3308d540",
      "target": "然后它就冲着我的脸叫！咩啊！咩啊！我还跑不掉！"
    },
    {
      "id": "p12220-b3b6578216ff",
      "target": "然后我才发现，那是我妈！"
    },
    {
      "id": "p12221-f96f8aeb3e30",
      "target": "……跟我想说的<i>不太</i>一样。谢谢你，马塞勒斯。"
    },
    {
      "id": "p12222-dc3125028ace",
      "target": "嗯，又不止你一个，菲莉。"
    },
    {
      "id": "p12223-7c25eaf49fb9",
      "target": "乔特鲁德最近也睡不好。"
    },
    {
      "id": "p12224-0c02f024a653",
      "target": "你不是应该称她为‘王后’吗？"
    },
    {
      "id": "p12225-c9ba1d187726",
      "target": "当值的时候才要，菲莉。"
    },
    {
      "id": "p12226-46d9a67f8e8e",
      "target": "总之，她睡着时一直出汗，还说些奇怪的话。我觉得她是在想她死去的丈夫。要我说，真够恶心的！"
    },
    {
      "id": "p12227-03bfb308f931",
      "target": "也许你们俩可以找个机会，一起哀悼。我听说那样能<i>大大</i>宣泄心里的情绪。"
    },
    {
      "id": "p12228-2b12b9f6b79f",
      "target": "我的噩梦感觉很真实。不像普通的梦。"
    },
    {
      "id": "p12229-445994ba79aa",
      "target": "那里面有<i>我</i>吗？我有没有做什么有趣或者了不起的事？你跟别人说自己的梦时，人家只关心这个。"
    },
    {
      "id": "p12230-81325939edf7",
      "target": "……没有。你的尸体……不在那些尸体里。可我还是知道……你……已经死了。"
    },
    {
      "id": "p12231-58e56b149975",
      "target": "……我……已经……死了？"
    },
    {
      "id": "p12232-b50a35651557",
      "target": "真是个乏味透顶的故事。别烦我了，菲莉。"
    },
    {
      "id": "p12233-47d99781a9a3",
      "target": "我还有地方要去。还有事要做。"
    },
    {
      "id": "p12234-d103cc7fb3d4",
      "target": "王后当时也睡不好。"
    },
    {
      "id": "p12235-7baf91eac7d4",
      "target": "现在回头看，也许当时就该把那当成警兆。"
    },
    {
      "id": "p12236-e3475d7803a3",
      "target": "你知道吗，乔特鲁德心里藏着很多阴暗的东西。但即便如此，她对我还是很好。"
    },
    {
      "id": "p12237-b52cdfe12d0a",
      "target": "别让黑暗吞噬你。"
    },
    {
      "id": "p12238-a307937bb198",
      "target": "总之，那些都过去了。而且我不会哀伤。以后都别再提了。"
    },
    {
      "id": "p12239-22472576c1d5",
      "target": "你也这样？"
    },
    {
      "id": "p12240-00666ab86784",
      "target": "您也一直在做噩梦吗？"
    },
    {
      "id": "p12241-1437faf6822c",
      "target": "没有！可王后，她总做噩梦。"
    },
    {
      "id": "p12242-f467f61c399b",
      "target": "昨晚我给她拿了一块凉布巾，让她平静下来。她当时吓坏了。"
    },
    {
      "id": "p12243-351be1452a63",
      "target": "她虽然长大了，可在我心里，她始终是我的小乔蒂。"
    },
    {
      "id": "p12244-e81593a3f74c",
      "target": "她几乎每晚都来看我，却从不告诉我，那些让她睡不安稳的血腥梦境里究竟有什么。"
    },
    {
      "id": "p12245-1b3edc1a8631",
      "target": "没有！可我的乔蒂王后，她去世前总做噩梦。"
    },
    {
      "id": "p12246-21fc39b27471",
      "target": "我很担心你，亲爱的。"
    },
    {
      "id": "p12247-47585ce2d91d",
      "target": "王后不会希望你走上她的老路。这一点，我很确定。"
    },
    {
      "id": "p12248-3e90808235c2",
      "target": "陛下，我确切知道，福丁布拉斯王子很快就会违背和平条约，发动入侵。"
    },
    {
      "id": "p12249-1b87133a4fb9",
      "target": "哈！国家大事，我凭什么听你的？"
    },
    {
      "id": "p12250-98667a88c994",
      "target": "您和我一样清楚，布莉特女士的家族一直在为挪威效力。还有谁可能也在这么做呢？"
    },
    {
      "id": "p12251-ff73401ea15a",
      "target": "陛下——如果您派一名使者到城墙外去，您就会发现——"
    },
    {
      "id": "p12252-5083d19808a1",
      "target": "<i>使者！</i>这位小姑娘竟然学会了战争用语。真有意思。"
    },
    {
      "id": "p12253-4420379cd599",
      "target": "你父亲已经把我的军务参谋工作做得十分出色了。我可不需要<i>两个</i>波洛涅斯在我耳边忧心忡忡地念叨。"
    },
    {
      "id": "p12254-fe20e92e13bc",
      "target": "这些大局谋划，就交给别人吧。少操点心。"
    },
    {
      "id": "p12255-375b31651f15",
      "target": "我……知道这很难相信，但警告我的人，是我毫无保留地信任的人。"
    },
    {
      "id": "p12256-4922f1b06bd8",
      "target": "平时我不会理会这种事。但你待我这么好，我也该回报你。"
    },
    {
      "id": "p12257-b536dbacdbf0",
      "target": "如果这件事多少有些属实……"
    },
    {
      "id": "p12258-507704b82128",
      "target": "要采取行动，我需要能证明他所在位置的<i>证据</i>。"
    },
    {
      "id": "p12259-5ed6c0e63c89",
      "target": "给你消息的人，能给我带来这样的证据吗？"
    },
    {
      "id": "p12260-407348fc3c06",
      "target": "我会尽力的，陛下。"
    },
    {
      "id": "p12261-adbe99883ccd",
      "target": "我得知福丁布拉斯王子打算违背我们的和平条约，发动入侵。"
    },
    {
      "id": "p12262-76c361d08ee8",
      "target": "唉，奥菲莉娅……我当然知道这完全有可能，可这不是我们能管的事。"
    },
    {
      "id": "p12263-755ec6c42471",
      "target": "亲爱的，这些事还是留给指挥军队的男人们吧。这件事已经有人在处理了。"
    },
    {
      "id": "p12264-a6684ff68ad5",
      "target": "我觉得没有。我们有没有考虑过，福丁布拉斯可能会暗中破坏——"
    },
    {
      "id": "p12265-5665e9094462",
      "target": "奥菲莉娅。我是皇帝的女儿。你以为我没考虑过吗？可谁会听我的——或者听你的？"
    },
    {
      "id": "p12266-01a9481a0d61",
      "target": "最好别让我丈夫心神不宁。他现在精神很脆弱。"
    },
    {
      "id": "p12267-3f5829165271",
      "target": "我知道福丁布拉斯王子很快就会违背条约，发动入侵。"
    },
    {
      "id": "p12268-ff198b0c9aa9",
      "target": "而且我知道，<i>你</i>也知道这件事。"
    },
    {
      "id": "p12269-0f8763a7329d",
      "target": "我们已经谈过这件事了。"
    },
    {
      "id": "p12270-18555dc2f2ab",
      "target": "我们很快再见。希望我还能信任你。我不太擅长这个。我是说，信任别人。"
    },
    {
      "id": "p12271-8c2ae9162f26",
      "target": "我不会揭发你的，布莉特。我<i>保证</i>。"
    },
    {
      "id": "p12272-e20a72003173",
      "target": "我们必须阻止他。"
    },
    {
      "id": "p12273-86c2fb97fed1",
      "target": "就算那是真的，你到底凭什么觉得<i>我</i>能做些什么？"
    },
    {
      "id": "p12274-643053a8f4c0",
      "target": "你有什么话想对我说吗？有话就说，别浪费我的时间。"
    },
    {
      "id": "p12275-3c194cb1ae2c",
      "target": "父亲，我确切知道，福丁布拉斯大人将会违背和平条约，发动入侵。"
    },
    {
      "id": "p12276-8585af7060dd",
      "target": "你当然知道。你是我的聪明孩子。我之前不确定你有没有注意到……但你能看出来，我也不意外。"
    },
    {
      "id": "p12277-974fe9164fd2",
      "target": "国王就是不肯听我的话！任何顾问的话他都不听——连贝尔纳多也不例外！"
    },
    {
      "id": "p12278-be5e43be0159",
      "target": "贝尔纳多和我已经劝了陛下<i>好几个星期</i>，告诉他政变就在眼前。可他就是不听。"
    },
    {
      "id": "p12279-0bc09870faa0",
      "target": "就连布莉特女士被揭穿是潜伏在我们城里的间谍之后，他还是这样，真是的！"
    },
    {
      "id": "p12280-9ca1972531dd",
      "target": "他一门心思只想着讨好丹麦贵族，炫耀武力，彰显自己的权威……"
    },
    {
      "id": "p12281-a20b318491a0",
      "target": "他太渴望得到认可，反而看不见我们的处境有多岌岌可危。"
    },
    {
      "id": "p12282-817e72d6ccbc",
      "target": "哈姆雷特国王<i>绝不会</i>犯下如此严重的误判，还一错就是这么久。"
    },
    {
      "id": "p12283-cb0daf81d132",
      "target": "父亲，既然您和我都知道福丁布拉斯会来攻打我们，难道我们不能做点什么吗？"
    },
    {
      "id": "p12284-319840c85671",
      "target": "……没有证据，就不行。"
    },
    {
      "id": "p12285-81372ae64e65",
      "target": "如果我们有确凿证据，证明福丁布拉斯所谓入侵波兰人的计划是在撒谎，也许就能说服克劳狄斯。"
    },
    {
      "id": "p12286-3b46c8856c9c",
      "target": "如今她效忠哪一方已经暴露了，如果贝尔纳多能从布莉特女士那里问出些什么……我们也许还有机会。"
    },
    {
      "id": "p12287-b81bd8c38d14",
      "target": "但我不确定，她究竟愿不愿意跟他说话。"
    },
    {
      "id": "p12288-aad99de5bcc7",
      "target": "可要做到这一点，我们得认识一个和挪威有联系的人——而埃尔西诺没有这样的人。"
    },
    {
      "id": "p12289-a455abea280b",
      "target": "……也许有呢。"
    },
    {
      "id": "p12290-6e7104ce1fdd",
      "target": "哦？克劳狄斯整天疑心间谍和叛国者，连你也受影响了？"
    },
    {
      "id": "p12291-46dc554389e1",
      "target": "可得当心，亲爱的。"
    },
    {
      "id": "p12292-777783c1492b",
      "target": "当时贝尔纳多和我劝了国王<i>好几个星期</i>，告诉他政变就在眼前。可他直到最后都不肯听。"
    },
    {
      "id": "p12293-c66ac13d4e3b",
      "target": "如果当时我们有确凿证据，证明福丁布拉斯所谓入侵波兰人的计划是在撒谎，也许就能说服克劳狄斯了。"
    },
    {
      "id": "p12294-708cbbfaa79e",
      "target": "我确切知道，福丁布拉斯大人将会违背和平条约，发动入侵。"
    },
    {
      "id": "p12295-ca3ca056416d",
      "target": "（看来我来得有点早。他还没听说过这件事。）"
    },
    {
      "id": "p12296-193fffa58634",
      "target": "算了。也许过些时候你就明白了。"
    },
    {
      "id": "p12297-28fded279d70",
      "target": "出去多晒晒太阳吧。别变得跟哈姆雷特一样。我至少得有一个神志正常的朋友。"
    },
    {
      "id": "p12298-d813013eefb3",
      "target": "奥菲莉娅。你简直像是<i>存心</i>要让我被撤职。"
    },
    {
      "id": "p12299-b2633b6f7db0",
      "target": "你说得对，我们都怀疑福丁布拉斯王子在违背他叔父的意愿。"
    },
    {
      "id": "p12300-63ebff758341",
      "target": "不过，如果没有有力证据，证明福丁布拉斯违背了不进入丹麦的约定……"
    },
    {
      "id": "p12301-52d277a96dbf",
      "target": "我们就什么依据也没有。"
    },
    {
      "id": "p12302-7010ed55633f",
      "target": "你找到可信的证人，愿意把自己知道的一切都交代出来了吗？"
    },
    {
      "id": "p12303-fd192fa2fee5",
      "target": "嗯。也许吧。"
    },
    {
      "id": "p12304-91060ba30996",
      "target": "如果你有这么有力的证据，那就说来听听。"
    },
    {
      "id": "p12305-82e999590b97",
      "target": "在那之前，出去多晒晒太阳吧。别变得跟哈姆雷特一样。我至少得有一个神志正常的朋友。"
    },
    {
      "id": "p12306-daf96c26d786",
      "target": "没……没有。还没有。"
    },
    {
      "id": "p12307-096badfb390b",
      "target": "但我会找到的。"
    },
    {
      "id": "p12308-17ea8c3f769c",
      "target": "好吧。好吧，奥菲莉娅。"
    },
    {
      "id": "p12309-466b4cfd7921",
      "target": "福丁布拉斯告诉国王，他打算借道丹麦去攻打波兰，对吧？"
    },
    {
      "id": "p12310-a08d0ffee7bc",
      "target": "他难道不是很有可能在<i>骗</i>我们，其实打算夺取埃尔西诺吗？毕竟，他父亲是被哈姆雷特国王杀死的……"
    },
    {
      "id": "p12311-3dfa01598190",
      "target": "是……是。有这种可能。但奥菲莉娅，我们生活在一个战乱不断的时代。这种可能始终都在。"
    },
    {
      "id": "p12312-5656e741c90d",
      "target": "眼下，丹麦需要盟友，而福丁布拉斯给了我们这个机会。除非有有力证据证明他另有所图，否则我们必须信任他。"
    },
    {
      "id": "p12313-f0f768595d66",
      "target": "我确切知道，福丁布拉斯王子将会发动入侵。"
    }
  ]
}
