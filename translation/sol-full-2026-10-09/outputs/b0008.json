{
  "translations": [
    {
      "id": "p00308-ad78e9843419",
      "target": "这只不太友好。有一次抓伤了我的手腕。"
    },
    {
      "id": "p00309-84c1f847cc86",
      "target": "哦，我很少见这只出来走动。它总是躲着。"
    },
    {
      "id": "p00310-b8fe1103caf7",
      "target": "这只长得壮实，过得也开心。伊尔玛一定很喜欢它。"
    },
    {
      "id": "p00311-c364983c0602",
      "target": "贝尔纳多和其他卫兵几乎已经收养了这只狗。"
    },
    {
      "id": "p00312-291aa4e4df4c",
      "target": "它似乎太爱在卫兵住处逗留了，总盼着能讨点剩饭。"
    },
    {
      "id": "p00313-274b6c1b7af4",
      "target": "好活泼的小狗。不知道是谁养的？"
    },
    {
      "id": "p00314-8bce33d5d952",
      "target": "这只猎犬几乎总在脚边碍事。"
    },
    {
      "id": "p00315-dd1e4ac651ca",
      "target": "它看起来满足极了。不知道又去刨了哪处花坛。"
    },
    {
      "id": "p00316-ce1748935790",
      "target": "你好呀，小猎犬！你刚才追野兔去了吗？"
    },
    {
      "id": "p00317-716079278bd7",
      "target": "哈姆雷特把光全遮住了。真幼稚。"
    },
    {
      "id": "p00318-a65f6b9ae8c8",
      "target": "要是想睡一会儿，我该回自己的房间。"
    },
    {
      "id": "p00319-66f5cbc2e503",
      "target": "要是想打个盹，我该回自己的房间。"
    },
    {
      "id": "p00320-5a5ff04714e7",
      "target": "王后就在这里让人梳理头发。这么大的镜子，做起来一定花了很长时间。"
    },
    {
      "id": "p00321-cbcad310bc5c",
      "target": "唉，雷欧提斯……你到底要这么多刀剑做什么？"
    },
    {
      "id": "p00322-42a506ebb032",
      "target": "即使离得这么远，埃尔西诺城堡看起来依然十分庞大。"
    },
    {
      "id": "p00323-a9cb1607d63f",
      "target": "看着可能很浅，其实深得很。"
    },
    {
      "id": "p00324-8a9c62944e80",
      "target": "我小时候常在这里玩。不过现在，穿着这么沉的裙子……还是离远点好。"
    },
    {
      "id": "p00325-7db4d2421723",
      "target": "听说这些雕像是在埃尔西诺上一次遭到围攻、重建之后雕成的。"
    },
    {
      "id": "p00326-63c82f07712a",
      "target": "这是丹麦的纹章。"
    },
    {
      "id": "p00327-57102db8a6e3",
      "target": "很晚了，我真该去睡了。"
    },
    {
      "id": "p00328-47d4f31e0327",
      "target": "我现在没理由去码头。"
    },
    {
      "id": "p00329-e4001901e0fd",
      "target": "那边通往东面，出去就是厄勒海峡。"
    },
    {
      "id": "p00330-f67e19d78af0",
      "target": "丹麦控制着这里的航道。所有过往船只都必须停下来，向我们缴纳通行税。"
    },
    {
      "id": "p00331-fa45b63fbd3a",
      "target": "丹麦皇家舰队就停泊在附近。这个港口水很浅，所以要用长艇往返岸边接送乘客。"
    },
    {
      "id": "p00332-e93052262238",
      "target": "这是一封盖着国王印玺的信。"
    },
    {
      "id": "p00333-c9501777e2b5",
      "target": "哈姆雷特现在正在看。我没法靠近。"
    },
    {
      "id": "p00334-8ab11b4c3b82",
      "target": "“我已将这些命令交托给罗森克兰兹和吉尔登斯吞这两位忠诚的仆人，以确保……”"
    },
    {
      "id": "p00335-fd1fe758c946",
      "target": "“……抵达后即刻处决。”"
    },
    {
      "id": "p00336-1f5e96c519ea",
      "target": "这是克劳狄斯写下的、处死哈姆雷特的命令。现在它再也不会送到英格兰了。"
    },
    {
      "id": "p00337-2ab1eba96a02",
      "target": "不过，我还是想知道……罗森克兰兹和吉尔登斯吞是不是有意带着这封信。"
    },
    {
      "id": "p00338-01e4267728ac",
      "target": "我猜各方都在骗人。"
    },
    {
      "id": "p00339-6c91c288e8de",
      "target": "那边通往马厩。里面除了成堆的粪便和母马，什么都没有。"
    },
    {
      "id": "p00340-23d1ad8d4363",
      "target": "那边通往田野。我能看见起伏的丘陵绵延数英里。不过，我没兴趣离开镇子。"
    },
    {
      "id": "p00341-bade1bcf3949",
      "target": "要是我会掌舵，就能去任何地方。"
    },
    {
      "id": "p00342-c05ccbee47bb",
      "target": "可就凭我现在的本事，大概只会落得沉到海底的下场。"
    },
    {
      "id": "p00343-5ac6599b036e",
      "target": "这里光线真暗。"
    },
    {
      "id": "p00344-5015ec0e9f3e",
      "target": "囚犯就在这里睡觉。或者……我猜，只能说试着睡着吧。"
    },
    {
      "id": "p00345-3b77992e94a8",
      "target": "刚才怎么——我们做了什么——"
    },
    {
      "id": "p00346-66675d5e9d23",
      "target": "他……死了吗？"
    },
    {
      "id": "p00347-6f2522305f3e",
      "target": "……好安静。"
    },
    {
      "id": "p00348-8d1f87948efe",
      "target": "这次哈姆雷特不在我房间里。肯定有什么变了。"
    },
    {
      "id": "p00349-16eda250d839",
      "target": "不知道父亲在不在外面。"
    },
    {
      "id": "p00350-6bea0a92fdf9",
      "target": "即使到了现在，我还是不喜欢这个地方。"
    },
    {
      "id": "p00351-707314b5fdc8",
      "target": "<i>别</i>以为你能骗过我，奥菲莉娅。"
    },
    {
      "id": "p00352-285d387e7733",
      "target": "明白了。还是和之前一样。你还在这里。"
    },
    {
      "id": "p00353-b5e10fb7f8ea",
      "target": "还在这里？我正想对<i>你</i>说这话呢！"
    },
    {
      "id": "p00354-43fad643acad",
      "target": "你要错过宴会了。其他人都已经在大厅里了。"
    },
    {
      "id": "p00355-e7f6db3363ec",
      "target": "你哥哥提议让你继续睡……不过，看你精神饱满，也准备好了，我很高兴。"
    },
    {
      "id": "p00356-aba17c920d86",
      "target": "准备好了就下楼来，好吗？"
    },
    {
      "id": "p00357-91c063b961c8",
      "target": "怎么回事？"
    },
    {
      "id": "p00358-ca9299efee88",
      "target": "这一切都和以前不一样。"
    },
    {
      "id": "p00359-7cd823425946",
      "target": "有……不可能。这一定又是个骗局。"
    },
    {
      "id": "p00360-39d9eede4e5b",
      "target": "我的好女儿来了。"
    },
    {
      "id": "p00361-04eea739bc4d",
      "target": "我这懒妹妹，你终于醒了？"
    },
    {
      "id": "p00362-208359515ad1",
      "target": "奥菲莉娅！哦——哦——奥菲莉娅！……"
    },
    {
      "id": "p00363-9e4ea4b746c0",
      "target": "呃，请你别介意母亲这样。"
    },
    {
      "id": "p00364-40c214a4c3c9",
      "target": "等你醒来的时候，我们都喝得……有点多了。酒都摆出来好几个小时了。"
    },
    {
      "id": "p00365-fc8f07f10b7f",
      "target": "我好<i>开——心！</i>我最喜欢丰盛的夏日宴席了。"
    },
    {
      "id": "p00366-196a04ce6b79",
      "target": "亲爱的，现在<i>总算</i>可以开始了吧？"
    },
    {
      "id": "p00367-5cd528e781de",
      "target": "我知道你想等奥菲莉娅。好了，她来了。别让饭菜凉了。"
    },
    {
      "id": "p00368-bc85d08dc88d",
      "target": "求你们了。我都快饿死了。没多久可活了。"
    },
    {
      "id": "p00369-7c12fb636872",
      "target": "吉尔达，我们<i>刚</i>吃过甜点——还不到一个小时呢。"
    },
    {
      "id": "p00370-963e0d7d4812",
      "target": "可你看见桌上的菜了吗？伊尔玛这次比以往做得都好。我一秒也等不了了！我要死了！"
    },
    {
      "id": "p00371-6eb506352753",
      "target": "终于有人这么爱吃我做的饭，就像我爱做饭一样。"
    },
    {
      "id": "p00372-1c9974184912",
      "target": "你们在开宴会？那早上的朝会呢？福丁布拉斯呢？"
    },
    {
      "id": "p00373-1bc2c6e7bf97",
      "target": "福丁布拉斯？你是说挪威王子？"
    },
    {
      "id": "p00374-5b7850ad3ec5",
      "target": "他怎么了，奥菲莉娅？"
    },
    {
      "id": "p00375-30daaac54bec",
      "target": "他……就是，那个……外交交涉。他不是……他不是在威胁丹麦吗？"
    },
    {
      "id": "p00376-fd84a0d2131f",
      "target": "什么？陛下，是有什么事我不知道吗？"
    },
    {
      "id": "p00377-ff41182f9309",
      "target": "我想没有。我不太明白你的意思，奥菲莉娅。不过我倒是注意到，你手里还没拿酒杯。嗯！"
    },
    {
      "id": "p00378-2112ee8cbaa8",
      "target": "来吧！喝酒！尽情欢乐！<i>这</i>可是国王的命令。"
    },
    {
      "id": "p00379-35c643922e3f",
      "target": "呃，母亲，要送您上床睡觉吗？您都快睡着了。"
    },
    {
      "id": "p00380-8f1725c4cb81",
      "target": "别管她，哈姆雷特。她想睡就让她睡吧。晚些时候她会醒的。"
    },
    {
      "id": "p00381-fab81f7ab481",
      "target": "殿下，我会照看她。她醒了我就叫您！呃，前提是我自己没喝醉。"
    },
    {
      "id": "p00382-82712b41a43d",
      "target": "叔叔，她今晚看起来特别开心，不是吗？自从……嗯，那之后，就没这么开心过。"
    },
    {
      "id": "p00383-3bc501897d15",
      "target": "自从父亲因病去世之后。"
    },
    {
      "id": "p00384-7f98b3179ef0",
      "target": "是啊，确实。"
    },
    {
      "id": "p00385-28ff5e17e757",
      "target": "要是他的身体没有恶化得那么快就好了。我爱我的哥哥。我希望他活着。为了她，也为了你。"
    },
    {
      "id": "p00386-9e8010bce6eb",
      "target": "这不是您的错。当时谁也无能为力。瘟疫夺人性命，从不挑人。"
    },
    {
      "id": "p00387-b5016d8906ec",
      "target": "我父亲是个好人。而您——如今我身边的人里，您与他最亲近。慢慢地，一切都会好起来。"
    },
    {
      "id": "p00388-471a1550e4ae",
      "target": "为这话干一杯，我的侄儿。"
    },
    {
      "id": "p00389-7482aa3b9349",
      "target": "（这太奇怪了。难道连历史本身都变了？）"
    },
    {
      "id": "p00390-08754d71ddce",
      "target": "（至少，在这个世界里，克劳狄斯不是凶手……）"
    },
    {
      "id": "p00391-3a5d4a243d74",
      "target": "雷欧提斯。你不是要坐船去巴黎吗？"
    },
    {
      "id": "p00392-a4d66ccdac95",
      "target": "哦！说到这个。不知为什么，我昨晚睡不着，就想了想这件事。"
    },
    {
      "id": "p00393-074da2f4ed77",
      "target": "我想，我还是在埃尔西诺多待一阵吧。以后有的是时间去旅行。"
    },
    {
      "id": "p00394-64d9b91680c8",
      "target": "毕竟，丹麦能有几次这样阳光明媚、温暖的夏天呢？"
    },
    {
      "id": "p00395-8e4f748e7970",
      "target": "那太好了。布莉特肯定也会很高兴。"
    },
    {
      "id": "p00396-c291d5b327fd",
      "target": "因为他留下来而高兴？我想，这也不算<i>最坏的事</i>吧。"
    },
    {
      "id": "p00397-33f34caec40a",
      "target": "（听着，奥菲莉娅。这事只告诉你，今晚我打算准备一个小惊喜。）"
    },
    {
      "id": "p00398-96d1b5e68240",
      "target": "（等着瞧吧。）"
    },
    {
      "id": "p00399-8973db81737f",
      "target": "来，奥菲莉娅。我带你入座。我们用餐吧？"
    },
    {
      "id": "p00400-404cba15a4ac",
      "target": "当然。"
    },
    {
      "id": "p00401-90fd75549068",
      "target": "各位，我想敬一杯酒。"
    },
    {
      "id": "p00402-a49e346a6d38",
      "target": "好啊，好啊！"
    },
    {
      "id": "p00403-12a460c7f468",
      "target": "当然，雷欧提斯。"
    },
    {
      "id": "p00404-2eea4c12ea16",
      "target": "我想为健康、生命和爱情举杯。"
    },
    {
      "id": "p00405-05a85f03f7a4",
      "target": "也敬这位聪慧、美好的女子——我爱她，她也爱着我。"
    },
    {
      "id": "p00406-75d5e06630ac",
      "target": "啊？<i>我？</i>"
    },
    {
      "id": "p00407-aad5a7d7d482",
      "target": "有些人早就知道我们的关系。对另一些人来说，这可能——呃——更像是个意外。"
    },
    {
      "id": "p00408-41bcad8e05d1",
      "target": "<i>我</i>可太意外了。"
    },
    {
      "id": "p00409-d1d004a437e9",
      "target": "为什么我以前从没听说过这件事？"
    },
    {
      "id": "p00410-178a55df904e",
      "target": "雷欧提斯，你不必这样。"
    },
    {
      "id": "p00411-3d6d3331cb90",
      "target": "今晚，我想向比尔吉塔女士求婚。"
    },
    {
      "id": "p00412-2196a48dfd1f",
      "target": "啊！好哇！<i>好哇！</i>"
    },
    {
      "id": "p00413-aa6a0d68ca59",
      "target": "哎呀，真没想到。他可算是开口了。"
    },
    {
      "id": "p00414-f76d55ddeaf2",
      "target": "<i>雷欧提斯！</i>这太不合规矩了！"
    },
    {
      "id": "p00415-139e3facb72b",
      "target": "哎，父亲，别这样。他们很般配，身份地位也相称。"
    },
    {
      "id": "p00416-a2ae75f821ac",
      "target": "您有什么好担心的？"
    },
    {
      "id": "p00417-71f9f239f57e",
      "target": "这、这个，没什么，可我——我还没见过她父亲，也没跟他说过话，更没问过他的意见，还有——"
    },
    {
      "id": "p00418-f2c96413ba84",
      "target": "还有，嗯，嫁妆，还有……"
    },
    {
      "id": "p00419-a1a2a82cc0ea",
      "target": "布莉特，我爱你。我不想独自去周游世界。"
    },
    {
      "id": "p00420-6248413c456e",
      "target": "如果你也有哪怕一点同样的感情……如果你觉得你愿意……与我共度一生……"
    },
    {
      "id": "p00421-91d84fb5bc56",
      "target": "我答应，你这个笨蛋。当然答应。不过，你也不用这么<i>当众</i>说出来。"
    },
    {
      "id": "p00422-3c1b1b9919e4",
      "target": "那你怎么不干脆把他们全请进我们的卧室呢？"
    },
    {
      "id": "p00423-d475eba5b68c",
      "target": "哼。那好吧。真心相契的结合，我不该横加阻挠。"
    },
    {
      "id": "p00424-b432ab168ae6",
      "target": "如果这是你们的心愿，那么……"
    },
    {
      "id": "p00425-41f5ff55a8e9",
      "target": "我们要办婚礼了！"
    },
    {
      "id": "p00426-dc2778300760",
      "target": "恭喜你，哥哥。看到<i>你</i>开心，我也很开心。"
    },
    {
      "id": "p00427-cc4f19e63b9c",
      "target": "说实话，我松了口气。我之前不确定你和父亲听到这消息会有什么反应。"
    },
    {
      "id": "p00428-cb4d5ff6fc60",
      "target": "别让今晚就这么结束吧。"
    },
    {
      "id": "p00429-bf26d3489b33",
      "target": "我已经和贝尔纳多、哈姆雷特说好了。一有机会溜走，我们三个就到池塘边碰面。"
    },
    {
      "id": "p00430-fbabe23a5f7e",
      "target": "你想溜走？可大家都还在这里呢。"
    },
    {
      "id": "p00431-19b785b08485",
      "target": "哦，这场庆祝是挺好，可这群醉醺醺的人闹个不停，我也受不了太久。"
    },
    {
      "id": "p00432-0ce15f081199",
      "target": "安静点的地方更合心意。你也来吧。我们四个好久没聚在一起了。"
    },
    {
      "id": "p00433-4abb0443799e",
      "target": "好。我……我很想去。"
    },
    {
      "id": "p00434-ed209094a345",
      "target": "我会去的。"
    },
    {
      "id": "p00435-7c845fb12ba7",
      "target": "就是这样了。"
    },
    {
      "id": "p00436-09053bda6c53",
      "target": "他不在了。我简直不敢相信。一切都成了本该有的样子。"
    },
    {
      "id": "p00437-ef7af777d7e7",
      "target": "看来今晚我回房间时，得走得摇摇晃晃了。"
    },
    {
      "id": "p00438-ba6108fa4dc6",
      "target": "那也是应该的。今晚值得庆祝。"
    },
    {
      "id": "p00439-bae4d156c9e0",
      "target": "也值得为布莉特挑男人的眼光寿终正寝喝上一杯。"
    },
    {
      "id": "p00440-e3e123232506",
      "target": "你只是因为她不喜欢<i>你</i>，才这么不高兴。"
    },
    {
      "id": "p00441-85e0312eef15",
      "target": "没关系。我早已习惯了那种爱而不得的感觉。"
    },
    {
      "id": "p00442-67c0ce75f838",
      "target": "不过，对象不是她。"
    },
    {
      "id": "p00443-6fb96d64ec91",
      "target": "我们四个已经好久没像这样待在这里了。"
    },
    {
      "id": "p00444-9afb49a95b38",
      "target": "太久了。为什么我们再也不这样<i>开心地玩</i>了？难道长大后就忘了怎么玩吗？"
    },
    {
      "id": "p00445-809e2b90e930",
      "target": "我想是吧。"
    },
    {
      "id": "p00446-cfc03c00bac1",
      "target": "要我说，长大的是<i>你们</i>三个。我可一直没怎么长个子。"
    },
    {
      "id": "p00447-b751853f25ef",
      "target": "抱歉，小不点。"
    },
    {
      "id": "p00448-71a101cfa5d4",
      "target": "我讨厌这个外号。"
    },
    {
      "id": "p00449-378ee0a1361f",
      "target": "我记得，这外号是你哥哥给你起的。我只是拿来用用。"
    },
    {
      "id": "p00450-9edc82b5e240",
      "target": "就是他叫我“食人魔”的那个夏天。那段日子，我们谁都不好过。"
    },
    {
      "id": "p00451-bd41dbe458b5",
      "target": "谁让我这么擅长起名字呢，我也没办法。"
    },
    {
      "id": "p00452-cc13ef85c889",
      "target": "我爱你们每一个人。"
    },
    {
      "id": "p00453-290e104abe85",
      "target": "我一直——这些日子——我看着你们死了那么多次。"
    },
    {
      "id": "p00454-22ca0d5081bb",
      "target": "我不知道还能怎么办。我好害怕。好绝望。"
    },
    {
      "id": "p00455-ee52ef2835a3",
      "target": "但我终于把它解决了。我一直坚持着。我每一步都做对了。我把一切都解决了。现在你们就在这里。"
    },
    {
      "id": "p00456-bfd1736281f6",
      "target": "一切又好了。"
    },
    {
      "id": "p00457-c06e64248be5",
      "target": "奥菲莉娅？你还好吗？"
    },
    {
      "id": "p00458-80ff6ac64c0f",
      "target": "她看起来快睡着了。说的话也没头没脑的。"
    },
    {
      "id": "p00459-d5b30bee66aa",
      "target": "我可以送她回房间。"
    },
    {
      "id": "p00460-617092a38aac",
      "target": "不，不……让她待着吧。她喜欢待在池塘边。今晚暖和，又是满月。她会没事的。"
    },
    {
      "id": "p00461-6e7fa906dc52",
      "target": "你们知道，自从城堡开始服丧，这里的感觉就不一样了。"
    },
    {
      "id": "p00462-0d051ab9ef66",
      "target": "我也这么觉得。一切都笼罩着一层沉重的阴影。我相信奥菲莉娅说的就是这个。"
    },
    {
      "id": "p00463-6b40f6bdb230",
      "target": "但今天，我第一次觉得，那段日子也许就要过去了。"
    },
    {
      "id": "p00464-e9705e963f69",
      "target": "也许一切又会好起来。"
    },
    {
      "id": "p00465-8770ff094b8a",
      "target": "贝尔纳多，我自己也开始这么想了。"
    },
    {
      "id": "p00466-71fc8723d23b",
      "target": "我还要为这再干一杯。我们去找点酒吧？"
    },
    {
      "id": "p00467-b4b712bd13ef",
      "target": "好主意。再拿些纸牌。"
    },
    {
      "id": "p00468-05a0ca3788ad",
      "target": "晚安，奥菲莉娅。"
    },
    {
      "id": "p00469-d5c1d213911f",
      "target": "做个好梦。"
    },
    {
      "id": "p00470-ca9e8bd76b1a",
      "target": "哦。只剩我一个人了。"
    },
    {
      "id": "p00471-94a6a525de9b",
      "target": "我一定是睡着了。"
    },
    {
      "id": "p00472-69262541d376",
      "target": "不知道其他人是不是还在打牌。"
    },
    {
      "id": "p00473-f33622461190",
      "target": "那是布莉特吗？"
    },
    {
      "id": "p00474-16489704a207",
      "target": "她就这么昏过去了。还偏偏倒在泥地里。"
    },
    {
      "id": "p00475-06b401093f5c",
      "target": "布莉特！醒醒。"
    },
    {
      "id": "p00476-b14ab95f61bd",
      "target": "她身上是冷的。"
    },
    {
      "id": "p00477-485299a642ae",
      "target": "不。不可能。"
    },
    {
      "id": "p00478-9a8d46247d6c",
      "target": "不可能……"
    },
    {
      "id": "p00479-9e83197deb6f",
      "target": "那是——欢呼声？"
    },
    {
      "id": "p00480-71eefb27b3eb",
      "target": "再来一场！再来一场！"
    },
    {
      "id": "p00481-74147e89c474",
      "target": "对，请继续！别让观众等着！"
    },
    {
      "id": "p00482-c7f12d84c351",
      "target": "这场演出我以前看过，可还是<i>忍不住</i>要再从头到尾看一遍。"
    },
    {
      "id": "p00483-6aa1a35d27f4",
      "target": "这出戏我没参与编写，所以得承认，连<i>我</i>也不知道结局。"
    },
    {
      "id": "p00484-5f555331a9d3",
      "target": "看！她来了！"
    },
    {
      "id": "p00485-dda9907aeb28",
      "target": "快，停下！"
    },
    {
      "id": "p00486-cf431243d1c7",
      "target": "其他人，在外面。他们全都死了。"
    },
    {
      "id": "p00487-4fae94ea38fd",
      "target": "得有人去查看一下。国王陛下。王后陛下。求求你们。"
    },
    {
      "id": "p00488-dbfd686ef78d",
      "target": "什么？哦，是啊，他们的事我们都知道。先别管了。"
    },
    {
      "id": "p00489-182a472ad230",
      "target": "是啊，亲爱的，别管他们了。乌鸦迟早会去吃他们的。或者狗。"
    },
    {
      "id": "p00490-ac10f7fbb15c",
      "target": "现在上台去，姑娘。"
    },
    {
      "id": "p00491-f101c50e2342",
      "target": "奥菲莉娅，我真为你骄傲。要是你母亲也能在这里看着你就好了。"
    },
    {
      "id": "p00492-75eb91be9536",
      "target": "我、我？上台？"
    }
  ]
}
