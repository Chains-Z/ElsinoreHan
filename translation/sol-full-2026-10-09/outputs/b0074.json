{
  "translations": [
    {
      "id": "p10660-1a572925690d",
      "target": "明天走之前，我大概见不到你了。不过……"
    },
    {
      "id": "p10661-887da7048ecf",
      "target": "儿子，你应该还有些事要处理吧？"
    },
    {
      "id": "p10662-356eb5f06605",
      "target": "毕竟，你的船明天早上就开了。你没多少时间磨蹭了。"
    },
    {
      "id": "p10663-8f836e744fc5",
      "target": "您说得对。我又跟往常一样，到了出发前一晚，还什么都没收拾。"
    },
    {
      "id": "p10664-5f0b054a8bc7",
      "target": "还是往箱子里塞几件我最好的紧身上衣，然后就睡吧。"
    },
    {
      "id": "p10665-fee6d68d7919",
      "target": "好好睡一觉吧。你得养足精神。"
    },
    {
      "id": "p10666-45c3690c5311",
      "target": "你哥哥对你说的那些关于哈姆雷特王子的话，我都听到了。"
    },
    {
      "id": "p10667-ac0fb9f15dfa",
      "target": "他说得对。对你这样的年轻姑娘来说，哈姆雷特王子就是毒药。"
    },
    {
      "id": "p10668-75153aaadab2",
      "target": "况且，他迟早要继承王位。这件事可不好处理。"
    },
    {
      "id": "p10669-81d7bbb06a04",
      "target": "我知道你曾经爱过他。我是你父亲，这些事我看得出来。"
    },
    {
      "id": "p10670-dae9b49cecb4",
      "target": "我知道，我不该再跟他来往了。"
    },
    {
      "id": "p10671-e1e07cf8cb99",
      "target": "换作别的年轻贵族姑娘，事情或许会不同。但你不一样。"
    },
    {
      "id": "p10672-f2ce4f73b91a",
      "target": "这些事对你和雷欧提斯来说，要更难一些。"
    },
    {
      "id": "p10673-6ace6ff3fa03",
      "target": "我<i>很</i>清楚，父亲。我们<i>两个</i>都清楚。"
    },
    {
      "id": "p10674-2b37f3d10684",
      "target": "可我不是洗碗的女仆。我不会任人逼着我躲开他。"
    },
    {
      "id": "p10675-e69c007849d7",
      "target": "不。不，我绝不会要求你那样做。我只是希望你平安。"
    },
    {
      "id": "p10676-12f5f25df577",
      "target": "当然。我明白，父亲。"
    },
    {
      "id": "p10677-ae485decec18",
      "target": "聪明的姑娘。做个好梦。"
    },
    {
      "id": "p10678-24ba74594773",
      "target": "很晚了。我真该睡了。"
    },
    {
      "id": "p10679-08971bbae050",
      "target": "我想给你几句老人的忠告，尽管在年轻人看来，这些话可能没多少价值。"
    },
    {
      "id": "p10680-379e2035a7dc",
      "target": "雷欧提斯，对你这样的年轻人来说，巴黎可能是个……是个……让人<i>迷失</i>的地方。"
    },
    {
      "id": "p10681-8034283249bb",
      "target": "儿子，有些规矩要守。"
    },
    {
      "id": "p10682-18dc39508795",
      "target": "记住，既不向人借钱，也不借钱给人。"
    },
    {
      "id": "p10683-d4c65fd6530a",
      "target": "即便是个好人，最终也会被债务拖垮。"
    },
    {
      "id": "p10684-c098d100963b",
      "target": "待人友善，但别过分亲近。"
    },
    {
      "id": "p10685-53a338d2a2d5",
      "target": "对每个人都要以礼相待，才配得上你贵族出身的身份。"
    },
    {
      "id": "p10686-264e8fed08c6",
      "target": "别跟人打架。可要是打了——凭上帝的圣血，一定要赢！"
    },
    {
      "id": "p10687-9245d50382b4",
      "target": "你毕竟是我儿子，那些决斗课可不是白上的！"
    },
    {
      "id": "p10688-222f2394493f",
      "target": "还有——别忘了衣着。"
    },
    {
      "id": "p10689-3b3a5471486c",
      "target": "人靠衣装，法国人都这么说。哪儿都这么说！"
    },
    {
      "id": "p10690-0ec22fc6dfd4",
      "target": "仆人们已经把我的箱子塞得满满的，里面都是最好的——"
    },
    {
      "id": "p10691-062e3e664540",
      "target": "最好再雇个法国裁缝，才保险！"
    },
    {
      "id": "p10692-08eb0ffb48d5",
      "target": "我可不许我儿子像个穷光蛋似的，穿着过时的衣服。"
    },
    {
      "id": "p10693-37366eccea5b",
      "target": "最后，儿子……最要紧的是，忠于你自己的本性。"
    },
    {
      "id": "p10694-0001b6489084",
      "target": "如果你忠于自己，那么，就像白昼过后必有黑夜……"
    },
    {
      "id": "p10695-024733758c1a",
      "target": "……你也必然不会以虚假的面目对待任何人。"
    },
    {
      "id": "p10696-fe6aff9ccc02",
      "target": "儿子，我能给你的忠告就这些了。"
    },
    {
      "id": "p10697-433d28cc8a9c",
      "target": "我会尽量记住……这些话。"
    },
    {
      "id": "p10698-9f98d61f979c",
      "target": "那孩子铁了心要恨我。"
    },
    {
      "id": "p10699-44e8c468905c",
      "target": "亲爱的，他还看不透青春这层面纱背后的世界。"
    },
    {
      "id": "p10700-0fbaddbd1ba2",
      "target": "哈姆雷特……他心里……有那么深的阴暗。"
    },
    {
      "id": "p10701-79a4aac1bbe7",
      "target": "我怕要是让他离开我们，那份阴暗会继续恶化。"
    },
    {
      "id": "p10702-b80e97b8a908",
      "target": "而恶化下去会变成什么样……那才更让我害怕。"
    },
    {
      "id": "p10703-9a49a9bd10f4",
      "target": "你没有亏待他。我向你保证。"
    },
    {
      "id": "p10704-e4986c8af91b",
      "target": "王后看起来正忙。我们先等等吧。"
    },
    {
      "id": "p10705-2c191eb55072",
      "target": "也许<i>你</i>该等着，可<i>我</i>是她的侍女，出身布罗肯胡斯家族。我想什么时候见她，她就能见我。"
    },
    {
      "id": "p10706-d37c316a5bc9",
      "target": "哈！你以为凭你的姓氏，就能在这里有权有势？脸蛋漂亮，心灵丑陋。你也就这样了。"
    },
    {
      "id": "p10707-5a1b76bab050",
      "target": "而你就是个老巫婆，除了盯着王后的私生活，也该找点别的爱好了。"
    },
    {
      "id": "p10708-1428ffada1c5",
      "target": "王后还只有我这两只手那么大时，我就给她<i>洗澡</i>，给她喂奶。她就像我的亲骨肉。"
    },
    {
      "id": "p10709-0b678e0d15d5",
      "target": "我会一直照看她，直到你们把我埋进土里。记住我的话，布莉特女士。"
    },
    {
      "id": "p10710-c3dc7c18269e",
      "target": "任何侍女、任何漂亮的丝绸裙子，都取代不了这份情谊。"
    },
    {
      "id": "p10711-b9ecc5dd368b",
      "target": "哼。走着瞧，老巫婆。"
    },
    {
      "id": "p10712-19de11b67292",
      "target": "你……你跟国王说了什么？"
    },
    {
      "id": "p10713-b0f529aecbd6",
      "target": "当然还什么都没说。"
    },
    {
      "id": "p10714-535d0dc96616",
      "target": "奥菲莉娅先前问了我一些问题。"
    },
    {
      "id": "p10715-1be914fa25bd",
      "target": "怎么，你当时浑身发抖，连腿都打颤了？"
    },
    {
      "id": "p10716-e99e3ad3ee5b",
      "target": "没、没有！当然没有！那姑娘就是特别敏锐……"
    },
    {
      "id": "p10717-fc068fe1eba8",
      "target": "我们只能等哈姆雷特发话。"
    },
    {
      "id": "p10718-3eec7da8f62e",
      "target": "在那之前，我们只能等着、守着，盼着<i>它</i>别再回来。"
    },
    {
      "id": "p10719-c0723e9dbf6b",
      "target": "要是我能就此消融……要是死能那么容易……"
    },
    {
      "id": "p10720-adbacd86f349",
      "target": "上帝，连那样你也要跟我作对吗？你会的，对不对？"
    },
    {
      "id": "p10721-e0cf28e02648",
      "target": "明明在这个乏味、疲惫的世界里，你带给我的只有苦难。"
    },
    {
      "id": "p10722-d1e8c82e180d",
      "target": "这座城堡就像荒草丛生的花园。我多么厌恶它。"
    },
    {
      "id": "p10723-89722fe95deb",
      "target": "哈姆雷特……平静些。换个角度想想，今晚我们会举杯祝你健康。"
    },
    {
      "id": "p10724-b3520744d73f",
      "target": "我，还有其他卫兵。我们会喝个酩酊大醉。怎么样？"
    },
    {
      "id": "p10725-37e6bca3a111",
      "target": "父亲给了她……她想要的一切。他的一切。我从没见过那样的爱。我也从没那样<i>爱过</i>。"
    },
    {
      "id": "p10726-d7dc0d499e75",
      "target": "可转眼间，父亲死了，还不到一个月，她就要嫁给我的<i>叔叔</i>。"
    },
    {
      "id": "p10727-cc4ea9a5553a",
      "target": "她的眼泪还没流完，就跟他睡到一张床上了。"
    },
    {
      "id": "p10728-1fa23f3c1f46",
      "target": "她必须往前走，哈姆雷特。她是王后，没有沉溺于悲伤的余地。而且，你叔叔也是合适的对象。"
    },
    {
      "id": "p10729-58c9e5a2830a",
      "target": "行了，闭嘴吧，霍拉旭。"
    },
    {
      "id": "p10730-3908a83810df",
      "target": "脆弱与女人，本就是一回事。"
    },
    {
      "id": "p10731-55c926cc4f3f",
      "target": "来吧，哈姆雷特。别坐在地上了，起来。我们送你去睡，好吗？"
    },
    {
      "id": "p10732-2e32bdd3c649",
      "target": "主啊，你还记得我父亲吗？记得他有多么……爱她吗？"
    },
    {
      "id": "p10733-61e8a629aa7f",
      "target": "她想要什么，他就给什么。他把一切都给了她。我从没见过那样的爱。我也从没那样<i>爱过</i>。"
    },
    {
      "id": "p10734-cb4b2f8eebd9",
      "target": "……可她随后就嫁给了<i>他。</i>父亲死后还不到一个月。"
    },
    {
      "id": "p10735-668bfa4446d6",
      "target": "可我只是个喝醉的蠢货。我懂什么，上帝？嗯？我懂什么？"
    },
    {
      "id": "p10736-089ac0f6923e",
      "target": "哈姆雷特，你看起来心情糟透了——比你平时还糟。"
    },
    {
      "id": "p10737-1b619fd56293",
      "target": "刚才确实是。可现在不是了。"
    },
    {
      "id": "p10738-a14b9602d5bb",
      "target": "我从没想过还能重新找回这样的快乐。我以为自己再也做不到了。"
    },
    {
      "id": "p10739-374d8a1a625f",
      "target": "好事就要降临到我们身上了，奥菲莉娅。"
    },
    {
      "id": "p10740-cc33b2cfa93b",
      "target": "现在，我的目的已清晰，目标已找准。"
    },
    {
      "id": "p10741-cd406f7473e2",
      "target": "我仍能看见父亲的亡魂，浑身染着血。"
    },
    {
      "id": "p10742-9027e0cd6b14",
      "target": "我没法把他——把它——从脑子里赶出去……我能感觉到，它像一根烧红的钉子，正往我的头骨里钻……"
    },
    {
      "id": "p10743-7cd68bbf6435",
      "target": "我只想一个人待着。远离所有人。远离你。"
    },
    {
      "id": "p10744-16539c92ebff",
      "target": "离开我。你看到的那些，都是一场错误。"
    },
    {
      "id": "p10745-d8c127179d02",
      "target": "我……我当时病了，神志不清，而且……我什么都没看见。不，我当然没看见……我怎么可能看见？那怎么可能是真的？"
    },
    {
      "id": "p10746-e59e4f140977",
      "target": "别说傻话。我了解你。你平时不是这样的。"
    },
    {
      "id": "p10747-c91bb0b8b3d1",
      "target": "别说了。就——别说了。让我一个人待着！我得想一想。我现在什么都搞不清了……"
    },
    {
      "id": "p10748-c160f0090129",
      "target": "离我远点。别再回来。"
    },
    {
      "id": "p10749-633bf356fe1b",
      "target": "上次我们吵架时，你说得很清楚，你心里没有对我的爱。"
    },
    {
      "id": "p10750-024657b04ce0",
      "target": "我正尽全力尊重你的心意。我真的在努力。"
    },
    {
      "id": "p10751-cefdb4bb07f8",
      "target": "哈姆雷特王子的举止古怪极了。"
    },
    {
      "id": "p10752-99be8ff17a37",
      "target": "他会这样也很正常，不是吗？他见过些什么，你难道不<i>知道</i>？"
    },
    {
      "id": "p10753-031e350278d7",
      "target": "你是说，他父亲的亡魂？"
    },
    {
      "id": "p10754-6528f632f208",
      "target": "沿着<i>那条</i>线索追下去，你说不定会跟我一位亲爱的老朋友面对面。"
    },
    {
      "id": "p10755-fa318b623170",
      "target": "我已经亲自见过哈姆雷特国王了。"
    },
    {
      "id": "p10756-92f97b2ea8fb",
      "target": "哎呀，那就不用替你们介绍了！瞧瞧你，真是个能干的孩子。"
    },
    {
      "id": "p10757-441b5c5694f3",
      "target": "你什么意思？哈姆雷特“见过”什么？"
    },
    {
      "id": "p10758-d004c356de2d",
      "target": "嗯。我一位亲爱的老朋友。"
    },
    {
      "id": "p10759-cfeefc483af6",
      "target": "要是<i>我</i>处在你的位置，或许会考虑问问哈姆雷特，他那点小毛病究竟是怎么回事。"
    },
    {
      "id": "p10760-4c577f17d94c",
      "target": "毕竟，遇到这种事，直截了当往往就能找到出路！"
    },
    {
      "id": "p10761-5ee67b219b82",
      "target": "唉，哈姆雷特，哈姆雷特，哈姆雷特。"
    },
    {
      "id": "p10762-af5d8375ef86",
      "target": "别理他。他很快就不会再烦我们两个了。"
    },
    {
      "id": "p10763-b249a68ea33f",
      "target": "陛下，您这话是什么意思？"
    },
    {
      "id": "p10764-a086f40870db",
      "target": "只是说，他最近的所作所为是要付出代价的。"
    },
    {
      "id": "p10765-53abdad4de84",
      "target": "我已经尽力了……不知道还能做什么。就连一条长满疥癣的狗，反应都比他好捉摸。"
    },
    {
      "id": "p10766-d543b8f12f63",
      "target": "可为了我的妻子，为了不让她精神崩溃，我还得继续设法跟他沟通……"
    },
    {
      "id": "p10767-5a1f1c179a05",
      "target": "我一会儿就去见他。作为哈姆雷特的新父亲，我必须尽快处理这件事。"
    },
    {
      "id": "p10768-1e9ecfcd51d0",
      "target": "他经历了年轻生命中最艰难的一段时光。"
    },
    {
      "id": "p10769-ec4d2ab13565",
      "target": "我还记得，很久以前失去父亲的时候。我也曾像哈姆雷特一样，迷失在愤怒的迷雾里。"
    },
    {
      "id": "p10770-9749a9aa829a",
      "target": "跟往常一样，一心要见血、惹事。"
    },
    {
      "id": "p10771-39c63465f2fa",
      "target": "那孩子是个麻烦，总该有人把它解决掉……"
    },
    {
      "id": "p10772-fac1e2338e3e",
      "target": "哈姆雷特最近举止古怪极了。您知道他出了什么事吗？"
    },
    {
      "id": "p10773-e0d446178aca",
      "target": "什么？又来了？唉，我可怜的哈姆雷特……"
    },
    {
      "id": "p10774-40675a49acda",
      "target": "恐怕他是真的疯了。他的行为已经超出了正常哀悼的范围。"
    },
    {
      "id": "p10775-16e31c3e909b",
      "target": "我和丈夫会去跟他谈谈。这消息让人担忧。谢谢你这么快就来告诉我们。"
    },
    {
      "id": "p10776-463ac3bd0104",
      "target": "我没有尽到母亲的责任。我相信，这就是他愤怒的根源。"
    },
    {
      "id": "p10777-5ba10178ad17",
      "target": "不，王后，看起来不像是因为这个。"
    },
    {
      "id": "p10778-21ce8410dfa5",
      "target": "我现在不想见他。求你别让他见我……"
    },
    {
      "id": "p10779-b3d81be55e7b",
      "target": "抱歉，奥菲莉娅，他吓到你了！"
    },
    {
      "id": "p10780-a1e348a783db",
      "target": "我相信他只是又在像个顽皮孩子一样胡闹。你知道他有时候就这样。"
    },
    {
      "id": "p10781-b71844050002",
      "target": "王后，这次不一样。我确信他是因为——什么事，神志不清了！"
    },
    {
      "id": "p10782-a3a954d54894",
      "target": "什么？绝不可能。我相信那只是个恶作剧！"
    },
    {
      "id": "p10783-26335978e069",
      "target": "不管怎样，我和丈夫早就想找他单独谈谈了。我们会尽快去的。谢谢你这么快就来告诉我们。"
    },
    {
      "id": "p10784-e3f8587af851",
      "target": "您在我卧室里看到的那一幕，不是我造成的。是哈姆雷特闯进我的房间，来纠缠<i>我</i>的。"
    },
    {
      "id": "p10785-0930dd4c5df6",
      "target": "他神志不清了，父亲。他出了什么问题。"
    },
    {
      "id": "p10786-643e4113cffa",
      "target": "是啊，他<i>确实出了问题。</i>"
    },
    {
      "id": "p10787-91a36c411d49",
      "target": "我们两个最好都避着他。让国王亲自主持公道吧。"
    },
    {
      "id": "p10788-d59cf980aeb0",
      "target": "不过，我想他不会再来找我们任何一个人的麻烦了。他企图杀了我，这之后就别想了。"
    },
    {
      "id": "p10789-f74134f4284a",
      "target": "我只庆幸他没能得逞。"
    },
    {
      "id": "p10790-5a22604f6dd2",
      "target": "或者……准确地说，是曾经如此。"
    },
    {
      "id": "p10791-554c137ab7c9",
      "target": "恐怕我们永远也不会知道，他的心魔把他折磨到了什么地步。"
    },
    {
      "id": "p10792-b00de3695fa0",
      "target": "就在昨天，我还会相信你的话。但如今一切都变了——哈姆雷特很可能会经历这一切，变成一个全新的年轻人。"
    },
    {
      "id": "p10793-ace1174d49ab",
      "target": "他现在似乎已经挺拔了几分，像个初露头角的国王。我们且看未来如何发展吧。"
    },
    {
      "id": "p10794-0a95d2acddf3",
      "target": "他最近的心情确实格外糟糕，但这不能成为借口——"
    },
    {
      "id": "p10795-903fc0e38752",
      "target": "——我是说，比平时更不对劲。他的衣服破了，整个人完全失了常，还胡言乱语……"
    },
    {
      "id": "p10796-940e6bce96a0",
      "target": "哎呀。就算是他，这也<i>确实</i>反常。"
    },
    {
      "id": "p10797-010bac4b7816",
      "target": "年轻人一旦遭到拒绝，心里就没那么容易平静下来。"
    },
    {
      "id": "p10798-95f6ebabe445",
      "target": "我不觉得这跟我“拒绝”他有关。一定是别的事出了问题。我知道。"
    },
    {
      "id": "p10799-a229a296e8e6",
      "target": "嗯。也许下次国王<b>接见臣民</b>时，你可以说说自己的遭遇？"
    },
    {
      "id": "p10800-d0b6adb0b433",
      "target": "不过，恐怕我也不知道王后是否有意管教他。"
    },
    {
      "id": "p10801-c1cfa940e25a",
      "target": "即使他开始……动手伤人，也不管吗？要是他威胁到您的安全呢？"
    },
    {
      "id": "p10802-e0f2cd012ec5",
      "target": "威胁到<i>我？</i>别这样。他从没做过什么，能让我真的为自己的安全担心。"
    },
    {
      "id": "p10803-bbc1239e7062",
      "target": "哈姆雷特的举止古怪极了，我很担心。你是他最好的朋友。你知道些什么？"
    },
    {
      "id": "p10804-e0f7f605aeb5",
      "target": "他什么时候<i>不</i>古怪了？不过，我想这也说得通。"
    },
    {
      "id": "p10805-9c05de9c31a3",
      "target": "我相信，那么多人里，他<i>当然会</i>找你寻求安慰，在……呃……之后。"
    },
    {
      "id": "p10806-5929be106e54",
      "target": "嗯。幽灵那件事。"
    },
    {
      "id": "p10807-68483c9cb0cf",
      "target": "听着。你得跟我说实话。"
    },
    {
      "id": "p10808-10c52b71bda6",
      "target": "我有理由相信，哈姆雷特的行为可能危及我父亲的性命。"
    },
    {
      "id": "p10809-c47b7af49f11",
      "target": "我不能告诉你。但你得相信，这件事很严重。"
    },
    {
      "id": "p10810-356fa88385b0",
      "target": "我认为，我父亲的死可能与那个幽灵有关。"
    },
    {
      "id": "p10811-b2a567b284e3",
      "target": "你、你……认为是幽灵让哈姆雷特<i>杀了</i>你父亲？"
    },
    {
      "id": "p10812-cf1a20ee04ef",
      "target": "连我都觉得这有点牵强。"
    },
    {
      "id": "p10813-bc932465aae6",
      "target": "或许不是让他杀我父亲。但我觉得，那亡魂对哈姆雷特说了什么，把他逼疯了。"
    },
    {
      "id": "p10814-b9b2459deb0e",
      "target": "我觉得，是那个幽灵怂恿哈姆雷特杀了我父亲。"
    },
    {
      "id": "p10815-87e221d8360f",
      "target": "你、你……认为是幽灵<i>叫</i>哈姆雷特那么做的？"
    }
  ]
}
