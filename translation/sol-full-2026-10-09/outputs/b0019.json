{
  "translations": [
    {
      "id": "p01762-df8fa6bb4dcb",
      "target": "那就这样吧。如果是<i>他</i>开口请求，我就答应。"
    },
    {
      "id": "p01763-3be92e8750eb",
      "target": "我……我只是怀疑过克劳狄斯。而且从没说出口。我从不知道他竟能做出这种事。"
    },
    {
      "id": "p01764-b1ca558c150a",
      "target": "儿子，我向你<i>发誓</i>，我从不知情。我发誓。"
    },
    {
      "id": "p01765-32a95aa76e5b",
      "target": "擦干眼泪吧，母亲。我会报仇的。为我们两个人。"
    },
    {
      "id": "p01766-d6eca33ff6e5",
      "target": "你很快就会知道。现在，别向叔叔透露这件事。剩下的我来处理。"
    },
    {
      "id": "p01767-af8c36995f27",
      "target": "该把这个可怜的老糊涂的尸体拖走了。"
    },
    {
      "id": "p01768-5ad9ef85dd15",
      "target": "哈姆雷特！住手！"
    },
    {
      "id": "p01769-05fed8c46ca6",
      "target": "哦，天哪。"
    },
    {
      "id": "p01770-d347b0e0d163",
      "target": "这个恶毒的女人！"
    },
    {
      "id": "p01771-a6a39eadad15",
      "target": "求你了，哈姆雷特，别这样！"
    },
    {
      "id": "p01772-1ad8895f4334",
      "target": "儿子——我的儿子——不……"
    },
    {
      "id": "p01773-ae20cea6974a",
      "target": "我一怀疑你帮克劳狄斯那条<i>毒蛇</i>干了那些卑劣的事，就该<i>杀了你</i>！"
    },
    {
      "id": "p01774-18b84030e515",
      "target": "要是由我做主，你的死法会比你马上要承受的痛苦一千倍！"
    },
    {
      "id": "p01775-9686e15264bd",
      "target": "哈姆雷特。立刻趴到地上。<i>停止抵抗。</i>"
    },
    {
      "id": "p01776-c0f2cdd185f4",
      "target": "你阻止不了我。现在不行。我<b>绝不</b>停止抵抗。"
    },
    {
      "id": "p01777-4874e5ff2c63",
      "target": "他只是昏过去了，王后。"
    },
    {
      "id": "p01778-269d51e60ef9",
      "target": "您呢，王后？您有没有……"
    },
    {
      "id": "p01779-b1c47acfe54b",
      "target": "贝尔纳多……我的儿子。他到底<i>怎么了</i>？"
    },
    {
      "id": "p01780-8b8c52944443",
      "target": "他神志不清。已经不像他自己了。"
    },
    {
      "id": "p01781-871971f19ee0",
      "target": "我必须把这里发生的事报告给国王。"
    },
    {
      "id": "p01782-7baf00495daa",
      "target": "我为父亲报仇，绝不会让你因此把我扔进什么肮脏的牢房。"
    },
    {
      "id": "p01783-bd163b6a0652",
      "target": "不——！不要，哈姆雷特——！"
    },
    {
      "id": "p01784-6fb6547e3335",
      "target": "我的儿子，你这个傻瓜……"
    },
    {
      "id": "p01785-a6e7b2087f2a",
      "target": "这太惨了。"
    },
    {
      "id": "p01786-c1b5d26bd9b6",
      "target": "对不起，王后。"
    },
    {
      "id": "p01787-1702fb9127e8",
      "target": "也对不起你，哈姆雷特。"
    },
    {
      "id": "p01788-14da59317f23",
      "target": "让他闭上眼睛。我看不得他这个样子。"
    },
    {
      "id": "p01789-f6e7fbd45ac8",
      "target": "我会把他搬走，王后。"
    },
    {
      "id": "p01790-dce86b43c033",
      "target": "请到炉火旁暖暖身子。转过身去，别看这惨状。"
    },
    {
      "id": "p01791-f39e4bedf443",
      "target": "交给我吧。哈姆雷特是我相识最久、最珍爱的朋友之一。我会收拾好这里。"
    },
    {
      "id": "p01792-2b04744ea8bf",
      "target": "你这个杀人、背叛的女人。你得用命来偿还我父亲的名誉。"
    },
    {
      "id": "p01793-99f33b6d5fcd",
      "target": "我全心全意地爱你。求你，别走到这一步。"
    },
    {
      "id": "p01794-84244cd83beb",
      "target": "现在，该除掉这个背叛的女人了。"
    },
    {
      "id": "p01795-f8a0239c471b",
      "target": "我的宝贝儿子……"
    },
    {
      "id": "p01796-d61d2bfd93be",
      "target": "不、不要，求你，不要……"
    },
    {
      "id": "p01797-98e995af8bfb",
      "target": "这不可能是真的。"
    },
    {
      "id": "p01798-322a809071b6",
      "target": "为什么非要走到这一步？为什么？"
    },
    {
      "id": "p01799-522862eb27ee",
      "target": "我已经没有任何理由留在这里了。"
    },
    {
      "id": "p01800-8a83d98b4c89",
      "target": "我的儿子死了，而我……"
    },
    {
      "id": "p01801-575d5f6a300b",
      "target": "这世上已经没有什么重要了。一切美好、珍爱的事物都已化为尘土。"
    },
    {
      "id": "p01802-a270c33557e6",
      "target": "来吧，利刃。找到你高贵的安息之所。"
    },
    {
      "id": "p01803-d4f4178783e5",
      "target": "圣父啊，赐我一个停留在这邪恶夏日开始之前的天堂。"
    },
    {
      "id": "p01804-3072360f23d0",
      "target": "在那里，我爱的人都还活着。"
    },
    {
      "id": "p01805-cea6a9bc6e34",
      "target": "小姐，国王陛下想与您谈谈。"
    },
    {
      "id": "p01806-42da8f730547",
      "target": "（天哪。这次又是什么事？）"
    },
    {
      "id": "p01807-95abfda366c5",
      "target": "奥菲莉娅小姐。"
    },
    {
      "id": "p01808-db02d147fd92",
      "target": "对于你父亲的离世，我再次致以最深切的哀悼。他是个了不起的人。"
    },
    {
      "id": "p01809-ac3064ce907c",
      "target": "谢谢您，陛下。您找我有什么事？"
    },
    {
      "id": "p01810-4039146effdf",
      "target": "先前，你向我提过一次海上航行的事。"
    },
    {
      "id": "p01811-cbf036ee271a",
      "target": "你告诉我，我想送哈姆雷特去死，是不会成功的。"
    },
    {
      "id": "p01812-b4274ef5b0a0",
      "target": "早在我自己产生这个念头之前，你就已经知道了。可你却没有告诉任何人。"
    },
    {
      "id": "p01813-fc2a57eb798e",
      "target": "我是否可以理解为，你保守秘密就是在默许？"
    },
    {
      "id": "p01814-4a5af64f3b93",
      "target": "是又如何，陛下？"
    },
    {
      "id": "p01815-684ae1f883aa",
      "target": "我知道，我的侄子给你带来了不少痛苦。"
    },
    {
      "id": "p01816-8a9bccdf77c5",
      "target": "你或许有兴趣听听：我打算交给罗森克兰兹和吉尔登斯吞一封信，让她们送给英格兰女王。"
    },
    {
      "id": "p01817-395cde966f31",
      "target": "你或许有兴趣听听：我打算交给这艘船的船员一封信，让他们送给英格兰女王。"
    },
    {
      "id": "p01818-f5853912f8be",
      "target": "那封信里写着我侄子的处决令，请求将他秘密处死。"
    },
    {
      "id": "p01819-f6a33e36a503",
      "target": "我相信，我的信会平安送到该收信的人手中。即便如此……"
    },
    {
      "id": "p01820-70f7eebc7288",
      "target": "据我所知，只有你知道我的真实意图。我不会再告诉其他人信里写了什么。"
    },
    {
      "id": "p01821-2be578ba348a",
      "target": "如果你愿意为国王效力，赢得我本人的恩宠，或许可以陪哈姆雷特一同出行。确保他回不来。"
    },
    {
      "id": "p01822-f9b527febe0f",
      "target": "船在上午十点启航。跟他一起去，按我的吩咐行事。<i>务必</i>让哈姆雷特死去，你就会得到应有的奖赏。"
    },
    {
      "id": "p01823-5a17701ffcaf",
      "target": "怎么样？发生了什么？"
    },
    {
      "id": "p01824-9dc5714e3f1c",
      "target": "我躲了<i>好久好久</i>！"
    },
    {
      "id": "p01825-cbefe4ffbad3",
      "target": "你知道我有多饿吗？我差点把自己的腿都啃掉了！"
    },
    {
      "id": "p01826-9159fadf50eb",
      "target": "对不起，吉尔达。我忘了告诉罗森克兰兹。"
    },
    {
      "id": "p01827-6db19465a2e1",
      "target": "你<i>忘了</i>？好吧，记住：这是我<i>最后一次</i>请你安排假葬礼！"
    },
    {
      "id": "p01828-1c9aa30b0b6e",
      "target": "对不起，吉尔达。我告诉罗森克兰兹了，不过大概还是没来得及。"
    },
    {
      "id": "p01829-dde3891e7d83",
      "target": "<i>没来得及</i>？好吧，记住：这是我<i>最后一次</i>请你安排假葬礼！"
    },
    {
      "id": "p01830-5645082a855a",
      "target": "这样大概也好。"
    },
    {
      "id": "p01831-92d147f777ba",
      "target": "现在我得去跟罗茜解释这个恶作剧了。她会生气的。"
    },
    {
      "id": "p01832-d44be3593eb0",
      "target": "糟了。她来了。"
    },
    {
      "id": "p01833-019ca69f244b",
      "target": "你没有……死。"
    },
    {
      "id": "p01834-41a7ca365b96",
      "target": "罗茜。我可以解释。"
    },
    {
      "id": "p01835-60f21dfda54b",
      "target": "我不在乎。我不需要知道。"
    },
    {
      "id": "p01836-7c45c65518d5",
      "target": "只要你再也别这样对我。"
    },
    {
      "id": "p01837-28fce41b8de9",
      "target": "你知道那有多难受吗？知道我有多害怕吗？"
    },
    {
      "id": "p01838-8481684302d0",
      "target": "我不想再有那种感觉。永远都不想。"
    },
    {
      "id": "p01839-bb7633419aec",
      "target": "对不起，罗茜。"
    },
    {
      "id": "p01840-6acdf4017aaf",
      "target": "我以为会很好笑。我真的这么想。"
    },
    {
      "id": "p01841-951e689057c9",
      "target": "唉，吉尔达，我的宝贝。"
    },
    {
      "id": "p01842-7dc26abf0070",
      "target": "只有你在身边，<i>才让</i>生活有了乐趣。"
    },
    {
      "id": "p01843-41cae8a1277e",
      "target": "没有你，我真不知道这一切还有什么意义。"
    },
    {
      "id": "p01844-88723c6c9131",
      "target": "我让你们俩单独待一会儿。"
    },
    {
      "id": "p01845-258bf4e654d0",
      "target": "谢谢你，奥菲莉娅。"
    },
    {
      "id": "p01846-df3aa2948686",
      "target": "现在已经无能为力了。"
    },
    {
      "id": "p01847-8fc1437ae05b",
      "target": "必须让哈姆雷特远离我们。远离所有人。"
    },
    {
      "id": "p01848-5dab76911f7d",
      "target": "为了他身边的人，也为了他自己的安全。"
    },
    {
      "id": "p01849-4a2f8bfe4e4f",
      "target": "罗森克兰兹女士，吉尔登斯吞女士，我命令你们陪他去英格兰。"
    },
    {
      "id": "p01850-314f6bdc51c3",
      "target": "容我提醒您，陛下，就在刚才，我们还因叛国的指控被关在您的地牢里。"
    },
    {
      "id": "p01851-99fe599706b1",
      "target": "罗茜！那句俗话怎么说来着？赠马不看牙！赠马可是特别凶的一种马！"
    },
    {
      "id": "p01852-d95a3c4b28b9",
      "target": "赠马不是马的<i>品种</i>，吉尔达。"
    },
    {
      "id": "p01853-8a635a74dfe3",
      "target": "那<i>你</i>要亲自去跟赠马说吗？它会把你的脸咬下来！"
    },
    {
      "id": "p01854-bd44156b9c60",
      "target": "什么？这跟咬人有什么关系？我……哎呀。让我解释一下这句俗话。"
    },
    {
      "id": "p01855-7e69d6282965",
      "target": "是，陛下！"
    },
    {
      "id": "p01856-16321958db32",
      "target": "光是看着你们俩，我就头疼。不过，我现在也没多少选择。你们要陪哈姆雷特去英格兰。"
    },
    {
      "id": "p01857-c9f7026e9bf5",
      "target": "如果你们能替我办成这件事，我就撤销对你们的所有叛国指控。"
    },
    {
      "id": "p01858-7650d9611c6d",
      "target": "所以……我们不但不会被处死，<i>还能</i>免费去英格兰度假。今天可能是我这辈子最美好的一天。"
    },
    {
      "id": "p01859-781c2e0f4fb2",
      "target": "作为交换，我请你们帮一个小忙。"
    },
    {
      "id": "p01860-b3f9421a7426",
      "target": "到了那里，务必把这封信交给女王。"
    },
    {
      "id": "p01861-224969d53bbb",
      "target": "她会为哈姆雷特安排合适的治疗。"
    },
    {
      "id": "p01862-7303a9d7f8ea",
      "target": "能让他永远振作起来的治疗？"
    },
    {
      "id": "p01863-6c1b21d0b322",
      "target": "某种意义上，可以这么说。"
    },
    {
      "id": "p01864-89ec6e19f86d",
      "target": "陛下，有人告诉我们，如果登船去英格兰，我们可能会面临极大的危险。"
    },
    {
      "id": "p01865-f1f2f621c868",
      "target": "而且，上次那个算命的说我的手洗澡时会泡肿，从那以后我就信了。"
    },
    {
      "id": "p01866-e7af77aac5e5",
      "target": "可手本来就会那——"
    },
    {
      "id": "p01867-2af16c443c88",
      "target": "哼。算了。"
    },
    {
      "id": "p01868-8cec6cec31e5",
      "target": "女士，你还没学会不去相信那些自称知道未来的人吗？"
    },
    {
      "id": "p01869-1bb238f46bf8",
      "target": "可这次不是算命的。是奥菲莉娅小姐！我<i>更</i>信她！"
    },
    {
      "id": "p01870-1d8082409ae0",
      "target": "奥菲莉娅小姐？"
    },
    {
      "id": "p01871-a432fe049793",
      "target": "（那女孩真<i>该死</i>。）"
    },
    {
      "id": "p01872-7641c54b0bdd",
      "target": "她从哪里——怎么会——听到这种话？"
    },
    {
      "id": "p01873-c588b186b060",
      "target": "无论如何，让我把话说清楚。你们要去英格兰。我会尽力让你们的旅程既舒适又安全。"
    },
    {
      "id": "p01874-bcd62033270b",
      "target": "还有，请不要再听奥菲莉娅小姐的建议了。她最近病得很重，很重。"
    },
    {
      "id": "p01875-a48ed96e2fd6",
      "target": "哈姆雷特疯了。这也不能怪您。"
    },
    {
      "id": "p01876-6b4c04c4086c",
      "target": "别说了，吉尔达。拜托。有人<i>死了</i>。我们就不能说话得体些吗？"
    },
    {
      "id": "p01877-fad29b8943cb",
      "target": "别说了，吉尔达。拜托。他父亲<i>去世了</i>。我们就不能说话得体些吗？"
    },
    {
      "id": "p01878-0952c57ff522",
      "target": "好吧。<i>大概</i>是该这样。"
    },
    {
      "id": "p01879-a184103b263e",
      "target": "去吧，两位女士。船很快就要启航了。"
    },
    {
      "id": "p01880-e5eb55feb245",
      "target": "罗森克兰兹？吉尔登斯吞？你们怎么在这里？我以为——"
    },
    {
      "id": "p01881-f7e144f52b4f",
      "target": "都是误会，我的好侄子。责任在我。"
    },
    {
      "id": "p01882-af5889dba156",
      "target": "我起初认定那是叛国，现在才明白，是我一时判断失误。"
    },
    {
      "id": "p01883-6ba2c365c664",
      "target": "所以，罗森克兰兹女士和吉尔登斯吞女士这两位好女士来这里，是要陪你一同航行去英格兰。"
    },
    {
      "id": "p01884-8c28e392904e",
      "target": "而且你叔叔还逼我们向他许了个秘密承诺！"
    },
    {
      "id": "p01885-84e1fd6610d5",
      "target": "——呃……吉尔达的意思是，我们私下承诺了，这一路会尽心尽力地照顾你！"
    },
    {
      "id": "p01886-135050e08792",
      "target": "（吉尔达，你这个<i>笨蛋</i>。）"
    },
    {
      "id": "p01887-1669d7538f81",
      "target": "对。是的。就是她说的那样。"
    },
    {
      "id": "p01888-cc8515e40029",
      "target": "那么。是时候与丹麦永远告别了。"
    },
    {
      "id": "p01889-12e6080a5e46",
      "target": "这对你会有好处的，哈姆雷特。"
    },
    {
      "id": "p01890-94c0f9d2c6dc",
      "target": "又能像从前一样了！"
    },
    {
      "id": "p01891-fc499c74c720",
      "target": "我们会在伦敦四处奔走，闯了祸再脱身……"
    },
    {
      "id": "p01892-e232e1cc88a7",
      "target": "外交豁免权的好处全都有，坏处一个也没有！"
    },
    {
      "id": "p01893-c59afd2da7f4",
      "target": "听你们这么说，几乎都不像是在流放我了。"
    },
    {
      "id": "p01894-9a2f2fc7b4c7",
      "target": "但我们都别弄错了。叔叔是在把我<i>这个</i>怪物送到一个无法再造成伤害的地方。"
    },
    {
      "id": "p01895-fe9879789f3d",
      "target": "再见，我最亲爱的侄子。"
    },
    {
      "id": "p01896-65f1805e7b4e",
      "target": "愿你此行迅速而平顺，早日投入英格兰的怀抱。"
    },
    {
      "id": "p01897-4aa64245c8b7",
      "target": "您可真有诗意。"
    },
    {
      "id": "p01898-3f4c256e5502",
      "target": "啊。你来了，奥菲莉娅。"
    },
    {
      "id": "p01899-fd8f60582520",
      "target": "这是怎么回事？你们要去哪里？"
    },
    {
      "id": "p01900-b280efe99b08",
      "target": "我现在要去英格兰了，也许再也不会回来。我甚至不敢问，你会不会想起我。会不会想念我。"
    },
    {
      "id": "p01901-f6d9fb3f75ff",
      "target": "啊，哈姆雷特。计划有变。"
    },
    {
      "id": "p01902-2fd7cf29198f",
      "target": "奥菲莉娅会和你一起上船！"
    },
    {
      "id": "p01903-39fec8913ebd",
      "target": "是的，哈姆雷特。我受命陪同你出行。"
    },
    {
      "id": "p01904-a3738652f3e9",
      "target": "如今这么不安宁……克劳狄斯觉得，最好有个熟悉的人陪在你身边。"
    },
    {
      "id": "p01905-8ea3595c276d",
      "target": "也许……是吧。"
    },
    {
      "id": "p01906-bb5fadc667a1",
      "target": "那就出发吧。你们两个都去。风越来越大了。"
    },
    {
      "id": "p01907-e811c61be74f",
      "target": "亲爱的，祝你们一路顺风。多保重。"
    },
    {
      "id": "p01908-4c1ae6317490",
      "target": "我父亲因你而死。我可不敢说我会。"
    },
    {
      "id": "p01909-ce1a67274ae5",
      "target": "我不能怪你。"
    },
    {
      "id": "p01910-28d8639f886e",
      "target": "你只需知道，无论一个傻瓜的话有多少分量，我都很抱歉。"
    },
    {
      "id": "p01911-7c03d8dfff8a",
      "target": "我从没想过要杀他。"
    },
    {
      "id": "p01912-2209bf19471e",
      "target": "这么问对我不公平，不是吗？"
    },
    {
      "id": "p01913-5d6337730ef4",
      "target": "嗯。我想是的。"
    },
    {
      "id": "p01914-46e837ce7306",
      "target": "即使这话没多少分量，对于你父亲遭遇的一切，我很抱歉。真心的。"
    },
    {
      "id": "p01915-b3deb1225377",
      "target": "去英格兰吧！暂且告别了，哈姆雷特。"
    },
    {
      "id": "p01916-b45049198b6a",
      "target": "暂别，也许是永别。"
    },
    {
      "id": "p01917-ef1e0ebd8d34",
      "target": "哈姆雷特。何必这么沮丧？这可是我们开始一场新冒险的机会！"
    },
    {
      "id": "p01918-decc785e077e",
      "target": "是啊，新的生活，新的旅程——就在英格兰！"
    },
    {
      "id": "p01919-3c4657e3a51e",
      "target": "出发吧。我觉得风暴要来了。"
    },
    {
      "id": "p01920-0f6c4ce131e9",
      "target": "好了，看来我该出发了。"
    },
    {
      "id": "p01921-3669d86bfbab",
      "target": "这漫长的几年里，我在这座城堡过得很好。"
    },
    {
      "id": "p01922-1eb232862688",
      "target": "但还有更美好的地方在等着我！"
    },
    {
      "id": "p01923-f64f2606290b",
      "target": "我已经能想象那艘船此刻在港口等着的样子了。"
    },
    {
      "id": "p01924-cd452b62267a",
      "target": "我一直梦想着，这些船里能有一艘为我启航。"
    },
    {
      "id": "p01925-9ff0eaf186fe",
      "target": "您的行李箱已经装好了，大人。我们上接驳艇吧？"
    },
    {
      "id": "p01926-f2f56e1fe61a",
      "target": "好，我想是该上船了，雷纳尔多。"
    },
    {
      "id": "p01927-572622e7ffb3",
      "target": "再见，你这个疯子。别给自己惹上太大的麻烦。"
    },
    {
      "id": "p01928-da3159584a5d",
      "target": "我也会想你的，布莉特。"
    },
    {
      "id": "p01929-1953cc531ec2",
      "target": "您该趁风向有利的时候出发。"
    },
    {
      "id": "p01930-ff1ad7c3c4a6",
      "target": "是，是，风不等人，我们也得走了。"
    },
    {
      "id": "p01931-3a371cef867a",
      "target": "再见，妹妹。注意安全。"
    },
    {
      "id": "p01932-8461168ac768",
      "target": "各位，再见。"
    },
    {
      "id": "p01933-8337df8f8593",
      "target": "那就去巴黎吧！"
    },
    {
      "id": "p01934-fbfbd4d36726",
      "target": "错误：如果你看到了这段文字，就说明出了很严重的问题！"
    },
    {
      "id": "p01935-bca29fe41685",
      "target": "酒保，请来一壶最好的酒。"
    },
    {
      "id": "p01936-c945ffc8f0a0",
      "target": "你一定就是他们说的奥赛罗。"
    },
    {
      "id": "p01937-21e54b615d10",
      "target": "……看来是的。那您一定就是他们说的雷欧提斯大人。"
    },
    {
      "id": "p01938-43782569d7f6",
      "target": "雷欧提斯大人……这个称呼一直都挺好笑的。我现在应该是公爵了，对吧？"
    },
    {
      "id": "p01939-84653f36af70",
      "target": "令尊的噩耗，真令人遗憾，大人。"
    },
    {
      "id": "p01940-9167394bf44e",
      "target": "他是个好人。再好不过的人，一位坚定可靠的顾问，也是一位出色的父亲。"
    },
    {
      "id": "p01941-fd097cc39848",
      "target": "真不走运，我们的船离港时耽搁了。"
    },
    {
      "id": "p01942-3928288a5458",
      "target": "我刚在这里上岸，就有人递给我一封信……"
    }
  ]
}
