{
  "translations": [
    {
      "id": "p05790-0745482a2605",
      "target": "我会尽快说完。我知道你很忙。"
    },
    {
      "id": "p05791-147212227052",
      "target": "奥菲莉娅建议我找你谈谈。据我了解，有理由怀疑你最近可能有过——或目睹过——可疑行为。"
    },
    {
      "id": "p05792-8714891ecf4f",
      "target": "对此，你有什么要说的？"
    },
    {
      "id": "p05793-3866040fc27c",
      "target": "是为了那个“间谍”的传闻吗？我是清白的！我是好人！我从不离开城堡——"
    },
    {
      "id": "p05794-820137d5fee7",
      "target": "对，就是这样。我已经好几个星期没离开埃尔西诺了！"
    },
    {
      "id": "p05795-73ee59cd9a29",
      "target": "那你有没有传递什么信件？或是字条之类的？"
    },
    {
      "id": "p05796-cbd8cf3e5fcd",
      "target": "你是否自愿同意我的手下搜查你的房间，寻找这类信件？"
    },
    {
      "id": "p05797-ae46b1df7d32",
      "target": "尽管搜！我既不识字，也不会写字。你看我像是个<i>有学问</i>的女人吗？"
    },
    {
      "id": "p05798-ff8ad866df34",
      "target": "啊……有意思。也就是说，你没法通信。"
    },
    {
      "id": "p05799-9306c4683c91",
      "target": "想想吧，贝尔纳多。谁巴不得看见国王和我的女主人屈膝求饶？"
    },
    {
      "id": "p05800-f9197b88ba36",
      "target": "谁最恨他们？谁日夜叫嚷着对他们的不满，恨不得让所有人都听见？"
    },
    {
      "id": "p05801-b0fc46450282",
      "target": "……你是说，哈姆雷特就是间谍？"
    },
    {
      "id": "p05802-045584d56ce3",
      "target": "当然！那小子既危险又难以捉摸。你该审问的是<i>他</i>。"
    },
    {
      "id": "p05803-646e41ce7468",
      "target": "暂时就问到这里，伊尔玛。你可以走了。"
    },
    {
      "id": "p05804-170a3feaf594",
      "target": "哼。浪费我的时间，还让我白费口舌……"
    },
    {
      "id": "p05805-d4c596504ca9",
      "target": "伊尔玛。有什么需要我帮忙的？"
    },
    {
      "id": "p05806-d880292cb26c",
      "target": "奥菲莉娅小姐让我下来找你谈谈！你到底有什么事？"
    },
    {
      "id": "p05807-54b0a8a64c4c",
      "target": "抱歉。奥菲莉娅小姐一定是弄错了。我没有什么事要找你谈。"
    },
    {
      "id": "p05808-03c6b40fcb1a",
      "target": "（啊，对，早会还没开始……他还没宣布间谍的消息。我来得太早了。）"
    },
    {
      "id": "p05809-170e8f3a2d8c",
      "target": "那么，哈姆雷特殿下……我相信这只是走个程序。"
    },
    {
      "id": "p05810-7f96392b87a2",
      "target": "你可以省掉那个称呼的。"
    },
    {
      "id": "p05811-dd692c17b7b9",
      "target": "就是“殿下”。我从来都不喜欢你这么叫我，现在也不喜欢。"
    },
    {
      "id": "p05812-e65aa610918d",
      "target": "不过，我想你一向就比雷欧提斯和我更讲究礼节。"
    },
    {
      "id": "p05813-a1e3c912e54e",
      "target": "我们还是说正事吧，哈姆雷特。"
    },
    {
      "id": "p05814-0162973b3bd4",
      "target": "把你叫到这里来，是因为你，呃，受到了一些怀疑。"
    },
    {
      "id": "p05815-b9c6362bc80d",
      "target": "真是出人意料！我叔叔怀疑我是间谍？"
    },
    {
      "id": "p05816-e16d244d8eba",
      "target": "当然不是——因为<i>我</i>绝不会这么怀疑你。我从小就认识你。你要真是间谍，我还能不知道吗？"
    },
    {
      "id": "p05817-809d1228e6b5",
      "target": "你来找我，来得正好。你叔叔，呃，让我跟你谈谈我们最近遭遇的情报泄露。"
    },
    {
      "id": "p05818-9e57e230fd62",
      "target": "听着。我原本以为叔叔的担忧只是多疑，没当回事，但也许并非毫无根据。"
    },
    {
      "id": "p05819-20b6d4a697ab",
      "target": "哈姆雷特殿下？您怎么来了？"
    },
    {
      "id": "p05820-51030e84b165",
      "target": "奥菲莉娅让我来找你。"
    },
    {
      "id": "p05821-1fad98712fb0",
      "target": "她让你来的？为了什么？"
    },
    {
      "id": "p05822-bcd13650f763",
      "target": "你是说你不知道？好吧，那就没什么了。"
    },
    {
      "id": "p05823-0324d2361600",
      "target": "不过，既然我来了，有件事倒是值得谈谈……"
    },
    {
      "id": "p05824-0155812b477c",
      "target": "我在画廊里发现了几张奇怪的字条。"
    },
    {
      "id": "p05825-6850b2303e2a",
      "target": "画……画廊？殿下，具体在哪里？"
    },
    {
      "id": "p05826-c1eaa64d19dc",
      "target": "那些字条藏在靠近门口的一个书架里。"
    },
    {
      "id": "p05827-b222cc42fdc6",
      "target": "我之前没把它们当回事，但现在，我有些拿不准了。"
    },
    {
      "id": "p05828-0bcb95837b6d",
      "target": "它们很奇怪。我……原以为是有人不小心把它们落在画廊里了，所以就没动。"
    },
    {
      "id": "p05829-5b78981acb46",
      "target": "有意思。等我有空，就去画廊看看。"
    },
    {
      "id": "p05830-6ebb6c9c2649",
      "target": "不过，哈姆雷特，更要紧的是……你最近的精神状态。你那些胡言乱语，还有四处游荡。你是不是……"
    },
    {
      "id": "p05831-a1d4f2a7afa5",
      "target": "有什么我能帮上忙的吗？"
    },
    {
      "id": "p05832-193d1e3b740a",
      "target": "没有。没有，你帮不了。"
    },
    {
      "id": "p05833-232c0d425f40",
      "target": "我只想一个人清静清静。"
    },
    {
      "id": "p05834-be07befef37b",
      "target": "你可以相信我，哈姆雷特。我希望你明白这一点。"
    },
    {
      "id": "p05835-eabe3e427297",
      "target": "我该走了。先告辞了。"
    },
    {
      "id": "p05836-3cb6eb147988",
      "target": "卫队长。奥菲莉娅为什么让我来这里？"
    },
    {
      "id": "p05837-8c5ae845bf5a",
      "target": "王后，我实在不愿打扰您，但有人建议让您来我这里接受审问。"
    },
    {
      "id": "p05838-307d313061f0",
      "target": "是奥菲莉娅建议的？"
    },
    {
      "id": "p05839-b321be297b6e",
      "target": "无论看起来多么微不足道，这件事都值得调查。"
    },
    {
      "id": "p05840-f6e0fea7d34e",
      "target": "啊，我明白了。她觉得我就是我丈夫那么担心的那个可恶的“间谍”。"
    },
    {
      "id": "p05841-e959993dff12",
      "target": "告诉我，好队长。<i>你</i>觉得我会暗中破坏我丈夫的事吗？"
    },
    {
      "id": "p05842-4be72ce54d78",
      "target": "……不，王后。我不这么认为。"
    },
    {
      "id": "p05843-cda8dfafb9a1",
      "target": "你有什么<i>证据</i>，能支持这次审问吗？"
    },
    {
      "id": "p05844-6690bfbe0c23",
      "target": "我很惭愧，王后。请接受我诚挚的歉意。"
    },
    {
      "id": "p05845-f21ffe8f55d1",
      "target": "哼。我就知道没有。我现在要告辞了。这简直是<i>难以置信</i>的侮辱。我都不知道该说什么。"
    },
    {
      "id": "p05846-da3d889c1789",
      "target": "无论是对你、奥菲莉娅，还是任何其他人。"
    },
    {
      "id": "p05847-a116c0cb4682",
      "target": "是的。她说你想找我谈谈。"
    },
    {
      "id": "p05848-3da666138d1c",
      "target": "我想不出有什么事要谈。抱歉，王后。"
    },
    {
      "id": "p05849-37c0b020129f",
      "target": "（啊，对。他还没向宫廷宣布自己的怀疑。我来得太早了。）"
    },
    {
      "id": "p05850-6f3c3f01b885",
      "target": "王后，我实在不愿打扰您，但我得到了一些令人不安的消息。"
    },
    {
      "id": "p05851-0986f96e49f0",
      "target": "无论多么令人难以置信，这件事都值得调查。"
    },
    {
      "id": "p05852-99f31dd5b56c",
      "target": "你是什么意思？我丈夫在调查我？究竟是为了什么？"
    },
    {
      "id": "p05853-4fbcbff78128",
      "target": "他对您最近的一些行为感到不安。至于进一步的指控，我就不说出口了。"
    },
    {
      "id": "p05854-e7270c35cf68",
      "target": "这么说，一定是有人看见我翻他的东西了。是这样吗？"
    },
    {
      "id": "p05855-6573a19e8c06",
      "target": "我明白了。奥菲莉娅看见我翻找东西，就直接来告诉你了。是这样吗？"
    },
    {
      "id": "p05856-6db8724b8c2f",
      "target": "这么说……您承认了？"
    },
    {
      "id": "p05857-00afca6eb4e4",
      "target": "我承认。但原因可能与你想的不同。"
    },
    {
      "id": "p05858-faed3b35b0bf",
      "target": "贝尔纳多，你能保守秘密吗？"
    },
    {
      "id": "p05859-c57708da715d",
      "target": "我……这得看，王后，得看是什么秘密……"
    },
    {
      "id": "p05860-391fb7b2eecf",
      "target": "我已故的丈夫曾给过我一件很特别的礼物。我想，我亲爱的克劳狄斯把它藏起来，不让我找到了。"
    },
    {
      "id": "p05861-b65eaaafd25f",
      "target": "是我的一枚护身符。它……是我心爱的珍宝，有着格外特殊的意义。"
    },
    {
      "id": "p05862-eb25cb6a336c",
      "target": "哈姆雷特戴着它上战场。那是送给他的礼物。我还是个姑娘时，从父亲的领地来到这里，就带着它。"
    },
    {
      "id": "p05863-5ea613a68e94",
      "target": "我们成婚时，他戴着它。后来，他将要下葬时……我把它挂在他的脖子上。可是……到了葬礼上……它却不见了。"
    },
    {
      "id": "p05864-2c156c566abd",
      "target": "我确定是克劳狄斯拿走了它。我原以为也许能找到。可我确信，他已经把它偷偷拿走了。"
    },
    {
      "id": "p05865-36ff26533597",
      "target": "扔进海里，熔掉，或是埋到很远的地方，深深埋起来。他对所有令人痛苦的事物，都是这样处理的。"
    },
    {
      "id": "p05866-751a5af0fc95",
      "target": "我想，我再也找不到它了。"
    },
    {
      "id": "p05867-11898655d966",
      "target": "我完全不知道这些。"
    },
    {
      "id": "p05868-4000d5a46eb1",
      "target": "王后，恕我冒昧打扰。"
    },
    {
      "id": "p05869-da2129522d0a",
      "target": "这份空缺，只能由我独自填补。谢谢你的理解，贝尔纳多。"
    },
    {
      "id": "p05870-4683ffaf0a57",
      "target": "真令人难过。"
    },
    {
      "id": "p05871-fdf94b8f15ce",
      "target": "这到底是怎么回事？好队长，是你传我们来的？"
    },
    {
      "id": "p05872-765259e35840",
      "target": "我们惹麻烦了吗？要是惹了，那可不是我干的！"
    },
    {
      "id": "p05873-a6aef9aa266a",
      "target": "两位女士，恐怕你们确实惹上麻烦了。"
    },
    {
      "id": "p05874-4a8cc5635d8b",
      "target": "有人看见你们在城堡各处行为古怪，而我有责任展开调查。"
    },
    {
      "id": "p05875-9d56b9b81d86",
      "target": "你们能详细说明一下，当时在做什么吗？"
    },
    {
      "id": "p05876-6ce740ca5ce3",
      "target": "哦，当然！是这样的，我们当时遇到了<i>大</i>麻烦，然后——哎哟！"
    },
    {
      "id": "p05877-b164c11439d0",
      "target": "（别说了，吉尔达。要是告诉他实情，只会显得我们像两个傻子。）"
    },
    {
      "id": "p05878-6ea642fa5ef5",
      "target": "（你想让<i>你</i>父亲知道我们的困境吗？反正<i>我</i>不想。）"
    },
    {
      "id": "p05879-f74fbfebd8b9",
      "target": "没什么，队长。"
    },
    {
      "id": "p05880-4b50f682bf8a",
      "target": "你们对自己的行为没有任何解释？你们知不知道，不配合这次调查，就等同于叛国？"
    },
    {
      "id": "p05881-04f837cf1662",
      "target": "那好吧。也许在牢房里待上一阵，你们就肯开口了。"
    },
    {
      "id": "p05882-f8a108ba0eee",
      "target": "<i>什么？</i>你总不至于真要——"
    },
    {
      "id": "p05883-4b7e45a148f5",
      "target": "哦，我就是认真的。"
    },
    {
      "id": "p05884-1d7909aff71c",
      "target": "目前，我还没有理由怀疑你们。不过，既然你们来了，我不妨问问。"
    },
    {
      "id": "p05885-cce8478c17ec",
      "target": "有人企图窥探这座城堡里的居民，对此，你们知道些什么？"
    },
    {
      "id": "p05886-249ad1373030",
      "target": "今天早上的朝会上，我有些相当令人不安的消息要宣布，涉及可能就在我们眼皮底下发生的叛国行为。"
    },
    {
      "id": "p05887-13ceae71b2e6",
      "target": "你们来找我的时机，巧得有些蹊跷。"
    },
    {
      "id": "p05888-8d5df825d27b",
      "target": "这、这个，没什么特别的！"
    },
    {
      "id": "p05889-603f4db50b36",
      "target": "我们只是来吃东西的！"
    },
    {
      "id": "p05890-65640d29edf3",
      "target": "当然，还要觐见国王。"
    },
    {
      "id": "p05891-f92fa3a7d63e",
      "target": "是他召我们来的，说想见见我们。我想是与王子有关吧？"
    },
    {
      "id": "p05892-90ddc182e5f9",
      "target": "可我们还没见到他呢！我们才刚到，<i>嗖！</i>奥菲莉娅不知从哪儿冒了出来，让我们来找你谈话。"
    },
    {
      "id": "p05893-d5c1ce2d16f2",
      "target": "当然，还要照看哈姆雷特。"
    },
    {
      "id": "p05894-dd443ec43f4b",
      "target": "照看……哈姆雷特？"
    },
    {
      "id": "p05895-923f7e00d723",
      "target": "国王让我们留意哈姆雷特的出入行踪。他担心侄子的健康。"
    },
    {
      "id": "p05896-ac7ce7c09de8",
      "target": "明白了。这<i>确实</i>很有道理。"
    },
    {
      "id": "p05897-bf2f5db0a269",
      "target": "你们觉得自己做得怎么样？"
    },
    {
      "id": "p05898-e6c56b6f4aa9",
      "target": "这个，呃……"
    },
    {
      "id": "p05899-2bd91f88d9d0",
      "target": "我们连他的人都还没见到呢！我们才刚到，<i>嗖！</i>奥菲莉娅不知从哪儿冒了出来，让我们来找你谈话。"
    },
    {
      "id": "p05900-9bf186a25d8d",
      "target": "他和我们记忆中的那个人不一样了！"
    },
    {
      "id": "p05901-fa53e166d3bf",
      "target": "他似乎<i>确实</i>有什么事压在良心上，让他备受煎熬。也许你该去看看他。或者让他来看看你。"
    },
    {
      "id": "p05902-3b06d79b96d9",
      "target": "你们可以走了。抱歉耽误了你们。"
    },
    {
      "id": "p05903-bef0fdac44bf",
      "target": "没关系，贝尔纳多。那我们就告辞了。"
    },
    {
      "id": "p05904-be5b6c11aac6",
      "target": "在牢里待上一阵，她们就会老实了。"
    },
    {
      "id": "p05905-50d1d6514d84",
      "target": "两位女士，别再惹麻烦了。"
    },
    {
      "id": "p05906-9bbcb2cf4f62",
      "target": "这可不敢保证！"
    },
    {
      "id": "p05907-7b5af0620c70",
      "target": "啊，诗人先生。没想到会在这里见到你。"
    },
    {
      "id": "p05908-18d0083eabce",
      "target": "奥菲莉娅让我来找你谈谈。我想，这也是迟早的事。我骨子里就是个爱惹事的人。"
    },
    {
      "id": "p05909-90329f9160a4",
      "target": "那么，也许爱惹事的人，知道怎么阻止别人惹事。"
    },
    {
      "id": "p05910-3edc95084ca4",
      "target": "关于威胁国家的事，你知道些什么？"
    },
    {
      "id": "p05911-2d8f88a77726",
      "target": "我？什么都不知道。不过，仔细想想……"
    },
    {
      "id": "p05912-f3ef58095c16",
      "target": "我从卫兵宿舍的窗户往外看，见过好几个人在凌晨离开城堡。"
    },
    {
      "id": "p05913-358cee972a06",
      "target": "他们有时似乎是往镇上去，有时则往码头去。"
    },
    {
      "id": "p05914-218a49079909",
      "target": "当然，也可以说，他们是半夜醒来，忽然特别想喝上一杯酒，但——似乎不太可能。"
    },
    {
      "id": "p05915-aefeaece7731",
      "target": "更像是在做什么不愿被人撞见的事。"
    },
    {
      "id": "p05916-7e0291819d3b",
      "target": "咳。有意思。你说是在深夜？"
    },
    {
      "id": "p05917-4b1513b09e24",
      "target": "我会尽快，呃，在能安排的时候，让马塞勒斯进一步调查。"
    },
    {
      "id": "p05918-8c7bcd58d2c6",
      "target": "你不知道？"
    },
    {
      "id": "p05919-5d33915b5b24",
      "target": "是的，我一时想不出有什么事。"
    },
    {
      "id": "p05920-96403f60f38d",
      "target": "那好吧！我就不在这里受审了，开开心心地走我的路去。"
    },
    {
      "id": "p05921-0f337324a7cc",
      "target": "（对。贝尔纳多还没公开提起间谍的事——还得再过几个小时才会提。我来得有点早了。）"
    },
    {
      "id": "p05922-f4197398566b",
      "target": "布莉特女士，我长话短说。"
    },
    {
      "id": "p05923-01e7cd9e1dbc",
      "target": "我已经知道了，队长。你要问我间谍的事，对吧？"
    },
    {
      "id": "p05924-3112c3a33281",
      "target": "我知道你所谓的“间谍”是谁。就是王后。"
    },
    {
      "id": "p05925-97079caa1ea9",
      "target": "女、女士，这可是相当<i>严重</i>的指控。您不觉得吗？"
    },
    {
      "id": "p05926-528d6ef6546a",
      "target": "一点也不，因为她不是间谍。我亲眼看见她在国王的房间里翻找。让他如此担惊受怕的，就是她。"
    },
    {
      "id": "p05927-f83e6a417e2a",
      "target": "不过是个妻子，在丈夫的物品里寻找丢失的东西……每天晚上，就在午夜前。再合理不过了！"
    },
    {
      "id": "p05928-79ff8f38ba12",
      "target": "如果她没有恶意，那看来他也没什么间谍可怕了。不是吗？"
    },
    {
      "id": "p05929-9f54c582c21b",
      "target": "可我们有证据，证明有人一直在向福丁布拉斯传递信件。这个间谍所做的，可不只是翻动国王的物品。"
    },
    {
      "id": "p05930-018c9aed9b1c",
      "target": "明白了。那么你要找的，是个恨克劳狄斯国王恨到想让他被废黜的人。"
    },
    {
      "id": "p05931-9b31de056c3f",
      "target": "换作是我，就会留意我眼皮底下那个脾气乖戾、情绪不稳的少年。"
    },
    {
      "id": "p05932-b7d7bf206f62",
      "target": "这还用说！他有怨要报，还有王位要夺回。"
    },
    {
      "id": "p05933-e39501f69083",
      "target": "呃，很有意思的推测。无论如何，您可以走了。谢谢您抽出时间，布莉特女士。"
    },
    {
      "id": "p05934-82e33b987e79",
      "target": "随时乐意效劳，好队长。我的意思是：别再这样折腾我了。我可是个很忙的姑娘。"
    },
    {
      "id": "p05935-fd591e590aa7",
      "target": "所以呢？你找我有什么事？奥菲莉娅连一件要紧的事都没说清楚。"
    },
    {
      "id": "p05936-835c8bd432a3",
      "target": "找您有什么事？没有啊，女士。"
    },
    {
      "id": "p05937-2ae446b7a4fc",
      "target": "呸！她就是在浪费我的时间。还真<i>像</i>她的作风。我走了。"
    },
    {
      "id": "p05938-dd64297b68a8",
      "target": "（对。那场会议还没开始……还没人知道间谍的事。）"
    },
    {
      "id": "p05939-96988486ac63",
      "target": "波洛涅斯大人。见到您总是令人愉快。"
    },
    {
      "id": "p05940-c62e03fb5dfc",
      "target": "小伙子，有什么需要我帮忙的？"
    },
    {
      "id": "p05941-903b91044e16",
      "target": "是为了国王那些令人不安的疑虑吗？"
    },
    {
      "id": "p05942-3c8bae8090a5",
      "target": "正是。您和我一样清楚，他最近有多么惶惶不安。"
    }
  ]
}
