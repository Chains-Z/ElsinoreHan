{
  "translations": [
    {
      "id": "p03299-dee934b0b6e6",
      "target": "时间能让再不情愿的心也变得柔软。时间会让男孩长成男人，让女孩成为满怀爱意的妻子。"
    },
    {
      "id": "p03300-cdef62a5618e",
      "target": "这个时节真是古怪。"
    },
    {
      "id": "p03301-863c01e5563e",
      "target": "每过一个小时，空气就更沉闷一些。"
    },
    {
      "id": "p03302-6a483e0e1935",
      "target": "你、你……你就是个该死的蠢货。"
    },
    {
      "id": "p03303-37cd05b2374b",
      "target": "你<i>喝醉了？</i>"
    },
    {
      "id": "p03304-ff6089dfeb88",
      "target": "还真像你会干的事。"
    },
    {
      "id": "p03305-aa448437428e",
      "target": "你根本就不爱她。"
    },
    {
      "id": "p03306-1ffc6285867d",
      "target": "布莉特。你不配当她的丈夫。"
    },
    {
      "id": "p03307-e480d8c1cc66",
      "target": "就为了这个？那桩该死的婚约？"
    },
    {
      "id": "p03308-5ae08e6f59cd",
      "target": "你<i>现在</i>又在胡说些什么？"
    },
    {
      "id": "p03309-4bdbe3aced85",
      "target": "你、你、你要娶她。我、我亲耳听她说的。因为她父亲希望如此。可她不想嫁给<b>你。</b>"
    },
    {
      "id": "p03310-72cca3d605c2",
      "target": "我<i>也</i>不想娶她。她成天只会冷嘲热讽。我觉得她很卑劣。"
    },
    {
      "id": "p03311-976dce3319e4",
      "target": "<i>你说她是什么？</i>"
    },
    {
      "id": "p03312-860371cf23ee",
      "target": "你就是个他妈的蠢货。"
    },
    {
      "id": "p03313-b00e152af80c",
      "target": "你大老远跑来，就为了跟我说这个？"
    },
    {
      "id": "p03314-01223abade11",
      "target": "你——你<i>杀了他。</i>你从小就认识他。可你还是杀了他。"
    },
    {
      "id": "p03315-a8a7a60267a6",
      "target": "你——你想<i>杀</i>他。你从小就认识他。可你还是想杀了他。"
    },
    {
      "id": "p03316-ba66b79d3eb9",
      "target": "我父亲一直对你很好，很和善，不是吗？他难道不是一位无可挑剔的绅士吗？"
    },
    {
      "id": "p03317-28187066098f",
      "target": "你从来就只会毁掉一切。一切。所有你碰过的东西。"
    },
    {
      "id": "p03318-eae5079ab777",
      "target": "你心里那个快把你撕裂的空洞，伤得最深的却是你身边所有人。"
    },
    {
      "id": "p03319-70af45be5695",
      "target": "要是你——干脆——就好得多了。"
    },
    {
      "id": "p03320-7e287f455337",
      "target": "你说得对。"
    },
    {
      "id": "p03321-63608acd0c6f",
      "target": "就像我以前跟你说过的——在<b>我把鲁特琴还给你的时候。</b>你说得对。我只会毁掉一切。"
    },
    {
      "id": "p03322-c3a734b59df4",
      "target": "现在，我想<i>创造</i>些什么，哪怕只有这一次。"
    },
    {
      "id": "p03323-7b0c7cc0b721",
      "target": "为此，我需要布莉特。我们两个都不满意这个安排。"
    },
    {
      "id": "p03324-a88222559a9d",
      "target": "你以为我不知道你爱她？"
    },
    {
      "id": "p03325-72af5602ef8d",
      "target": "我想<i>尊重</i>这份感情，雷欧提斯。"
    },
    {
      "id": "p03326-daf24c11771b",
      "target": "你父亲的事，我很抱歉。我从没想让那一晚落得那样的结局。真的。"
    },
    {
      "id": "p03327-f255aa6b5b1a",
      "target": "如果能回到过去，逆转发生过的一切，我一定会。"
    },
    {
      "id": "p03328-d522a34c9ab0",
      "target": "我是个病态、古怪的蠢货，也永远都会是。但从今以后……"
    },
    {
      "id": "p03329-c34d953847e7",
      "target": "你再也不用受我的烦扰了，雷欧提斯。我不会再给你和你身边的人添麻烦。我保证。"
    },
    {
      "id": "p03330-8604c5554655",
      "target": "你并不想这么做，雷欧提斯。"
    },
    {
      "id": "p03331-a630dcd65500",
      "target": "我认得那种神情。我也有过很多次。"
    },
    {
      "id": "p03332-4f5d36915482",
      "target": "走吧。离开我，我们就当这事从没发生过。"
    },
    {
      "id": "p03333-035e6f193c9c",
      "target": "他本来会杀了我的。"
    },
    {
      "id": "p03334-f1c95f104a76",
      "target": "死了倒清净。"
    },
    {
      "id": "p03335-20871dcbe813",
      "target": "他、他死了——"
    },
    {
      "id": "p03336-bfc79300395f",
      "target": "我都干了些什么？"
    },
    {
      "id": "p03337-9cbeb17283aa",
      "target": "怎么了？"
    },
    {
      "id": "p03338-7ff0128030b9",
      "target": "你现在的表情好奇怪。"
    },
    {
      "id": "p03339-fec67af8444b",
      "target": "他死了。"
    },
    {
      "id": "p03340-73a12a7f8e5d",
      "target": "他<i>死了。</i>"
    },
    {
      "id": "p03341-6131914c477e",
      "target": "你做了什么，雷欧提斯？"
    },
    {
      "id": "p03342-f83236db6f4a",
      "target": "不。你该不会……"
    },
    {
      "id": "p03343-c3d7f60ee569",
      "target": "我当时很生气，根本不知道自己在做什么。"
    },
    {
      "id": "p03344-408ebb18f386",
      "target": "我把哈姆雷特推下了城墙。哈姆雷特<i>死了。</i>是我杀了他。"
    },
    {
      "id": "p03345-eb55d7d5e707",
      "target": "过来，亲爱的。"
    },
    {
      "id": "p03346-969bfbe25246",
      "target": "现在我们会落得什么下场？"
    },
    {
      "id": "p03347-e9c918e27d3e",
      "target": "听着，雷欧提斯。仔细听我说。"
    },
    {
      "id": "p03348-98e6af8bcd1d",
      "target": "你的双手已经沾了血。可既然已经沾了，就必须再沾一次。"
    },
    {
      "id": "p03349-1fb813a59949",
      "target": "而现在我知道，你有勇气这么做。"
    },
    {
      "id": "p03350-23c3eac7a43e",
      "target": "其他贵族，包括我父亲，都想让克劳狄斯死。他是个不称职的国王。"
    },
    {
      "id": "p03351-e6fa4f7c7d35",
      "target": "其实，我父亲让我窥探他的宫廷，想办法除掉他。"
    },
    {
      "id": "p03352-a3e6a3753047",
      "target": "原来你就是那个让国王如此担心的间谍。"
    },
    {
      "id": "p03353-2b59e409eb47",
      "target": "你想过要杀我妹妹吗？"
    },
    {
      "id": "p03354-e097590b438c",
      "target": "我？伤害你妹妹？<i>当然</i>没有，亲爱的。只是无意中稍微吓着她了。"
    },
    {
      "id": "p03355-e27a807cb046",
      "target": "奥菲莉娅这个人特别<i>爱幻想</i>，你不觉得吗？"
    },
    {
      "id": "p03356-7b4c77aef928",
      "target": "你当然不会伤害我妹妹。我也不知道自己为什么会怀疑你。"
    },
    {
      "id": "p03357-cc074b7a97d2",
      "target": "（我早该知道，一直都是布莉特。）"
    },
    {
      "id": "p03358-b8ee8d8c5247",
      "target": "（如果我现在有所动作，她只会再杀我一次。我得另想办法。）"
    },
    {
      "id": "p03359-2ac600af7f02",
      "target": "我……我是。但相信我，雷欧提斯。除了克劳狄斯，我绝不会伤害任何人。"
    },
    {
      "id": "p03360-fd39a808c222",
      "target": "如果你能狠下心，让这双手再做些事，就能把整棵恶树连根拔起。"
    },
    {
      "id": "p03361-0cab6e59b386",
      "target": "等这些卑劣的男人都死了，你我就能留下来，安安稳稳地相爱。"
    },
    {
      "id": "p03362-a66df9e3808a",
      "target": "再也不会有人阻挠我们。明白吗？"
    },
    {
      "id": "p03363-dddb17711939",
      "target": "我来做。我会去见国王。我会取他的性命。这事该由我来。"
    },
    {
      "id": "p03364-3f31a47da4cf",
      "target": "现在无论做什么，我们都一起做。我会陪你去。"
    },
    {
      "id": "p03365-bf8b00b7dd13",
      "target": "你的双手已经沾了血。这件事永远无法被遗忘。但它可以化为我们强大的助力。"
    },
    {
      "id": "p03366-aa5ef69e80dc",
      "target": "其他贵族，包括我父亲，都想让克劳狄斯和哈姆雷特死。克劳狄斯是个<i>糟糕透顶</i>的国王。他的子民都恨他。"
    },
    {
      "id": "p03367-b7bfddc81841",
      "target": "他打算把我嫁给福丁布拉斯。与哈姆雷特的婚约不过是个幌子。可我从来都不愿意。你<i>知道</i>这是真的。"
    },
    {
      "id": "p03368-3de63a5e5390",
      "target": "他们两个都不在了，我们就能迅速巩固我对王位的继承权。我父亲会推动选举，让我当选。"
    },
    {
      "id": "p03369-300834c9fa14",
      "target": "我将成为<i>丹麦女王。</i>而你会成为我的王夫。再也没有人能阻止我爱你。"
    },
    {
      "id": "p03370-010065fc1ea5",
      "target": "现在不会。永远都不会。雷欧提斯，这对我们两个都是好事。我们<i>赢了。</i>"
    },
    {
      "id": "p03371-6b595e106b75",
      "target": "这和我想象的完全不一样。"
    },
    {
      "id": "p03372-989cc6b29704",
      "target": "我不知道该说什么。"
    },
    {
      "id": "p03373-919d41cf2099",
      "target": "不用再害怕了，亲爱的。"
    },
    {
      "id": "p03374-e910af3848f3",
      "target": "我会给福丁布拉斯王子传信，让他趁城堡虚弱，迅速直击埃尔西诺的心脏。"
    },
    {
      "id": "p03375-15014fbbc802",
      "target": "到那时，一切都会进展得很快。你会看到的。"
    },
    {
      "id": "p03376-c88d3662a02f",
      "target": "你做得对。有时候，正确的事与善良的事并不一致。"
    },
    {
      "id": "p03377-e8d87c87e9ee",
      "target": "但你要明白。这事<b>确实</b>做对了。哪怕心里并不好受。"
    },
    {
      "id": "p03378-7be441528cab",
      "target": "你知道必须做什么。"
    },
    {
      "id": "p03379-027d87241a76",
      "target": "我就是为此准备好了才来的。"
    },
    {
      "id": "p03380-cdb35e075a55",
      "target": "他就躺在那边，在自己的寝室里睡着。"
    },
    {
      "id": "p03381-033a9f462fb5",
      "target": "我去把这事办了。"
    },
    {
      "id": "p03382-8d378b75db20",
      "target": "什么？怎么了？办成了吗？"
    },
    {
      "id": "p03383-5e2a41082230",
      "target": "没有。没有，还没办成。他、他的脸——那张脸——"
    },
    {
      "id": "p03384-c42579e023b5",
      "target": "嘘。你会吵醒他的。到外面去。"
    },
    {
      "id": "p03385-8e9df2dd06cb",
      "target": "要不是克劳狄斯睡着的样子像我父亲，我早就下手了。"
    },
    {
      "id": "p03386-e1cabe467aac",
      "target": "我本可以下手。<i>一定会</i>下手。"
    },
    {
      "id": "p03387-a7689b70cf05",
      "target": "我看见……一把匕首悬在眼前，刀柄朝着我的手。"
    },
    {
      "id": "p03388-9e0801edc5ce",
      "target": "来，让我握住你。"
    },
    {
      "id": "p03389-8342dbf846cf",
      "target": "我——我握不住你——却依然看得见你——"
    },
    {
      "id": "p03390-4e37d51aaa7c",
      "target": "这是虚妄的幻象。致命的幻影。"
    },
    {
      "id": "p03391-964b06ccd619",
      "target": "可我<i>确实</i>仍看得见你，还有你刀刃上……一团团的血。"
    },
    {
      "id": "p03392-c5e9be0a8b33",
      "target": "不。根本没有这东西。"
    },
    {
      "id": "p03393-41e5ac0f7a53",
      "target": "我站在这里胡思乱想时，他还活着。"
    },
    {
      "id": "p03394-f13be4185525",
      "target": "这炽热的杀意，<i>绝不能</i>冷却。"
    },
    {
      "id": "p03395-66ce76436eba",
      "target": "这事就算成了。我几乎已经能听见卫兵敲响午夜的钟。"
    },
    {
      "id": "p03396-b873e0a423b0",
      "target": "可你听不见了，克劳狄斯，是不是？"
    },
    {
      "id": "p03397-533cba2970b4",
      "target": "那是丧钟。它召你去天堂——或是地狱。"
    },
    {
      "id": "p03398-9dcc58f36177",
      "target": "谁、谁在那儿？"
    },
    {
      "id": "p03399-1e82c09b6161",
      "target": "……只是一只猫头鹰。"
    },
    {
      "id": "p03400-75681e8c8c61",
      "target": "他现在一定……正在做<i>那件事</i>……一定是。"
    },
    {
      "id": "p03401-fc52b18f283f",
      "target": "事已办成。你听见什么声响了吗？"
    },
    {
      "id": "p03402-cafb4d8b4a7f",
      "target": "我听见猫头鹰尖叫，蟋蟀啼鸣。"
    },
    {
      "id": "p03403-99b73ec16b77",
      "target": "我的双手惨不忍睹。沾满了<i>他的</i>血。"
    },
    {
      "id": "p03404-bf9f1f3d6517",
      "target": "别说傻话。别说什么“惨不忍睹”。我们做了<i>不得不</i>做的事。"
    },
    {
      "id": "p03405-93a021ed227c",
      "target": "别去想我们做过的事。那会让我们发疯的。"
    },
    {
      "id": "p03406-a1e84183a0cd",
      "target": "我好像听见里面有个声音在低语。它喊着：“从此不得安眠。”像是诅咒。"
    },
    {
      "id": "p03407-faf4ba99e525",
      "target": "来。抬起头。洗洗你的手，我也洗洗我的。"
    },
    {
      "id": "p03408-f65eb4b6d66e",
      "target": "我的手和你的一样沾满了血，可要是我也像你这样闹个没完，我会觉得羞耻。"
    },
    {
      "id": "p03409-4c71e2864150",
      "target": "我们回你的房间吧。一点水就能洗掉这一切。"
    },
    {
      "id": "p03410-0a5d2647a553",
      "target": "克劳狄斯死了。本来就该如此。如今也就如此了。"
    },
    {
      "id": "p03411-c00e9d9f4146",
      "target": "我知道必须做什么。"
    },
    {
      "id": "p03412-218e2392fdc9",
      "target": "我眼前的是一把匕首吗？刀柄朝着我的手？"
    },
    {
      "id": "p03413-8770bc4d20b3",
      "target": "事已办成。"
    },
    {
      "id": "p03414-17b97d2b3095",
      "target": "我好像听见里面有个声音在低语。它喊着：“从此不得安眠。”像是诅咒。"
    },
    {
      "id": "p03415-f042e4acf39e",
      "target": "你跟我说过，你很害怕。"
    },
    {
      "id": "p03416-d29789ccbc7e",
      "target": "我想让你知道，我相信你。我相信你有危险。"
    },
    {
      "id": "p03417-d8d582e4a3b6",
      "target": "但如果你说的是真的——那你最好把调查交给我。"
    },
    {
      "id": "p03418-5a275dd7c5f6",
      "target": "为什么？"
    },
    {
      "id": "p03419-2610f3f8a886",
      "target": "因为如果有人<i>确实</i>想害你，那人早就在盯着你的一举一动了。"
    },
    {
      "id": "p03420-9e69609db91a",
      "target": "我不想让你再牵扯得更深。"
    },
    {
      "id": "p03421-aec4c0b5493c",
      "target": "所以……我打算找一个我完全信任的人帮忙。"
    },
    {
      "id": "p03422-6fd2881ca049",
      "target": "那人对埃尔西诺每个人的来往行踪都很了解，或许能帮我们缩小嫌疑人的范围。"
    },
    {
      "id": "p03423-2e0cb8592d7b",
      "target": "一个你“信任”的人？"
    },
    {
      "id": "p03424-0e64ae496c4e",
      "target": "具体是谁呢？"
    },
    {
      "id": "p03425-a0eaf38fd94e",
      "target": "你是我妹妹，可不代表你知道我<i>所有</i>的秘密啊。"
    },
    {
      "id": "p03426-45a38c3b84ae",
      "target": "（嗯。要是他不肯跟我说实话，或许我可以自己调查一下。）"
    },
    {
      "id": "p03427-b8336d50ebb2",
      "target": "一个“熟人”？"
    },
    {
      "id": "p03428-250314e7f4d3",
      "target": "你是说布莉特。"
    },
    {
      "id": "p03429-ab9da4d56d09",
      "target": "你怎么知道的？"
    },
    {
      "id": "p03430-53114586b19d",
      "target": "你有很多优点，雷欧提斯。可藏得住心思不在其中。"
    },
    {
      "id": "p03431-824ace184b69",
      "target": "说得没错。对，布莉特很擅长看透埃尔西诺的那些暗流，可以这么说。"
    },
    {
      "id": "p03432-a96f9d17470e",
      "target": "我会去见她，再弄清楚接下来该做什么。"
    },
    {
      "id": "p03433-b3a52d7aa14c",
      "target": "以前遇上这种事，我还有个能信任的人。"
    },
    {
      "id": "p03434-f16a85322ec5",
      "target": "可她原来是个骗子。所以现在只剩你和我了。"
    },
    {
      "id": "p03435-440cff2516f4",
      "target": "你跟我说的那些事，别再告诉别人了，好吗？我不希望这事引起不必要的恐慌。"
    },
    {
      "id": "p03436-a9d775f6ec6f",
      "target": "比尔吉塔女士，请留步。"
    },
    {
      "id": "p03437-79cecc362a97",
      "target": "我需要问您几个问题。"
    },
    {
      "id": "p03438-0da867a892d3",
      "target": "我的人已经开始搜查您的房间了。"
    },
    {
      "id": "p03439-cc59ff8e874a",
      "target": "他们可能会在那里找到什么，您想提前说明一下吗？"
    },
    {
      "id": "p03440-a769112d5d94",
      "target": "卫兵队长，你是在指控我什么吗？你想给我安上什么罪名？"
    },
    {
      "id": "p03441-5cb0e149eacb",
      "target": "眼下，您不妨先当作很快就会受到指控。"
    },
    {
      "id": "p03442-ddeecfee32f4",
      "target": "这一定是弄错了。说实话，王后若知道你扣押了她的一位侍女，一定会大发雷霆。"
    },
    {
      "id": "p03443-30633185fcb7",
      "target": "这一定是弄错了。说实话，像这样扣押一位贵族女士，丢的是你的脸。"
    },
    {
      "id": "p03444-10b92755ef61",
      "target": "为了王室的最大利益行事，我不需要王后的许可。"
    },
    {
      "id": "p03445-5264cb453e95",
      "target": "我的行动得到了王室的全权许可。形势已经变了，布莉特女士。"
    },
    {
      "id": "p03446-6bd0a6b98787",
      "target": "所以我再问您最后一次。在他们<i>找到</i>东西之前，您有什么想<i>告诉</i>我的吗？"
    },
    {
      "id": "p03447-91daa485a636",
      "target": "你在暗指什么？"
    },
    {
      "id": "p03448-013aa7846ec8",
      "target": "没有！什么都没有！别来烦我！"
    },
    {
      "id": "p03449-7586cf138640",
      "target": "我要走了。我正要去镇上。"
    },
    {
      "id": "p03450-cade6bfe406c",
      "target": "恐怕我不能让您离开城堡。"
    },
    {
      "id": "p03451-1a268fccf12a",
      "target": "您将被暂时拘押。"
    },
    {
      "id": "p03452-a829e6fab3d6",
      "target": "不！你<b>休想</b>把我关进那个烂地牢。你什么证据都没有！"
    },
    {
      "id": "p03453-a388716bed60",
      "target": "别挣扎了。必要的话，我可以把您扛在肩上带走。或者，您也可以挽着我的手臂，安安静静地跟我走。"
    },
    {
      "id": "p03454-21b608c1ca3c",
      "target": "我欠您一个道歉。"
    },
    {
      "id": "p03455-c4c006a9b8e4",
      "target": "为什么？"
    },
    {
      "id": "p03456-85076a7b0d48",
      "target": "我没有相信您。起初没有。请跟我来。"
    },
    {
      "id": "p03457-d4e5196d1a0c",
      "target": "因为我让您一直身处险境，直到现在。"
    },
    {
      "id": "p03458-fcaad329d6ab",
      "target": "雷欧提斯向我转达了您的担忧，起初我并不相信。请跟我来。"
    },
    {
      "id": "p03459-741f0f5ecb64",
      "target": "要看宣布消息吗？"
    },
    {
      "id": "p03460-2d56826f9873",
      "target": "各位，我带来了一个很不幸的消息。我们查出了城堡内的一些非法活动，综合来看，这些行为已构成叛国。"
    },
    {
      "id": "p03461-0c2ea30cc21b",
      "target": "今天早些时候，我逮捕了比尔吉塔女士。她现在已被拘押。"
    },
    {
      "id": "p03462-dee4503fed1c",
      "target": "布莉特？你是说，一直向挪威传递情报的人是<i>她</i>？"
    },
    {
      "id": "p03463-1c9565aede4f",
      "target": "虽然你之前已经跟我们说过，我还是难过得无法相信。我亲自欢迎布莉特女士来到宫廷。我们确定这是真的吗？"
    },
    {
      "id": "p03464-e0f91550be61",
      "target": "恐怕是的，王后。若不是奥菲莉娅女士参与其中，我们绝不会查出这层联系。"
    },
    {
      "id": "p03465-c7b1c9976c3f",
      "target": "一直向挪威传递情报的人是布莉特？"
    },
    {
      "id": "p03466-3a213ad9bf99",
      "target": "我知道布罗肯胡斯家族倾向于支持他们，但说实话，我没想到布莉特会做出这种事。"
    },
    {
      "id": "p03467-1cf7f957fda7",
      "target": "恐怕是的。若不是奥菲莉娅参与其中，我们绝不会查出这层联系。"
    },
    {
      "id": "p03468-67ede5c54162",
      "target": "必须像对待其他恶徒一样，给予她最严厉的惩罚。"
    },
    {
      "id": "p03469-08e84390588a",
      "target": "如果这是您的意愿，陛下。她现在就在地牢里。"
    }
  ]
}
