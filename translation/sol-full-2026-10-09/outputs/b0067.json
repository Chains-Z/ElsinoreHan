{
  "translations": [
    {
      "id": "p09560-519ab69eadba",
      "target": "而且，我觉得我们不能再继续这段私情了。"
    },
    {
      "id": "p09561-c855cb6d369e",
      "target": "啊。我明白了。是我太失礼了。当然……我们……不能这样。"
    },
    {
      "id": "p09562-b77d0aa0661d",
      "target": "你说得对。这一切发展得实在太快了。我现在明白了。"
    },
    {
      "id": "p09563-640e288a706b",
      "target": "我已经打扰得够久了。"
    },
    {
      "id": "p09564-d1953f343765",
      "target": "请别再打扰我了。我现在需要独处。"
    },
    {
      "id": "p09565-f4713dcb7bac",
      "target": "我以为你已经走了。"
    },
    {
      "id": "p09566-1c9193430b07",
      "target": "如果你想回自己的房间，当然随时可以走。"
    },
    {
      "id": "p09567-a0c0f2b7b6a5",
      "target": "奥菲莉娅。跟我来。我想给你看样东西。"
    },
    {
      "id": "p09568-eb87d4e01f99",
      "target": "请坐。"
    },
    {
      "id": "p09569-e64cc05df5ec",
      "target": "坐在王后的……？"
    },
    {
      "id": "p09570-42038fb16a78",
      "target": "我不忍心让它空着。它也不该一直空着。"
    },
    {
      "id": "p09571-1717d8fbcef8",
      "target": "我想，她会希望你坐在那里。"
    },
    {
      "id": "p09572-31380bb84cf7",
      "target": "感觉很奇怪。"
    },
    {
      "id": "p09573-10480a8ae8d8",
      "target": "可不知为什么——又很自然。"
    },
    {
      "id": "p09574-581a34657daa",
      "target": "就像我之前说的：你会是一位出色的王后。"
    },
    {
      "id": "p09575-0e97d356ce25",
      "target": "而且，丹麦终于迎来了和平，一切都如我所能期望的那般美好。"
    },
    {
      "id": "p09576-ba61d5580b20",
      "target": "那……做我的妻子……你……愿意……吗？"
    },
    {
      "id": "p09577-aedcca417218",
      "target": "订婚期会很长。能有多长就多长。给我们两个人都留些时间。"
    },
    {
      "id": "p09578-51b92087cc45",
      "target": "（这一切发展得太快了……）"
    },
    {
      "id": "p09579-a6871a5e2641",
      "target": "（不过，我也只剩下……一点时间了。也许值得沿着这条路走到最后。）"
    },
    {
      "id": "p09580-a9d50f327fed",
      "target": "接受克劳狄斯的订婚提议？"
    },
    {
      "id": "p09581-d0a0c8204430",
      "target": "我……从来没有在埃尔西诺找到属于自己的位置。"
    },
    {
      "id": "p09582-a211381e9634",
      "target": "也许是因为，我命中注定的位置就在这里，在这王座上。"
    },
    {
      "id": "p09583-d34027431b00",
      "target": "这桩婚事必须得到批准。当然，你的身份足够尊贵，但他们可能会质疑你母亲的血统。"
    },
    {
      "id": "p09584-dffc960e8a00",
      "target": "不过，我不会让这成为阻碍。"
    },
    {
      "id": "p09585-33444c7937d7",
      "target": "亲爱的，这个糟糕的夏天终究会有一个美好的结局。"
    },
    {
      "id": "p09586-202d81dc8ca9",
      "target": "我不能答应，克劳狄斯。对不起。"
    },
    {
      "id": "p09587-1a6fa807761b",
      "target": "我……这会……太过了。也太早了。"
    },
    {
      "id": "p09588-66623f5799b0",
      "target": "也许王后会希望如此，但也许她<i>不会。</i>"
    },
    {
      "id": "p09589-d7275eb3498e",
      "target": "她才去世没多久。这……感觉不妥。"
    },
    {
      "id": "p09590-eb8e62830359",
      "target": "是的，我明白。我当然明白。"
    },
    {
      "id": "p09591-eac5a6392178",
      "target": "请……原谅我。我不过是刚从一场短暂而可怕的梦中醒来。"
    },
    {
      "id": "p09592-c1dee604ed19",
      "target": "女士们，先生们，抱歉打扰各位。"
    },
    {
      "id": "p09593-f13d35bdec9a",
      "target": "发生了一些……令人不安的事情。在我和手下彻底调查清楚之前，城堡将处于紧急状态。"
    },
    {
      "id": "p09594-885f17061277",
      "target": "波洛涅斯大人昨夜在一场极为不幸的意外中突然身亡。他死于王子之手。"
    },
    {
      "id": "p09595-8a13741bce2b",
      "target": "那个<i>小子。</i>"
    },
    {
      "id": "p09596-21a901d4127b",
      "target": "我和手下仍在调查事情的经过。在这可怕的时刻，请各位体谅奥菲莉娅女士和雷欧提斯大人。"
    },
    {
      "id": "p09597-46fb7cd340f3",
      "target": "波洛涅斯大人一生都忠心为城堡效力。"
    },
    {
      "id": "p09598-8ff3d71ccf99",
      "target": "无论他的死有怎样的内情，让我们记住他生前的为人：他是克劳狄斯陛下坚定可靠的顾问，在此之前，也曾这样辅佐哈姆雷特国王。"
    },
    {
      "id": "p09599-775d6c213ad3",
      "target": "奥菲莉娅。我真的很难过。这太糟了。这一切都是。"
    },
    {
      "id": "p09600-aef4aea98e4b",
      "target": "有什么我能为你做的吗？你需要什么？"
    },
    {
      "id": "p09601-56e9d21258cf",
      "target": "不用。只要请你给我哥哥捎个信。"
    },
    {
      "id": "p09602-32d65de6a1b5",
      "target": "我到现在还觉得这不是真的，霍拉旭。"
    },
    {
      "id": "p09603-cb8a4a1a51eb",
      "target": "今天对自己好一点。慢慢来。"
    },
    {
      "id": "p09604-8c18597a4c6d",
      "target": "听说你父亲去世，我很难过。谁都不该亲眼目睹这样的事。"
    },
    {
      "id": "p09605-77a76db0b20c",
      "target": "很抱歉，要由我来告诉你这个消息。"
    },
    {
      "id": "p09606-a84221a901f9",
      "target": "你父亲去世了。"
    },
    {
      "id": "p09607-32400f9ee757",
      "target": "他与王子发生了……冲突。"
    },
    {
      "id": "p09608-118ce920e935",
      "target": "他与王后发生了……冲突。"
    },
    {
      "id": "p09609-21238ba09871",
      "target": "发生了一起……涉及国王陛下的事件。"
    },
    {
      "id": "p09610-65b24ada3abd",
      "target": "在国王的寝室里？"
    },
    {
      "id": "p09611-71045cccc0f9",
      "target": "是的。你怎么知道？"
    },
    {
      "id": "p09612-f3534b67782b",
      "target": "就当是直觉吧。"
    },
    {
      "id": "p09613-e0cde2dd860b",
      "target": "什么？可我以为父亲已经——"
    },
    {
      "id": "p09614-b620b73acc3f",
      "target": "（我以为我已经<i>救了</i>他。）"
    },
    {
      "id": "p09615-020c8188356c",
      "target": "发生了什么？他当时在哪里？"
    },
    {
      "id": "p09616-a8b2a9abfd9c",
      "target": "我只知道，你父亲当时在国王的寝室里，和他单独待在一起。"
    },
    {
      "id": "p09617-9470504a0b9b",
      "target": "后来，一名卫兵被叫了进去，却发现你父亲已经倒下了。"
    },
    {
      "id": "p09618-2424a1a2e355",
      "target": "国王说他突然昏倒了。有可能是自然死亡。"
    },
    {
      "id": "p09619-196eafd5f57d",
      "target": "有可能？我们说的可是<i>克劳狄斯</i>。"
    },
    {
      "id": "p09620-b05743e14d1d",
      "target": "我无从确定。你父亲去世时，我并不在场。"
    },
    {
      "id": "p09621-9c42325c07e6",
      "target": "既然不知道实情，我就只能相信国王对事情经过的说法。"
    },
    {
      "id": "p09622-10122542de9a",
      "target": "他突然结束了自己的生命。"
    },
    {
      "id": "p09623-d6670bd4f371",
      "target": "我知道，这样听到消息很难接受。很抱歉让你受到这样的冲击。"
    },
    {
      "id": "p09624-b1da8b852c73",
      "target": "（这一次，他死在我手里。即使这只是暂时的，还是让我很痛苦。）"
    },
    {
      "id": "p09625-9b14e4478fb8",
      "target": "女士，如果有什么我能做的……"
    },
    {
      "id": "p09626-59e38abb6852",
      "target": "不用了，贝尔纳多。没关系。我很快就会再见到他。"
    },
    {
      "id": "p09627-6432edb888a0",
      "target": "但愿如此。愿我们都能在天堂重聚。"
    },
    {
      "id": "p09628-4a8bbcb28c4b",
      "target": "天堂。当然。"
    },
    {
      "id": "p09629-79b8ad9b82c0",
      "target": "不过，我现在正全力查明真相。我想让你放心，我一定会尽力。"
    },
    {
      "id": "p09630-9b3d448e9b71",
      "target": "这一次，我终究还是没能救下他。"
    },
    {
      "id": "p09631-193303d8cf6e",
      "target": "没人敢认为这是你的错，奥菲莉娅。请别责怪自己。"
    },
    {
      "id": "p09632-668ea0e3addf",
      "target": "不。你错了。"
    },
    {
      "id": "p09633-08e043bca8c9",
      "target": "我<i>一定会</i>救下他。我必须做到。"
    },
    {
      "id": "p09634-c116b9cc2682",
      "target": "救、救下他？呃……"
    },
    {
      "id": "p09635-72c18a5dfc2b",
      "target": "女士，请……今晚好好休息。我们过些时候再谈。"
    },
    {
      "id": "p09636-d9118ac73662",
      "target": "他是个好人。一个了不起的人。"
    },
    {
      "id": "p09637-6168ee222037",
      "target": "但愿如此。愿我们都能在死后的世界重聚。"
    },
    {
      "id": "p09638-22a4245ce2c1",
      "target": "是啊。死后的世界。当然。"
    },
    {
      "id": "p09639-d3a5b7571f5c",
      "target": "这很难接受，抱歉。我该让你静一静。"
    },
    {
      "id": "p09640-da1ceebb8879",
      "target": "你哥哥已经得到消息了。你应该去找他。"
    },
    {
      "id": "p09641-8d1dcec2f610",
      "target": "我父亲……他有样东西想交给我。是他房间里那只箱子的钥匙。"
    },
    {
      "id": "p09642-f4605ad5154f",
      "target": "啊，是的。我们确实找到了这样的东西。"
    },
    {
      "id": "p09643-c6fbb8497953",
      "target": "现在归你了。女士，这点小事是我应该做的。"
    },
    {
      "id": "p09644-0da01cb7ea72",
      "target": "我真的很难过，奥菲莉娅。不过……我现在必须去通知城堡里的其他人。"
    },
    {
      "id": "p09645-76ccb8956143",
      "target": "……那是传令官的号角声。"
    },
    {
      "id": "p09646-36a645835794",
      "target": "出事了。"
    },
    {
      "id": "p09647-42085fea59c3",
      "target": "听取公告？"
    },
    {
      "id": "p09648-51fc225a8780",
      "target": "关于那个据称潜伏在我们之中的间谍，我有重要的新消息要宣布。"
    },
    {
      "id": "p09649-4c0d81bf152c",
      "target": "国王驾崩了。"
    },
    {
      "id": "p09650-3f62cff2e60f",
      "target": "因此，接下来几天将不举行任何节庆活动。我相信，他的离世让我们所有人都深感悲痛。"
    },
    {
      "id": "p09651-d01349579196",
      "target": "这是一场可怕的意外。请各位在此时给王后陛下留些空间，让她哀悼，慢慢平复伤痛。"
    },
    {
      "id": "p09652-c5532b7ed603",
      "target": "看来，王后陛下曾举起武器对付他。我仍在查明事情为什么会发生。"
    },
    {
      "id": "p09653-6603038b5c14",
      "target": "国王陛下和王子……嗯，他们之间发生了什么，还是由王子殿下来说明吧。"
    },
    {
      "id": "p09654-bfecf36e8c5d",
      "target": "毫无疑问，这是一场悲惨的意外。我们都会深切悼念他。"
    },
    {
      "id": "p09655-c8249c121e65",
      "target": "国王陛下和王子……唉。毫无疑问，这是一场悲惨的意外。我们都会深切悼念他。"
    },
    {
      "id": "p09656-4e3d7d2e069c",
      "target": "他被一名身份不明的凶手杀害。我们目前还不了解事情的来龙去脉。"
    },
    {
      "id": "p09657-f1df7796a28f",
      "target": "不过，我认为我们其他人目前面临的危险很小。我一有消息就会公布。"
    },
    {
      "id": "p09658-c025632bdca1",
      "target": "相信大多数人已经听说了，国王和王后在用餐时突然发病，不久后便双双身亡。"
    },
    {
      "id": "p09659-7b3c1f56fcd3",
      "target": "我们已确认，伊尔玛给他们两人下了毒。她当即认罪，现已被关押，并因所犯罪行正式获刑。"
    },
    {
      "id": "p09660-c0cae37ae17a",
      "target": "愿上帝让他们的灵魂安息。"
    },
    {
      "id": "p09661-d7e879773579",
      "target": "我们仍在努力查明事情的真相。"
    },
    {
      "id": "p09662-c0d63b50fe59",
      "target": "这也太惨了。我真不敢相信。"
    },
    {
      "id": "p09663-f6db30a8d3dc",
      "target": "（他真的死了。）"
    },
    {
      "id": "p09664-2d90f321d713",
      "target": "要我说，死得好。"
    },
    {
      "id": "p09665-dd2bb2b0c3d9",
      "target": "陛、陛下？"
    },
    {
      "id": "p09666-226fa99c59cf",
      "target": "贵族们很快就会召开会议，安排投票。在此期间，按照我们的惯例，通常应由哈姆雷特接手他叔父留下的职责。"
    },
    {
      "id": "p09667-038cd0c24682",
      "target": "殿下，您准备好了吗？"
    },
    {
      "id": "p09668-3b933192e6f1",
      "target": "我——如果这是我必须做的。"
    },
    {
      "id": "p09669-82ecd83d92e9",
      "target": "我需要——一点时间考虑。"
    },
    {
      "id": "p09670-9f3d2b11e81e",
      "target": "但我想，我自己的父亲会希望我这样做。希望我登上王位。"
    },
    {
      "id": "p09671-0c0e2b235681",
      "target": "王子殿下，您并非<i>必须</i>这样做。"
    },
    {
      "id": "p09672-ddbf3fa66617",
      "target": "拜托。给我一点时间就好。"
    },
    {
      "id": "p09673-b85d65cdd277",
      "target": "当然。遵从您的意愿。"
    },
    {
      "id": "p09674-5430c9e059d1",
      "target": "遗憾的是，哈姆雷特已经去世，如今没有人能立即继承王位。"
    },
    {
      "id": "p09675-948eed4ee3cf",
      "target": "丹麦的贵族们将在一周内召开会议，决定接下来最妥当的安排。"
    },
    {
      "id": "p09676-e478d61354c4",
      "target": "对我们所有人来说，这是一个黑暗的时刻。"
    },
    {
      "id": "p09677-7af7cf678d4e",
      "target": "而王后的离世，确实完全出乎意料。"
    },
    {
      "id": "p09678-c3d58db75a69",
      "target": "王后的离世完全出乎意料。"
    },
    {
      "id": "p09679-6bbc2e7db6b4",
      "target": "王后最亲近的知己竟会这样对她，实在令人难以想象。"
    },
    {
      "id": "p09680-a53e4e22d2ba",
      "target": "今天早上，我们在东侧城墙下的海滩上发现了她。"
    },
    {
      "id": "p09681-ac9bba95ac68",
      "target": "我们还不确定发生了什么，也不知道她去世时身边是否有人。"
    },
    {
      "id": "p09682-6d46622ebd82",
      "target": "她似乎是在与王子对峙时突然丧命的。"
    },
    {
      "id": "p09683-31449c345392",
      "target": "不、不……乔塔……"
    },
    {
      "id": "p09684-b3c3777e336c",
      "target": "真、真的吗？太可怕了。"
    },
    {
      "id": "p09685-23ebb3a49799",
      "target": "（他的脸色很苍白。我从没见他这么苍白过。不知道他会不会有事。）"
    },
    {
      "id": "p09686-bcd54984ac93",
      "target": "各位中有些人已经知道，哈姆雷特也过早地离开了我们。"
    },
    {
      "id": "p09687-6661a8e3a2af",
      "target": "各位中有些人已经知道，哈姆雷特过早地离开了我们。"
    },
    {
      "id": "p09688-697b446b0e48",
      "target": "他在与国王的决斗中落败了。"
    },
    {
      "id": "p09689-3d516ae77d9f",
      "target": "目前还没有找到王后，但我们希望很快就能找到她。"
    },
    {
      "id": "p09690-92fb53ef2268",
      "target": "他的遗体是在城墙下发现的。他当时——"
    },
    {
      "id": "p09691-5d2d7b8dc8c8",
      "target": "我希望再也不用看见那样的场面。"
    },
    {
      "id": "p09692-a1632363d7d9",
      "target": "一场极为不幸的意外。"
    },
    {
      "id": "p09693-6b54821f32f3",
      "target": "布莉特女士在他的房间里发现了他，当时那里只有他一个人。凶手的身份尚不清楚。"
    },
    {
      "id": "p09694-6a0a058c313e",
      "target": "他的遗体被发现时，就在他母亲的遗体旁边。"
    },
    {
      "id": "p09695-dfcd2eeede55",
      "target": "我们认为最有可能的是，他起了敌意，当时周围没有其他人，她被迫自卫。"
    },
    {
      "id": "p09696-9432773cb790",
      "target": "（如果我当时留下了……）"
    },
    {
      "id": "p09697-e02ae230f0ee",
      "target": "哈姆雷特是我一生的朋友。我会从心底深深地怀念他。"
    },
    {
      "id": "p09698-88099bc4c189",
      "target": "哈、哈姆雷特。这……感觉……不是真的。"
    },
    {
      "id": "p09699-30ec45dc8c72",
      "target": "国王和王子都已去世，我们如今还不清楚该何去何从。"
    },
    {
      "id": "p09700-5bc91e9aa756",
      "target": "恐怕在贵族们能够再次召开会议之前，王位都将空缺。"
    },
    {
      "id": "p09701-6536641566b6",
      "target": "我还必须遗憾地告诉各位，波洛涅斯大人也去世了。"
    },
    {
      "id": "p09702-b267f6141c49",
      "target": "他与哈姆雷特王子之间出了事。局势随后升级。"
    },
    {
      "id": "p09703-fba622dc6154",
      "target": "虽然这一结果不能归咎于他们任何一方，但这场悲惨的意外夺去了波洛涅斯大人的生命。"
    },
    {
      "id": "p09704-27ccbc6176fd",
      "target": "哈姆雷特的灵魂如今一定已无可救赎。"
    },
    {
      "id": "p09705-211fb8df2dab",
      "target": "更何况，突然去世的雷欧提斯也必须尽快安葬。"
    },
    {
      "id": "p09706-de330903d09c",
      "target": "（……我真的很抱歉，雷欧提斯。）"
    },
    {
      "id": "p09707-e0ef91ad2626",
      "target": "即使接连发生这些悲剧，我也履行了自己的职责。叛徒比尔吉塔已被处死。"
    },
    {
      "id": "p09708-47b986543152",
      "target": "叛徒比尔吉塔已被处死。"
    },
    {
      "id": "p09709-cf1b140da9ef",
      "target": "愿此事警示所有企图背叛王室的人。"
    },
    {
      "id": "p09710-c2d802da3dfc",
      "target": "那就这样吧。"
    },
    {
      "id": "p09711-428de8a7a611",
      "target": "各位，抱歉打扰了。但遇到这样的突然死亡，我们总该提高警惕。"
    },
    {
      "id": "p09712-d47e58c34a9d",
      "target": "请各位一旦发现任何令人不安的情况，就立刻向我报告。可以的话，请留在城堡内。"
    },
    {
      "id": "p09713-eae8b036ffb7",
      "target": "不了，我现在更想一个人待着。"
    },
    {
      "id": "p09714-05c6d65949eb",
      "target": "现在不行。我正忙着。"
    },
    {
      "id": "p09715-8118112ba2b0",
      "target": "再次见到你，真是太好了。"
    },
    {
      "id": "p09716-b653da035385",
      "target": "尤其是<i>上一次</i>发生了那样的事之后。"
    },
    {
      "id": "p09717-630966db73dc",
      "target": "你。你是不是……"
    },
    {
      "id": "p09718-fba0559f9afc",
      "target": "……我是不是还记得你？"
    },
    {
      "id": "p09719-ae4d327438ff",
      "target": "谢天谢地。我<i>没有</i>发疯。"
    },
    {
      "id": "p09720-d00d07cdffba",
      "target": "不知为什么，时间在重复。一切都这么奇怪。先是那个<b>可怕的梦</b>，现在又是这样。"
    },
    {
      "id": "p09721-12254e09f6f1",
      "target": "你父亲的死，然后是你自己的死。<b>你看到的幻象</b>想必已经向你展示了这样的命运。"
    },
    {
      "id": "p09722-3be2d5110d27",
      "target": "你怎么会<i>知道</i>这些事？"
    },
    {
      "id": "p09723-609f51763c79",
      "target": "是你让这些事发生的吗？你是什么——巫师？"
    },
    {
      "id": "p09724-0084c4ba9e44",
      "target": "不，不是我做的。我无意伤害你，奥菲莉娅女士。我只是想在你的旅途中<b>助你一臂之力</b>。"
    },
    {
      "id": "p09725-d918b014bb4a",
      "target": "就像我曾经帮助哈姆雷特国王陛下那样。"
    },
    {
      "id": "p09726-bca0fbd299eb",
      "target": "我的幻象是在预示未来吗？我父亲被谋杀的事还会不断发生吗？"
    },
    {
      "id": "p09727-464e7cb11d07",
      "target": "还、还有——也有人要来杀<i>我</i>，对不对？"
    },
    {
      "id": "p09728-65fffea7573e",
      "target": "谁能救我们？谁能保护我们？"
    },
    {
      "id": "p09729-585dd7f53546",
      "target": "是啊，谁呢，奥菲莉娅女士？"
    },
    {
      "id": "p09730-2ec6c7391119",
      "target": "遗憾的是，这条路必须独自走下去。而它也确实是一条孤独的路。"
    }
  ]
}
