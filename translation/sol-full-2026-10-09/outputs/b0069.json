{
  "translations": [
    {
      "id": "p09932-00172b2c4c7b",
      "target": "好了，好了。坐吧。"
    },
    {
      "id": "p09933-d8fd382d2cd6",
      "target": "两位女士想喝点什么？"
    },
    {
      "id": "p09934-321644fcb138",
      "target": "先生，给我们来几杯葡萄酒，杯子越大越好……"
    },
    {
      "id": "p09935-002284351cb3",
      "target": "叫我奥赛罗就好。没问题，马上来。"
    },
    {
      "id": "p09936-9ed3e16069fc",
      "target": "看你们的样子，就是为了男人烦心的女人。这种神情，我在<i>这家</i>酒馆里每天都能见到。"
    },
    {
      "id": "p09937-6b06a48af6fb",
      "target": "是她以前的情人。他彻底疯了。"
    },
    {
      "id": "p09938-e1ca30de2d86",
      "target": "萝茜，你看见他那副大吵大闹的样子了吗？还有他那古怪、神经兮兮的眼神？"
    },
    {
      "id": "p09939-1963a4435e73",
      "target": "他确实变得太快了。"
    },
    {
      "id": "p09940-949723165bb8",
      "target": "我说，萝茜，你不会觉得他……"
    },
    {
      "id": "p09941-1d50c671078c",
      "target": "当然。我想的<i>正是</i>这个。"
    },
    {
      "id": "p09942-4cc3f79c59fe",
      "target": "可要是真的，那……"
    },
    {
      "id": "p09943-abe1f8591a0a",
      "target": "哦，天哪。"
    },
    {
      "id": "p09944-af5a3c75df13",
      "target": "他怎么<i>敢</i>！"
    },
    {
      "id": "p09945-40f4ded20630",
      "target": "真<i>不敢相信</i>他会这样。"
    },
    {
      "id": "p09946-b7aca716c33d",
      "target": "呃。我好像漏听了什么关键的事。"
    },
    {
      "id": "p09947-f9aae77b5b85",
      "target": "你们在说什么？“他”是谁？“他”做了什么？"
    },
    {
      "id": "p09948-c076ec1489cd",
      "target": "（而且她们到底是怎么听懂对方在说什么的……？）"
    },
    {
      "id": "p09949-9f6aed94723f",
      "target": "这、这个，吉尔达和这个男人……有一段很长的往事。"
    },
    {
      "id": "p09950-7bfaab8a74dc",
      "target": "我们跟他说话时，他那副样子实在<i>不像</i>平时的他。"
    },
    {
      "id": "p09951-81feb928c358",
      "target": "他藏着什么秘密不肯说。我们也不确定会是什么。"
    },
    {
      "id": "p09952-5cb659e02de1",
      "target": "也许我们<i>其实知道</i>，因为那个秘密……"
    },
    {
      "id": "p09953-93b32fcaf164",
      "target": "……就是他爱上了别人。"
    },
    {
      "id": "p09954-f664e9e3d8fd",
      "target": "两位女士，这种事总是难免的。"
    },
    {
      "id": "p09955-afbddb0330af",
      "target": "奥赛罗，要是你爱的人另有新欢，你会怎么办？"
    },
    {
      "id": "p09956-d6f0269c9c63",
      "target": "我？嗯，说实在的，我从没爱得那么深过。"
    },
    {
      "id": "p09957-acc87931ff5d",
      "target": "我更愿意相信自己生性坦荡。别人看起来诚实，我就相信他们诚实。"
    },
    {
      "id": "p09958-782cfd386584",
      "target": "曾经有人说我很容易被牵着走，像头驴一样……"
    },
    {
      "id": "p09959-b81129316cea",
      "target": "所以，我想我会尽力支持他们在一起。这样才公平，不是吗？"
    },
    {
      "id": "p09960-4112c7eaf916",
      "target": "如果你爱那个人，就也会爱那个人<i>去爱别人这件事</i>，因为那能带来莫大的幸福。"
    },
    {
      "id": "p09961-57443e59ad02",
      "target": "而如果那个人爱的不是你……你就必须为了那个人的幸福，放下自己的感情。"
    },
    {
      "id": "p09962-e137e440bdff",
      "target": "可是……这也……太理智、太成熟了！"
    },
    {
      "id": "p09963-3fd1f23c6a84",
      "target": "我平时<i>实在</i>太小心眼，可想不到这些。"
    },
    {
      "id": "p09964-56ca513ff2a1",
      "target": "（而照奎因斯的说法，奥赛罗其实也一样……）"
    },
    {
      "id": "p09965-3710109fa144",
      "target": "不起眼的酒馆老板，你倒比看上去明智一点。"
    },
    {
      "id": "p09966-b11ed1900111",
      "target": "不过，他说得对。哈姆雷特并不欠我什么。"
    },
    {
      "id": "p09967-14b21f94ac28",
      "target": "不管他心里在想什么，显然他最近都没怎么想起我。"
    },
    {
      "id": "p09968-3c269c6c2d42",
      "target": "那你也该只为自己着想。"
    },
    {
      "id": "p09969-728754257095",
      "target": "找个新的心上人吧。"
    },
    {
      "id": "p09970-e1b30f0a49e4",
      "target": "哦，没关系，萝茜。你知道，说到底，我眼里<i>真正</i>在意的始终只有你。"
    },
    {
      "id": "p09971-d583eefd38d7",
      "target": "我也只在意你，我的小影子。"
    },
    {
      "id": "p09972-094ce04bc82d",
      "target": "干杯。这值得喝一杯。"
    },
    {
      "id": "p09973-4b75c7caeff0",
      "target": "为新的爱情干杯！"
    },
    {
      "id": "p09974-71ced6de6230",
      "target": "为忘掉旧爱干杯！"
    },
    {
      "id": "p09975-42cd0f9f59e3",
      "target": "也为友谊干杯！"
    },
    {
      "id": "p09976-71b15899171e",
      "target": "老头，你不是该去值勤吗？"
    },
    {
      "id": "p09977-59179b702a3a",
      "target": "是啊！我也想问你这话呢，老太婆。"
    },
    {
      "id": "p09978-924acf77e0c3",
      "target": "难怪你晚饭做的炖菜总有半桶葡萄酒的味儿，是不是？原来你跑这儿喝酒来了！"
    },
    {
      "id": "p09979-70408be17e52",
      "target": "别管我这些坏习惯了。到了这把年纪，我就剩它们这些朋友了。"
    },
    {
      "id": "p09980-1fae0281591c",
      "target": "哟，哟！我还以为<i>咱俩</i>是朋友呢。"
    },
    {
      "id": "p09981-eea7f8c7733c",
      "target": "你？呸。从来就不是。"
    },
    {
      "id": "p09982-f7ef4524450e",
      "target": "话说回来，你到这儿干什么？"
    },
    {
      "id": "p09983-c2475164d325",
      "target": "来看我孙女。那小娃娃已经不是小娃娃了。她现在都会走路了。"
    },
    {
      "id": "p09984-1b0e1824a668",
      "target": "<i>你</i>还有孩子？"
    },
    {
      "id": "p09985-6ccb6147dc4b",
      "target": "十三个呢！"
    },
    {
      "id": "p09986-ee39407d700a",
      "target": "你从没提过他们。你怎么养得起这么多张嘴？"
    },
    {
      "id": "p09987-7d4db1dd2f34",
      "target": "嗯，如今他们都长大了，自己养活自己不成问题。不过你也知道，有些年头可不好过。"
    },
    {
      "id": "p09988-6c7abdee12cc",
      "target": "我亲爱的伊莎贝拉还在世的时候，把十三个孩子管得像一支军队。"
    },
    {
      "id": "p09989-e9917b5beb8e",
      "target": "她让大的照看小的，所有人都得种地、操持家务。"
    },
    {
      "id": "p09990-9b90d4e217d4",
      "target": "想想看，她跟你还挺像。真是浑身带刺。"
    },
    {
      "id": "p09991-426d2cfa5681",
      "target": "说话注意点。我好歹还算个淑女，听了这话也会生气。"
    },
    {
      "id": "p09992-259d9a2b0d12",
      "target": "最小的孩子现在多大了？"
    },
    {
      "id": "p09993-c74b11586956",
      "target": "十四岁。她也已经嫁人了。可给她爹长脸了。"
    },
    {
      "id": "p09994-62c6734e185d",
      "target": "她叫安娜。最大的那个，亚历山大，两鬓都白了，就跟我一样。"
    },
    {
      "id": "p09995-ef9d688d1e9a",
      "target": "亚历山大？是说……"
    },
    {
      "id": "p09996-7d2d9a6456de",
      "target": "对。亚历山大国王。我在埃尔西诺最早效忠的人，也是最伟大的一位。"
    },
    {
      "id": "p09997-ffea1c1598fb",
      "target": "我侍奉的乔特鲁德王后似乎认为……他是个相当残酷的人。"
    },
    {
      "id": "p09998-1e6246851526",
      "target": "最伟大，<i>也</i>最残酷。你以为哈姆雷特和克劳狄斯那股狠劲儿是从哪来的？"
    },
    {
      "id": "p09999-577cde0acfd3",
      "target": "啊，只要他们没能时刻表现得体、坚强，亚历山大就会毫不犹豫地揍他们！"
    },
    {
      "id": "p10000-a137a85ffa3e",
      "target": "不过你知道，他对那些在战场上为他效命的人也是这么管教的。包括我。"
    },
    {
      "id": "p10001-90f5d37bfd1d",
      "target": "这让我们都更出色了。我们个个像钢铁一样！打起仗来拼了命！我们打跑了敌人十几回。"
    },
    {
      "id": "p10002-576af8d50f19",
      "target": "这样一来，他的赏赐就更让人痛快了。那酒桶又圆又大，三个人手拉手都围不住。"
    },
    {
      "id": "p10003-a8c2855b7241",
      "target": "亚历山大国王管教人确实有一套，谁也比不上。我用他的名字给儿子取名，心里可自豪了。"
    },
    {
      "id": "p10004-d6836bf09160",
      "target": "看到他的孙子变成这副样子，真是既可惜又丢人。不知道亚历山大国王会怎么说。"
    },
    {
      "id": "p10005-0b672c849dfc",
      "target": "嗯，你也知道。再好的树，偶尔也会结出个长得怪模怪样的果子。"
    },
    {
      "id": "p10006-6fce6475c25a",
      "target": "那个果子确实够怪模怪样的。"
    },
    {
      "id": "p10007-c524cbf3d5d9",
      "target": "那你呢？你的孩子现在在哪儿？"
    },
    {
      "id": "p10008-1920173a29d6",
      "target": "我发现自己怀孕后不久，丈夫就死了。他摔到一辆马车底下，被马踩死了。"
    },
    {
      "id": "p10009-0a4b7e543398",
      "target": "可我发誓要建立一个美好的家庭，一边为他不朽的灵魂祈祷，一边继续过下去。"
    },
    {
      "id": "p10010-d931b1c5267c",
      "target": "我生下了女儿。玛丽。"
    },
    {
      "id": "p10011-08de205b22f5",
      "target": "她是个体弱多病的小家伙。出生时几乎还没我的手大。而且她不哭。"
    },
    {
      "id": "p10012-8d24eb4bbca6",
      "target": "我以为那说明她是个安静的孩子。我记得自己惊喜地对医生说——“我这安安静静的孩子，多奇妙啊，是不是？”"
    },
    {
      "id": "p10013-a4fb870cd8e0",
      "target": "可是，不哭并不是好事。那说明她的肺很弱。她呼吸时会发出微弱的咯咯声。"
    },
    {
      "id": "p10014-82e197df81ce",
      "target": "玛丽出生的那一晚，乔特鲁德王后陛下也出生了。他们叫她小格尔塔。"
    },
    {
      "id": "p10015-5b294ea0a8bb",
      "target": "乔特鲁德很健康，可她母亲没有奶水。所以他们把她送到了我这里。"
    },
    {
      "id": "p10016-3aaecb1a2602",
      "target": "我同时给她和玛丽喂奶，把她们搂在怀里，低头看着她们的脸。"
    },
    {
      "id": "p10017-c438742b42c7",
      "target": "格尔塔咿咿呀呀地笑着，连那时候，她的眼里就已经满是好奇。"
    },
    {
      "id": "p10018-0e6be9697bec",
      "target": "可我的女儿玛丽——她什么也不看。她不肯吃我的奶。也不怎么动。"
    },
    {
      "id": "p10019-d2fcaa6cb2e6",
      "target": "我眼看着一个孩子日渐衰弱，另一个却茁壮成长。"
    },
    {
      "id": "p10020-18976bc72553",
      "target": "一天早上，我伸手去抱女儿，她小小的身子已经冰冷了。我叫来了神父。"
    },
    {
      "id": "p10021-fb5b8b3ff2b4",
      "target": "他们从我身边带走了她，把她埋了。"
    },
    {
      "id": "p10022-c6c74bf6512b",
      "target": "而我继续给格尔塔喂奶，小小的格尔塔，一天比一天长得大。"
    },
    {
      "id": "p10023-3a357c8c2ca1",
      "target": "如今格尔塔已经长大成人，嫁了人，成了一位优雅的女子，正如我一直相信她会成为的那样。"
    },
    {
      "id": "p10024-92b837e00fe0",
      "target": "唉，该死，伊尔玛。我一点都不知道。"
    },
    {
      "id": "p10025-23a086092a7d",
      "target": "你知道……"
    },
    {
      "id": "p10026-c919028d66fa",
      "target": "要是能让你好受一点，下回打牌，你可以把我的钱全赢走。"
    },
    {
      "id": "p10027-f0b1e4c9282e",
      "target": "嗯。把你们的钱赢个精光时，你们那一张张又胖又红的脸上绝望的神情，<i>确实</i>让我很欣慰。"
    },
    {
      "id": "p10028-8791f97e80fb",
      "target": "好了，先别得意得太早，你这坏老太婆。"
    },
    {
      "id": "p10029-38e1fc9f9ed7",
      "target": "坏也比蠢强。"
    },
    {
      "id": "p10030-97ec91acecd8",
      "target": "嘿，我就以当个蠢蛋为荣。聪明从来没让谁捞到好处。"
    },
    {
      "id": "p10031-3e50d59b008d",
      "target": "瞧瞧咱俩。两个醉醺醺的老傻瓜，在这儿互相挖苦。咱们都有更该去的地方。"
    },
    {
      "id": "p10032-9c5b41b8bdf1",
      "target": "唉。我宁可留在这儿陪你喝酒。回头让贝尔纳多数落我去吧。"
    },
    {
      "id": "p10033-2558ca24abe2",
      "target": "那就……干杯。敬那些被人遗忘的老人。"
    },
    {
      "id": "p10034-96e7dc3d7118",
      "target": "<i>我的春天，我的欢喜，我的白昼，我的挚爱，我含笑的玫瑰……</i>"
    },
    {
      "id": "p10035-8c4c4d3217eb",
      "target": "<i>我的欢乐，我的美酒，我的酒馆，我的灯，我的光，我的烛火……</i>"
    },
    {
      "id": "p10036-835a9d3f5bf1",
      "target": "奥赛罗，你这是在做什么呢？"
    },
    {
      "id": "p10037-da28f82dcc22",
      "target": "啊，只是一时兴起。这东西走音了。"
    },
    {
      "id": "p10038-de87e5f59c49",
      "target": "我听着音倒挺准。"
    },
    {
      "id": "p10039-9fe63f6538f7",
      "target": "而且我最喜欢有人为我唱情歌了。尤其是强壮又沉默寡言的那种。"
    },
    {
      "id": "p10040-a19cf7ca69db",
      "target": "我？沉默寡言？你一定是在开玩笑。"
    },
    {
      "id": "p10041-d61c543efc6b",
      "target": "嗯。说得很对。那就只说强壮吧。"
    },
    {
      "id": "p10042-c31301b2c95b",
      "target": "你想听什么？"
    },
    {
      "id": "p10043-15a809a5448c",
      "target": "哦，有支老曲子，我以前在军营里常听到……"
    },
    {
      "id": "p10044-cdec1aea6980",
      "target": "<i>军营？</i>你当过兵？"
    },
    {
      "id": "p10045-1c5dd4265df3",
      "target": "啊，信不信由你……以前当过。哈姆雷特国王和挪威那场臭名昭著的三年棋局里，我就在他麾下。"
    },
    {
      "id": "p10046-2e5d0b1f6e67",
      "target": "在我的家乡，三年对一场战争来说，不过是一眨眼的工夫。"
    },
    {
      "id": "p10047-dc3ce0a04472",
      "target": "两国之间只有一星期的路程，打上三年就像永远也打不完。"
    },
    {
      "id": "p10048-7da797d89130",
      "target": "不过，我恐怕不适合那种生活。比起没完没了地虚张声势、舞刀弄剑，我更喜欢心平气和地讲道理。"
    },
    {
      "id": "p10049-06a16a83775f",
      "target": "而<i>我</i>更喜欢拿把真刀来舞。"
    },
    {
      "id": "p10050-f7c79a0a101d",
      "target": "你看起来像个老兵。你打过哪场仗？"
    },
    {
      "id": "p10051-9357cb55267c",
      "target": "<i>哪场</i>仗？当然是土耳其人对所有不肯向苏丹低头的人发动的那场无休无止的战争。"
    },
    {
      "id": "p10052-330351368956",
      "target": "我听命于苏丹十多年，为了他的事业与外国人作战。我砍下过成千上万人的头颅。"
    },
    {
      "id": "p10053-23f8430c193c",
      "target": "奇怪的是，我觉得这还挺有魅力。说不定还挺撩人。"
    },
    {
      "id": "p10054-556e5cde8021",
      "target": "哼。嗯，我敢肯定，这儿有不少男人都愿意……抓住你的脑袋。"
    },
    {
      "id": "p10055-09ec8c6d48fa",
      "target": "那十年快结束时，我已经是苏丹麾下的一名维齐尔了。我拥有许多花园和珍宝。这里简直像另一个世界。"
    },
    {
      "id": "p10056-adc560953468",
      "target": "你放弃了那一切，跑到这个腐烂、满是苍白面孔的小国家来？到底为什么？"
    },
    {
      "id": "p10057-0e647b3ada9b",
      "target": "因为那一切并不真正属于我。我是奥斯曼帝国的奴隶。我做的每一件事都以主人的名义，即便我的地位已经超过了他。"
    },
    {
      "id": "p10058-27e820060c7e",
      "target": "事实上，我主人的名字——“哈利勒”——就明明白白地加在我的名字后面。我渴望做自己的主人。所以我逃走了。"
    },
    {
      "id": "p10059-be0eccf02027",
      "target": "我想，君士坦丁堡如今已经不欢迎你了。"
    },
    {
      "id": "p10060-cf0e60a58f56",
      "target": "我相信他们会欢迎我的。直接把我迎进行刑室。"
    },
    {
      "id": "p10061-d63022bcee5a",
      "target": "呵。照丹麦如今的势头，你在这儿的命运也未必会更好。"
    },
    {
      "id": "p10062-cea40b3170a3",
      "target": "是啊。真可惜。"
    },
    {
      "id": "p10063-e26b9964d13c",
      "target": "……至少我们还有音乐。"
    },
    {
      "id": "p10064-718fcd9cf4a8",
      "target": "只有它能跨越语言和国界。"
    },
    {
      "id": "p10065-4904a62bb4a6",
      "target": "就连舞蹈也可能冒犯人。但音乐永不消亡。"
    },
    {
      "id": "p10066-a7c8d50788b9",
      "target": "祝你顺利把那把鲁特琴的音调准。"
    },
    {
      "id": "p10067-55ce8b8ee099",
      "target": "谢了，朋友。看情况吧。"
    },
    {
      "id": "p10068-59346d774d65",
      "target": "时候到了，我高贵的女士们。赶紧动起来。"
    },
    {
      "id": "p10069-72fa73910ff6",
      "target": "这、这、这是剥削！"
    },
    {
      "id": "p10070-93c3853c2e36",
      "target": "没错！这太人道了！"
    },
    {
      "id": "p10071-47f516406fef",
      "target": "你是想说<b>不</b>人道，吉尔达。"
    },
    {
      "id": "p10072-21ee3ad23367",
      "target": "我就是这么说的！"
    },
    {
      "id": "p10073-498efb2b948d",
      "target": "还需要我提醒你们欠了我多少钱吗？"
    },
    {
      "id": "p10074-de65a98fc79c",
      "target": "五年来，你们在我的牌桌上每一局都输。<i>还得加上</i>利息。"
    },
    {
      "id": "p10075-72e6d804fda2",
      "target": "这钱必须还我，哪怕要把你们俩身上那些漂亮裙子扒下来卖掉！"
    },
    {
      "id": "p10076-3c3339acbade",
      "target": "我们之前还帮你找食材了！"
    },
    {
      "id": "p10077-b9657818aae2",
      "target": "呸！你们以为那就够抵债了？差得远呢！"
    },
    {
      "id": "p10078-72301ce1dc33",
      "target": "我们以前确实没把钱还给伊尔玛……"
    },
    {
      "id": "p10079-6196cf29ffcb",
      "target": "但我得承认，我以为她早就忘了。"
    },
    {
      "id": "p10080-89396c988d11",
      "target": "再、再说，我以为我们这会儿早就溜出城了。"
    },
    {
      "id": "p10081-3148ddb727d2",
      "target": "我们本来只打算<i>待一小会儿</i>。致个意就走！"
    },
    {
      "id": "p10082-0a380dd69327",
      "target": "够了！现在！开始！"
    },
    {
      "id": "p10083-e79dd922f8b1",
      "target": "呃！好吧！"
    },
    {
      "id": "p10084-11881a91aaa3",
      "target": "（你来唱。我来，呃，给你精神上的支持。）"
    },
    {
      "id": "p10085-7178860e2c38",
      "target": "（为什么每次都是<i>我</i>来唱？！）"
    },
    {
      "id": "p10086-df2903ebb48a",
      "target": "<i>不、不朽的阿佛洛狄忒，端坐于繁花之上……</i>"
    },
    {
      "id": "p10087-b79477be4d8a",
      "target": "<i>女神啊，莫再摧折我的心魂！</i>"
    },
    {
      "id": "p10088-86bf7afa16ba",
      "target": "<i>再听这呼声！啊，请听，请聆听！</i>"
    },
    {
      "id": "p10089-f98195fa0708",
      "target": "<i>来吧，如那海岛黎明时你曾降临……</i>"
    },
    {
      "id": "p10090-bbcfb38505da",
      "target": "<i>听见我的恳求，从你父亲的金色宫殿而来！</i>"
    },
    {
      "id": "p10091-f895480cb98c",
      "target": "呃，后面怎么唱来着？"
    },
    {
      "id": "p10092-0e41a084b9f6",
      "target": "<i>女神啊，你骤然光芒四射，站在我面前……</i>"
    },
    {
      "id": "p10093-73f82267cba3",
      "target": "<i>你问我受何苦楚，又是谁令我悲伤……</i>"
    },
    {
      "id": "p10094-1a3df86360f1",
      "target": "<i>“如今她逃离你，不久却会追寻你；”</i>"
    }
  ]
}
