[
  {
    "id": "p15102-c1074a9ae5c0",
    "source": "Well, yeh know how court formalities are, milady. I don't make the rules'.",
    "source_sha256": "c1074a9ae5c01dcd8ea50ef65966acb4316c2f6f521fed7396b6aedd089176ee",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2112707"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "marcellus_LaertesisLate",
      "speaker": "Marcellus",
      "cues": "{Yeah_Well}",
      "line": 118,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15103-9cabdb75e005",
    "source": "You'll probably find him... in the Great Hall!",
    "source_sha256": "9cabdb75e005a1734ebf51f6936b495a838dcab7760fd4f5207686f9b17c1933",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2112858"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "marcellus_LaertesisLate",
      "speaker": "Marcellus",
      "cues": "{Yes_Excited}",
      "line": 122,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15104-88624f049497",
    "source": "Very dramatic, Marcellus.",
    "source_sha256": "88624f0494972b7e9095224484ed31736e3eb1c504b6493bfdff34439ac09197",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2112952"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "marcellus_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "[smile] {I_See}",
      "line": 123,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15105-05c2b37aa8f0",
    "source": "Just tryin' ta be helpful!",
    "source_sha256": "05c2b37aa8f0a8d64c77fc3168122eccc498681a33e082b2a4c16ef42ee54a00",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113004"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "marcellus_LaertesisLate",
      "speaker": "Marcellus",
      "cues": "[happy] {Laugh}",
      "line": 126,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15106-48ba569b2463",
    "source": "<i>Psst!</i> Have you spoken to Father today? He's in a fit!",
    "source_sha256": "48ba569b24632e1ea0230272fa188025a90dd754ed167906cafee01b7a49ba93",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113058"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "laertes_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "{Laertes}",
      "line": 132,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15107-1952a40ec6b1",
    "source": "Ah! Right! I'd completely forgotten. My mind's on Paris already.",
    "source_sha256": "1952a40ec6b13840c4e88a18c80f221a8676acf0438d581e57bc448a7a3df647",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113180"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "laertes_LaertesisLate",
      "speaker": "Laertes",
      "cues": "[surprise] {What}",
      "line": 134,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15108-63d0207b6b4e",
    "source": "Hamlet and I both are waiting for an audience with the King, but it's dragging on.",
    "source_sha256": "63d0207b6b4e8791fa687ffd07e027e0d2925d70931dc611282112806d5adfa7",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113311"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "laertes_LaertesisLate",
      "speaker": "Laertes",
      "cues": "",
      "line": 136,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15109-ec2157f4cdc7",
    "source": "Won't you speak to the Queen, Ophelia? She's fond of you. She can move this meeting along.",
    "source_sha256": "ec2157f4cdc74d67206c9d058cd26895789f72c9becbfb1bd6657dde71dcaa7d",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113478"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "laertes_LaertesisLate",
      "speaker": "Laertes",
      "cues": "{Hmm}",
      "line": 139,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15110-c620b28f1f38",
    "source": "My father desires to speak with Laertes.",
    "source_sha256": "c620b28f1f38b53e75eefd6547770407ad92ea988e3db306651efb63fa9fdb97",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113661"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "{Lady_Birgetta}",
      "line": 144,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15111-32a451fe1ce4",
    "source": "If Laertes leaves, this already-desolate place will become a lot more dismal.",
    "source_sha256": "32a451fe1ce49ab91d937a19dee7c9a3bf01f001bbff5cfa9f53af1bfcfe29b6",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113743"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "{Laertes_Sad}",
      "line": 146,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15112-ca6fc79831fc",
    "source": "Somehow, I feel this is thoroughly your fault.",
    "source_sha256": "ca6fc79831fc508cb4731804f9182219e3e96d8a94c3f05a643bbbeb340a67f7",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2113900"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "",
      "line": 147,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15113-353790a8f441",
    "source": "You could have convinced him to stay, couldn't you?",
    "source_sha256": "353790a8f441ae8a8026c8e74b0357e5687facce555c5010c5e5220937bfbb21",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2114010"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "",
      "line": 151,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15114-8df4240a711b",
    "source": "I don't control my brother—or his itinerary, for that matter.",
    "source_sha256": "8df4240a711b60f4b180fb96643ef015b00e462ccd9b16118635adda28b497c9",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2114114"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "",
      "line": 153,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15115-561e72753ecc",
    "source": "Hmmph. Now what will I do? Being a lady-in-waiting is so dismal! Attending to the Queen's every little whim, following her from court function to court function...",
    "source_sha256": "561e72753eccd3a0e33ad7f078ca105e0fff429b6af1681ba93cced431cb65ad",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2114238"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "{Disgust}",
      "line": 155,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15116-6276f1baf816",
    "source": "It's <i>tedious</i>, Lady Ophelia. If only I were a sad little half-rank girl with no prospects like you. Then I'd be excused from this banality.",
    "source_sha256": "6276f1baf8167996464a029132051d5fb087b987f0251b8aa02c12c3f8750c6e",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2114567"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "",
      "line": 157,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15117-6b99460d703b",
    "source": "Just tell me where he is, Brit.",
    "source_sha256": "6b99460d703bba643097b90a752f778b7911d425469b71b12bbe70f5860ec972",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2114860"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "[disgust] {Disgust}",
      "line": 159,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15118-bd3737a36f38",
    "source": "...You see the door to the Great Hall there. Fetch him yourself. I'm not your scullery maid.",
    "source_sha256": "bd3737a36f38b526fd293983ba104abc9fbf8fee27c8986911523c65a095554a",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2114924"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "{Hmm_Bored}",
      "line": 164,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15119-1cc674fe889e",
    "source": "...Perhaps if he's late enough, he won't have to go to Paris after all...",
    "source_sha256": "1cc674fe889ee6d43e8d59ea79d9f01cbf4579c1177dbc9bdb5ba935886bd4ac",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2115111"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "[sad]",
      "line": 166,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15120-c8b6a213b755",
    "source": "Unlikely. A French coastal gale is calling his name.",
    "source_sha256": "c8b6a213b7553e089042aec07e181d2ee2ac788eff9ace9ad45edd807b8b1f6d",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2115260"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "[smile] {No_Rediculous}",
      "line": 168,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15121-c1304f1f272f",
    "source": "Oh, what a divine punishment it is for him to sail off to France, leaving me with the boring sibling...",
    "source_sha256": "c1304f1f272f3d57a4fe134427976b53e97549c33847195f47daeb004c9b705f",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2115366"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "[disgust] {Sigh}",
      "line": 171,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15122-0bb19435147c",
    "source": "Sorry to disappoint.",
    "source_sha256": "0bb19435147c880d635360d67efc87b905106a4f13e6d6122ad009c7a1204112",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2115575"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "[disgust] {Disgust}",
      "line": 172,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15123-488ca83a195c",
    "source": "Alas, can't be helped. You've got disappointment written all over you. Poor little orphan girl.",
    "source_sha256": "488ca83a195cd1aa3b443137a77e45a6b298d5e7217a77864dbc2f41ab802a90",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2115617"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "{Hmm_Bored}",
      "line": 174,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15124-3cd624871fb2",
    "source": "You may be the Queen's lady-in-waiting, but <i>I</i> am a lady of the Court. Keep your tongue in check.",
    "source_sha256": "3cd624871fb25443ab986878985aa65319e56769be3b89fe81084edc780a96d5",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2115810"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Ophelia",
      "cues": "[disgust] {Brit_Embarressed}",
      "line": 175,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15125-18132d306c33",
    "source": "Oh, I know <i>precisely</i> who you are...",
    "source_sha256": "18132d306c33492852f9120be38e8542f5dcc56ffa27aa30e21dba7547abb1ec",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116019"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_LaertesisLate",
      "speaker": "Lady Brit",
      "cues": "[disgust] {My_Lady_Not}",
      "line": 176,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15126-4de4f70fd8b3",
    "source": "Hamlet is staying in Denmark after all.",
    "source_sha256": "4de4f70fd8b330df544c1baf42791e7362fd1d8d8c262870f6ffb93253a236b9",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116105"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{Ah}",
      "line": 180,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15127-4528213b3094",
    "source": "And Laertes?",
    "source_sha256": "4528213b309408a99b4391c13b4683989049e8ee327522ea178e420d929d1d3b",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116185"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_HamletIsStaying",
      "speaker": "Lady Brit",
      "cues": "{Hmm}",
      "line": 183,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15128-429560084e69",
    "source": "Still leaving.",
    "source_sha256": "429560084e69a6bdfea0954e070822d319e8daeaf584ce223f6be1e17261d87e",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116211"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "[sad]",
      "line": 185,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15129-3e29aca81014",
    "source": "What's the bloody point if all the attractive ones are ditching Danish soil? Ugh.",
    "source_sha256": "3e29aca8101427dc91b1c63814678bd9bc5f0434981ecd5f35199a768bc63a42",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116241"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_HamletIsStaying",
      "speaker": "Lady Brit",
      "cues": "[disgust] {Disgust_Long}",
      "line": 187,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15130-181765e6bc82",
    "source": "At least Bernardo's still around.",
    "source_sha256": "181765e6bc821c3690730924526db01eef994187a7a7ad5426f2add8665dd5dd",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116406"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "brit_HamletIsStaying",
      "speaker": "Lady Brit",
      "cues": "[happy]",
      "line": 190,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15131-67811810512e",
    "source": "So Hamlet will be staying in Denmark after all?",
    "source_sha256": "67811810512ed1826dc57324092faa4a68fc866c1dc0d1dec682301d20f6f66d",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116474"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "claudius_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{Ah}",
      "line": 193,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15132-907ad56dbbaa",
    "source": "I did it for my wife's sanity, really.",
    "source_sha256": "907ad56dbbaa4c58953c503a57496fb15bd19c9372757ad3fbe8129edccd5967",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116570"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "claudius_HamletIsStaying",
      "speaker": "King Claudius",
      "cues": "{Yes}",
      "line": 195,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15133-cbb212f35c70",
    "source": "Bless her heart, you don't know how much of her energy that boy's sapped in recent months.",
    "source_sha256": "cbb212f35c701cd9ac7810f2d848c30bf1708d94690b4f6925ab2c4735059070",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116648"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "claudius_HamletIsStaying",
      "speaker": "King Claudius",
      "cues": "",
      "line": 196,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15134-5589bc61bed4",
    "source": "She needs some time to mother him here. If he goes to Wittenberg, what then? She'll be a worried tangle for the whole year.",
    "source_sha256": "5589bc61bed452e83a263c6ee654c871facf5e5d9d3c98428914f5f8507ab376",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2116831"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "claudius_HamletIsStaying",
      "speaker": "King Claudius",
      "cues": "",
      "line": 197,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15135-986450bf8dd3",
    "source": "My lady, are you happy to hear Hamlet will be staying in Denmark?",
    "source_sha256": "986450bf8dd31ecf0a7d00a08f1f2e88c7d991289a40f0f6cd9a13a9fecbc656",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117080"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "gertrude_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{My_Lady}",
      "line": 200,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15136-11e0ae7fce4a",
    "source": "Oh, it's wonderful!",
    "source_sha256": "11e0ae7fce4a405f1da99c9aa295514f5e248773b13e58a7c9484e546391788a",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117213"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "gertrude_HamletIsStaying",
      "speaker": "Queen Gertrude",
      "cues": "{Wonderful_Happy}",
      "line": 202,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15137-261ece1cd088",
    "source": "He needs all the love I can shower on him. I'll try my best to rouse his spirits.",
    "source_sha256": "261ece1cd08849c6e9dde93381d898d6db6154f4b8932ea98a2b280669193615",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117253"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "gertrude_HamletIsStaying",
      "speaker": "Queen Gertrude",
      "cues": "",
      "line": 203,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15138-c609c386f144",
    "source": "My husband is a kind man for stopping the trip. Though Hamlet can't understand now, I'm certain he will someday...",
    "source_sha256": "c609c386f144411657b7146492ec83916a43cc7c4587ad0c7ff73c4dffa96219",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117418"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "gertrude_HamletIsStaying",
      "speaker": "Queen Gertrude",
      "cues": "",
      "line": 204,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15139-9efe3b046d78",
    "source": "So. You're stuck here?",
    "source_sha256": "9efe3b046d784555a94fad7dd4a85365248dd0bde0c260163865742fe1cc3662",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117649"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{Sigh}",
      "line": 207,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15140-ff3a6546b806",
    "source": "While your brother's gallivanting around Paris, I shall be thinking of him fondly from my seat on the chamberpot.",
    "source_sha256": "ff3a6546b806321f2659df05a90c4272325b57732f2774f9f240f7d2b778b0e0",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117695"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Hamlet",
      "cues": "",
      "line": 211,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15141-28c08630ceeb",
    "source": "Elsinore Castle becomes more oppressive each day.",
    "source_sha256": "28c08630ceeb3216d6dbcde4388b084354e4e015cc6bd8da65d85ecc949e08db",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2117924"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Hamlet",
      "cues": "",
      "line": 212,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15142-ca6c6387e529",
    "source": "It must be so <i>terribly</i> oppressive, being Prince.",
    "source_sha256": "ca6c6387e529927adaa2136f9f709a781f97f9ea7ad4acef2c700366b15c182a",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118024"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{Sigh}",
      "line": 213,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15143-c3e87332ff46",
    "source": "If I didn't know you well enough to tell otherwise, I'd think you were being kind.",
    "source_sha256": "c3e87332ff46da37d481b2ccde8c95102c11af2e9f314cba148ad5a94f72afe0",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118136"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Hamlet",
      "cues": "",
      "line": 215,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15144-6db71200ebf2",
    "source": "There are still good things about Denmark, Hamlet.",
    "source_sha256": "6db71200ebf270575a68831942fa0d53902959737b70b9d37427488a65130aa7",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118303"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "",
      "line": 216,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15145-ea2766f8ea2d",
    "source": "My father <i>was</i> one. You were the other. Now both are gone.",
    "source_sha256": "ea2766f8ea2de32c378072a4815dc3ed4eca04715f1c1487e123994d4c3dc80a",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118405"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "hamlet_HamletIsStaying",
      "speaker": "Hamlet",
      "cues": "{Sigh}",
      "line": 218,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15146-17dafbd4720b",
    "source": "Looks like Hamlet is staying.",
    "source_sha256": "17dafbd4720bf4ff46cdf5218c017dc5a83e83a48843f79c52625d50a4cb6d11",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118536"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "horatio_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{Ah}",
      "line": 224,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15147-2d84f07a6b40",
    "source": "I'm glad, honestly. This castle wouldn't be the same without him.",
    "source_sha256": "2d84f07a6b40900072dfe2a4410d20968c6556f042ce85d1a185df0e14846a47",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118596"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "horatio_HamletIsStaying",
      "speaker": "Horatio",
      "cues": "{Sigh_Relief}",
      "line": 225,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15148-f01a4176a27d",
    "source": "Though... now I need to get him to cheer up, somehow.",
    "source_sha256": "f01a4176a27d38c5ed4c7b137cc36bb01d1b462cc0e358dd8f500d310417e993",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118729"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "horatio_HamletIsStaying",
      "speaker": "Horatio",
      "cues": "",
      "line": 227,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15149-4cadf4fe0d10",
    "source": "Hamlet is staying in Denmark.",
    "source_sha256": "4cadf4fe0d10ce1c249cb962c3397be9622854878e6742e98ca71776031411f6",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118837"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "irma_HamletIsStaying",
      "speaker": "Ophelia",
      "cues": "{Ah}",
      "line": 230,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15150-e4eaa271a56f",
    "source": "Humph! And the cloud over the castle grows.",
    "source_sha256": "e4eaa271a56f64ea11213c7fd7e191cebb130d7801532ed032457307256f3286",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118897"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "irma_HamletIsStaying",
      "speaker": "Irma",
      "cues": "{Hmph}",
      "line": 231,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15151-38d4e3419574",
    "source": "That boy brings his soot wherever he walks. I wish he were gone.",
    "source_sha256": "38d4e34195743af32b56096df6c7b953f99006b4b2f9b0a0c40587582f778f69",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2118985"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "irma_HamletIsStaying",
      "speaker": "Irma",
      "cues": "",
      "line": 232,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  },
  {
    "id": "p15152-f64f7ab331a8",
    "source": "He's done nothing but cause trouble since he was at the wet-nurse's teat!",
    "source_sha256": "f64f7ab331a8fd65c797bf971c425b2d213dec85882fb5149c4222dd816ab2bf",
    "origins": [
      "resources.assets:scenes_present:bf4227338782",
      "Assembly-CSharp.dll:#US:2119116"
    ],
    "categories": [
      "dialogue"
    ],
    "context": {
      "scene": "irma_HamletIsStaying",
      "speaker": "Irma",
      "cues": "",
      "line": 233,
      "asset_sha256": "bf42273387829f6f20d26bdd3cb163b8c118f6aed86f764feae39af87ad720c9"
    },
    "batch": "b0103"
  }
]
