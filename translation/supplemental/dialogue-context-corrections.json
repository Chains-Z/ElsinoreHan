  {
    "id": "dialogue-context-446b0d6707f4a1bc",
    "original_id": "p00287-446b0d6707f4",
    "source": "She was renowned for her great intellect and keenly inquisitive nature—not to mention her morbid sense of humor.",
    "source_sha256": "446b0d6707f4a1bc98d34b28b625c8e51d703fb8ab029be4c8d25c00438a2067",
    "previous_target": "她以过人的才智和强烈的求知欲闻名，更别提她那阴森的幽默感了。",
    "target": "她以过人的才智和强烈的求知欲闻名，更别提她那病态的幽默感了。",
    "origins": [
      {
        "frozen_manifest": "translation/sol-full-2026-10-09/manifest.json",
