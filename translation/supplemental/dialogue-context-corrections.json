  {
    "id": "dialogue-context-d1e4494f09eb40f9",
    "original_id": "p02687-d1e4494f09eb",
    "source": "No. You've been right to stay away from me.",
    "source_sha256": "d1e4494f09eb40f91fd1cbcfe04de57f7d3276edad9343ba9b3040ddefab731d",
