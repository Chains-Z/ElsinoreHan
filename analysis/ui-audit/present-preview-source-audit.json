          "line": 8493,
          "information_ids": [
            "FailedRomance"
          ]
        }
      ]
    },
    {
      "raw_source": "Hamlet - your uncle is not your enemy. Peter Quince is.",
      "raw_source_sha256": "0a0470b793efebbc9213107c70c9162c06baf60efc506336522a497cef944d3e",
      "runtime_source": "Hamlet—your uncle is not your enemy. Peter Quince is.",
      "runtime_source_sha256": "36f38e049a0dc43b39fe2d616ab3accccce247b1f72ad0a1b4df68bd40cf23a5",
      "raw_rule_matches": true,
      "runtime_rule_matches": false,
      "runtime_translation_id": "a00181-36f38e049a0d",
      "origins": [
        {
          "scene_id": "hamlet_quincetrouble",
          "source_sha256": "0a0470b793efebbc9213107c70c9162c06baf60efc506336522a497cef944d3e",
