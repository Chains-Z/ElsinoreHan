  "changed_sources": [
    {
      "raw_source": "Don't take this the wrong way, but -- what if Hamlet and I began seeing each other again?",
      "raw_source_sha256": "8f4d8888715532fa44937517fa00fce3a1e9e1cc9a612a8055b2dce26c5eb325",
      "runtime_source": "Don't take this the wrong way, but—what if Hamlet and I began seeing each other again?",
      "runtime_source_sha256": "3e697f43e286f4ddb2f3c3b6494432272f42b80db414fc092998ef42b20131e6",
      "raw_rule_matches": true,
      "runtime_rule_matches": false,
      "runtime_translation_id": "a00229-3e697f43e286",
      "origins": [
        {
          "scene_id": "laertes_failedromance",
