          "line": 17115,
          "actor": "rosencrantz"
        }
      ]
    },
    {
      "id": "curtain-call-83f6d2780d008feb",
      "original_id": "p06353-83f6d2780d00",
      "source": "When we last left Ophelia, she was ready to use the Book of Fates to become Queen of Denmark.",
      "source_sha256": "83f6d2780d008feb0f7fcd2b71a9a96c3875fecfd61e5d601c9e42ccf0724ffe",
      "previous_target": "上次我们离开奥菲莉娅时，她正准备利用命运之书成为丹麦王后。",
      "target": "上回说到奥菲莉娅时，她正准备利用命运之书成为丹麦王后。",
      "reason": "这是剧情回顾惯用语，不是众人上次在空间上离开女主。",
      "origins": [
        {
          "asset": "scenes",
          "asset_sha256": "6f4f49b19b3822498a7941716ea1353b8e9073dc4873406fa0fc351170acea0a",
