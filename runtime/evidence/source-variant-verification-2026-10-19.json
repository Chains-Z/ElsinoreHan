    {
      "id": "source-variant-57a37b78cad64e80",
      "original_id": "a00224-57a37b78cad6",
      "source": "Guh—Get away from me! From all of us!",
      "source_sha256": "57a37b78cad64e8054a4a5a72dc10dfe62ede121b2a3cef4f8e4bf6ce266d622",
      "previous_target": "滚——离我远点！离我们所有人远点！",
      "target": "呃——离我远点！离我们所有人远点！",
      "reason": "Guh为惊惧时的短促声音，不是额外说出滚这个命令。",
