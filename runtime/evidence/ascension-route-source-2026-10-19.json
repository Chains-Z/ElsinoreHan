      "section": "WITCH_InitialKickoff",
      "source_line": 21463,
      "text": "{WITCH_InitialKickoff}\nquince: [happy] \"If the clock strikes midnight on Friday evening and you've <b>used this power</b> on everyone, we'll speak further.\"\nassert ownedInformation(NotNeeded)"
    },
