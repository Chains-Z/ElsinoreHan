      "section": "bernardo_notneeded",
      "source_line": 7144,
      "text": "{bernardo_notneeded}\n[Play(bernardo,am_stand)]\n[Play(bernardo,am_neutral)]\n[PlaySound2D(Quince_Pause_World)]\nlabel facing\n[noblock LookAtWithBody(bernardo,ophelia)]\nophelia: \"<i>Exit BERNARDO.</i>\"\n[PlayMusic(M_Nothing)]\nblockedby facing\n[PlaySound2D(VO_Bernardo_Choking)]\n[Play(bernardo,am_choke_supernatural)]\n[Play(bernardo,am_death_supernatural)]\n[ClearPreSceneState(bernardo)]\nNotNeededHack_ForceKillCharactersEvent(bernardo)\nassert dead(bernardo)\nassert demontripped\ncall \"notneeded_react\"\n"
    },
    {
      "asset": "scenes_present",
      "asset_sha256": "2b1c89384554b940e922d55352639e837524ba2b20d4d642ff3b85bca33bdbf2",
      "section": "notneeded_react",
      "source_line": 7307,
      "text": "{notneeded_react}\nincrement erasedCount\nif not dead(othello) && IsCharacterHere(othello):\n    assert believes(othello,demon)\nif not dead(guildenstern) && IsCharacterHere(guildenstern):\n    assert believes(guildenstern,demon)\nif not dead(rosencrantz) && IsCharacterHere(rosencrantz):\n    assert believes(rosencrantz,demon)\nif not dead(horatio) && IsCharacterHere(horatio):\n    assert believes(horatio,demon)\nif not dead(irma) && IsCharacterHere(irma):\n    assert believes(irma,demon)\nif not dead(brit) && IsCharacterHere(brit):\n    assert believes(brit,demon)\nif not dead(marcellus) && IsCharacterHere(marcellus):\n    assert believes(marcellus,demon)\nif not dead(bernardo) && IsCharacterHere(bernardo):\n    assert believes(bernardo,demon)\nif not dead(laertes) && IsCharacterHere(laertes):\n    assert believes(laertes,demon)\nif not dead(gertrude) && IsCharacterHere(gertrude):\n    assert believes(gertrude,demon)\nif not dead(claudius) && IsCharacterHere(claudius):\n    assert believes(claudius,demon)\nif not dead(hamlet) && IsCharacterHere(hamlet):\n    assert believes(hamlet,demon)\nif not dead(polonius) && IsCharacterHere(polonius):\n    assert believes(polonius,demon)\nincrement erasedCountPersistent"
    },
    {
      "asset": "scenes_present",
      "asset_sha256": "2b1c89384554b940e922d55352639e837524ba2b20d4d642ff3b85bca33bdbf2",
      "section": "quince_notneeded",
      "source_line": 7288,
      "text": "{quince_notneeded}\n[PlaySound2D(Quince_Pause_World)]\nophelia: \"<i>Exit QUINCE.</i>\"\n[Delay(3.0)]\n[PlaySound2D(Quince_Resume_World)]\nif (erasedCountPersistent = 0): //TEMP: You theoretically don't know what this does yet\n    [noblock Play(quince,am_shrug)]\n    quince: [happy] {Hmm} \"Hmmm. Nothing.\"\n    quince: \"Clearly you need more practice. Run along and try that on someone else, why don't you?\"\nelse:\n    [noblock Play(quince,am_big_laugh)]\n    quince: [happy] {Chuckle} \"Oho. Not a bad plan.\"\n    [noblock Play(quince,am_shake_head)]\n    quince: [happy] \"Alas, I am no pawn, and cannot be removed from play. <b>Invalid move!</b>\"\n    [noblock Play(quince,am_shrug)]\n    quince: [smile] \"But I can hardly fault you. That's the first thing <i>I</i> would have tried, myself.\"\nendif\n\n"
    }
